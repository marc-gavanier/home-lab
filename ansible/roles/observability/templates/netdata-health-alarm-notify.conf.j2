# {{ ansible_managed }}
# =============================================================================
# Netdata notification OVERRIDE — ADR-030, phase 1
# =============================================================================
# `alarm-notify.sh` sources the STOCK file first and this one second
# (plugins.d/alarm-notify.sh:519), so this is a thin override layer: every
# setting not named here keeps its stock value. Do not copy the 2 000-line
# stock file in.
#
# --- Why Netdata does NOT talk to Discord ------------------------------------
# It would work, and it was the first design. Uptime Kuma is the notification
# broker instead, so that the channel is configured in exactly ONE place: the
# day Discord is replaced, Kuma changes and nothing else does. Netdata pushes
# its curated alarms INTO Kuma, and Kuma decides where they go — the same path
# the 31 existing monitors already travel and that is already proven to reach a
# human.
#
# It also makes each migration step verifiable: a curated alarm that fires turns
# a monitor red on the dashboard, with history, instead of leaving a line in a
# chat log. ADR-030 only allows a bash check to be deleted once its replacement
# has been OBSERVED firing, so that matters more than it looks.
#
# --- What this file does not route -------------------------------------------
# `docs/07-observability/README.md` decided that Netdata's 57 stock alarms reach
# nobody, and that decision stands: they are tuned for a generic server — the
# disk-backlog one alone would fire on every nightly backup. They address the
# `sysadmin`, `dba` and `silent` roles.
#
# Every DEFAULT_RECIPIENT_* is left empty, which the stock file documents as
# "do not send a notification for unconfigured roles". So the stock alarms stay
# mute BY CONSTRUCTION, not because a field was left blank by accident — which
# is what the first version of ADR-030 mistook this situation for.
#
# Only roles named below are routed, and only curated alarms in health.d/
# address them. One alarm, one condition, one monitor, one action.
# =============================================================================

# Netdata sends nothing directly, to any channel.
DEFAULT_RECIPIENT_DISCORD=""
DEFAULT_RECIPIENT_CUSTOM=""

# --- The Kuma push path ------------------------------------------------------
# One role per condition, each carrying the push URL of its own Kuma monitor.
# A role with no entry here reaches nobody, which is what keeps the stock set
# mute.
{% for alarm in netdata_curated_alarms if alarm.push_url %}
role_recipients_custom[{{ alarm.role }}]="{{ alarm.push_url }}"
{% endfor %}

# `custom_sender` replaces the stock stub. It receives the recipient list as $1
# and the alarm context as environment (${status}, ${alarm}, ${severity},
# ${value_string}, ${info}, ${raised_for}).
#
# Kuma's push API is binary — up or down — so WARNING and CRITICAL both map to
# `down` and the severity travels in the message instead. CLEAR maps to `up`,
# which is what closes the incident on the dashboard.
#
# Failures are logged, never swallowed: a notification that cannot be delivered
# and says nothing is the silent-disablement shape catalogued in #220. `info`
# and `error` are alarm-notify.sh's own helpers and land in the journal.
custom_sender() {
    local to_list="${1}" url push_status message

    case "${status}" in
        CLEAR) push_status="up" ;;
        *)     push_status="down" ;;
    esac

    message="${severity}: ${alarm}"
    [ -n "${info}" ] && message="${message} — ${info}"
    [ -n "${raised_for}" ] && message="${message} ${raised_for}"

    for url in ${to_list}; do
        if curl --silent --show-error --max-time 10 --retry 2 --get "${url}" \
            --data-urlencode "status=${push_status}" \
            --data-urlencode "msg=${message}" >/dev/null; then
            info "sent netdata alarm '${name}' to its Kuma monitor as ${push_status}"
        else
            error "FAILED to push netdata alarm '${name}' to its Kuma monitor"
        fi
    done
}
