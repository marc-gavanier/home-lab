# {{ ansible_managed }}

 template: homelab_cpu_temperature
       on: system.hw.sensor.temperature.input
    class: Utilization
     type: System
component: CPU
     calc: $input
    units: Celsius
    every: 1m
     warn: $this >= (($status >= $WARNING) ? ({{ netdata_cpu_temp_threshold_c | int - 5 }}) : ({{ netdata_cpu_temp_threshold_c | int }}))
    delay: up 2m down 15m multiplier 1.5 max 1h
  summary: Homelab CPU temperature at or above {{ netdata_cpu_temp_threshold_c | int }}C
     info: CPU temperature reached the level where the firmware throttles
       to: silent
