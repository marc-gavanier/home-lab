#!/usr/bin/env bash
# {{ ansible_managed }}

set -uo pipefail

KUMA_PUSH_URL='{{ homelab_health_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"

PENDING_PUSH_URL='{{ homelab_pending_kuma_push_url | default("") }}'
PENDING_PUSH_URL="${PENDING_PUSH_URL%%\?*}"

push_to() {
    [ -n "$1" ] || return 0
    local rc=0
    printf 'url = "%s"\n' "$1" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$2" --data-urlencode "msg=$3" >/dev/null || rc=$?
    case "$rc" in
        0) ;;
        28) echo "kuma-push-unconfirmed: no reply within 10s, the beat may have landed — $3" >&2 ;;
        *)  echo "kuma-push-failed: this report reached nobody — $3" >&2 ;;
    esac
}

notify() { push_to "$KUMA_PUSH_URL" "$1" "$2"; }

problems=()
pending=()
report=()

if ! . /usr/local/lib/homelab-gate.sh 2>/dev/null; then
    problems+=("homelab-gate.sh missing — every grace period disabled")
    gate() { shift 2; [ "$#" -gt 0 ] && printf '%s\n' "$@"; }
fi

uv_seen=0
for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "rpi_volt" ] || continue
    uv_seen=1
    [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = "1" ] && problems+=("undervoltage")
done
[ "$uv_seen" = 0 ] && report+=("no rpi_volt sensor")

[ -f /var/run/reboot-required ] && pending+=("reboot pending — schedule homelab reboot+unlock")

JOURNAL_PRESSURE_PCT=80

journal_cap_mb=$(sed -n 's/^SystemMaxUse=\([0-9]\{1,\}\)M$/\1/p' \
                 /etc/systemd/journald.conf.d/99-homelab.conf 2>/dev/null | head -1)
journal_pct=""
if [ -n "$journal_cap_mb" ] && [ "$journal_cap_mb" -gt 0 ] 2>/dev/null; then
    journal_pct=$(journalctl --disk-usage 2>/dev/null | awk -v cap="$journal_cap_mb" '
        match($0, /take up [0-9.]+[KMGT]/) {
            v = substr($0, RSTART + 8, RLENGTH - 8)
            unit = substr(v, length(v))
            n = substr(v, 1, length(v) - 1) + 0
            if (unit == "K") n /= 1024
            else if (unit == "G") n *= 1024
            else if (unit == "T") n *= 1048576
            printf "%d", (n / cap) * 100
        }')
fi

boot_journal=$(journalctl -b -o short-unix 2>/dev/null | head -1 | cut -d. -f1)
boot_real=$(date -d "$(uptime -s)" +%s 2>/dev/null)
case "${boot_journal:-x}${boot_real:-x}" in
    *[!0-9]*) ;;
    *)
        skew=$(( boot_real - boot_journal ))
        if [ "$skew" -gt 600 ]; then
            if [ "$skew" -ge 86400 ]; then
                how="$(( skew / 86400 ))d"
            else
                how="${skew}s"
            fi
            if [ -z "$journal_pct" ]; then
                pending+=("this boot's journal starts $how before the machine did, and the journal's headroom could not be read to size the risk (#292)")
            elif [ "$journal_pct" -ge "$JOURNAL_PRESSURE_PCT" ]; then
                pending+=("this boot's journal starts $how before the machine did and the journal is at ${journal_pct}% of its ${journal_cap_mb}M cap — the pre-NTP segment sorts oldest and the vacuum takes it first (#292)")
            else
                report+=("boot journal skew $how, journal ${journal_pct}%")
            fi
        fi
        ;;
esac

boot_first=$(journalctl -b -k -o cat 2>/dev/null | head -1)
case "$boot_first" in
    *"Booting Linux on physical CPU"*) ;;
    *) pending+=("the start of boot is already gone from this boot's record, which begins at '${boot_first:-nothing}' (#292)") ;;
esac

APT_CHECK=/usr/lib/update-notifier/apt-check
if [ -x "$APT_CHECK" ]; then
    sec=$("$APT_CHECK" 2>&1 | cut -d';' -f2); sec=${sec//[^0-9]/}; sec=${sec:-0}
    if [ "$sec" -gt 0 ]; then
        report+=("$sec security updates pending")
        [ -n "$(gate security-updates 172800 nonzero)" ] &&
            pending+=("$sec security updates unapplied >48h")
    else
        gate security-updates 172800
    fi
fi

DISK_THRESHOLD=85
for fs in / /mnt/data; do
    if ! mountpoint -q "$fs"; then
        report+=("$fs not mounted")
        continue
    fi
    usage=$(df --output=pcent "$fs" | tail -1 | tr -dc '0-9')
    [ -n "$usage" ] || continue
    report+=("$fs ${usage}%")
    [ "$usage" -ge "$DISK_THRESHOLD" ] && problems+=("$fs ${usage}% full")
done

DNS_PROBE_DOMAIN='{{ domain }}'
if command -v dig >/dev/null 2>&1 && [ -n "$DNS_PROBE_DOMAIN" ]; then
    rand=$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' \n')
    dns_rc=$(dig +time=3 +tries=1 "${rand}.${DNS_PROBE_DOMAIN}" @127.0.0.1 2>/dev/null \
             | sed -n 's/.*status: \([A-Z]*\),.*/\1/p')
    case "${dns_rc:-}" in
        NOERROR|NXDOMAIN)
            report+=("dns ok")
            gate dns-upstream 240
            ;;
        *)
            report+=("dns ${dns_rc:-no-response}")
            [ -n "$(gate dns-upstream 240 unreachable)" ] &&
                problems+=("dns upstream unreachable, sustained (${dns_rc:-no response})")
            ;;
    esac
fi

MIRROR_DB='{{ services_data_dir }}/forgejo/data/data/forgejo.db'
MIRROR_GRACE=3600
MIRROR_STAMP=/var/lib/homelab-health/mirror.stamp
if [ -f "$MIRROR_DB" ] && command -v sqlite3 >/dev/null 2>&1; then
    mirror_late=$(sqlite3 -cmd '.timeout 5000' "file:$MIRROR_DB?mode=ro" \
        "select ifnull(cast(strftime('%s','now') - min(next_update_unix) as int), 'none') from mirror;" \
        2>/dev/null)
    case "${mirror_late:-}" in
        none) ;;
        ''|*[!0-9-]*)
            report+=("mirror unreadable")
            mkdir -p "$(dirname "$MIRROR_STAMP")"
            [ -f "$MIRROR_STAMP" ] && \
                problems+=("forgejo mirror state unreadable twice running — the staleness check is not running")
            date +%s > "$MIRROR_STAMP"
            ;;
        *)
            rm -f "$MIRROR_STAMP"
            if [ "$mirror_late" -gt "$MIRROR_GRACE" ]; then
                report+=("mirror $((mirror_late / 3600))h overdue")
                problems+=("forgejo mirror has not completed a sync for $((mirror_late / 3600))h — it is still serving the stale copy")
            else
                report+=("mirror ok")
            fi
            ;;
    esac
fi

ACME_JSON=/mnt/data/services/traefik/acme/acme.json
CERT_STAMP=/var/lib/homelab-health/certs
CERT_MIN_DAYS=21

if mountpoint -q /mnt/data && [ -f "$ACME_JSON" ]; then
    mkdir -p "$(dirname "$CERT_STAMP")"
    acme_mtime=$(stat -c %Y "$ACME_JSON" 2>/dev/null || echo "")
    cached_mtime=""; cached_epoch=""; cached_name=""; cached_count=""; cert_high=""
    # shellcheck disable=SC2034
    read -r cached_mtime cached_epoch cached_name cached_count cert_high < "$CERT_STAMP" 2>/dev/null || true

    if [ -n "$acme_mtime" ] && [ "$acme_mtime" != "$cached_mtime" ]; then
        cert_facts=$(python3 - "$ACME_JSON" <<'PYEOF' 2>/dev/null || true
import base64, json, subprocess, sys, datetime

soonest = None
count = 0
with open(sys.argv[1]) as fh:
    store = json.load(fh)
for resolver in store.values():
    for cert in resolver.get("Certificates") or []:
        chain = base64.b64decode(cert["certificate"])
        out = subprocess.run(
            ["openssl", "x509", "-noout", "-enddate"],
            input=chain, capture_output=True,
        )
        if out.returncode != 0:
            continue
        raw = out.stdout.decode().strip().split("=", 1)[1]
        when = datetime.datetime.strptime(raw, "%b %d %H:%M:%S %Y %Z").replace(
            tzinfo=datetime.timezone.utc)
        count += 1
        name = cert["domain"]["main"]
        if soonest is None or when < soonest[0]:
            soonest = (when, name)

if soonest and count:
    print(int(soonest[0].timestamp()), soonest[1], count)
PYEOF
        )
        if [ -n "$cert_facts" ]; then
            cached_epoch=$(cut -d' ' -f1 <<< "$cert_facts")
            cached_name=$(cut -d' ' -f2 <<< "$cert_facts")
            cached_count=$(cut -d' ' -f3 <<< "$cert_facts")
            if [ -z "$cert_high" ] || [ "$cached_count" -gt "$cert_high" ]; then
                cert_high=$cached_count
            fi
            printf '%s %s %s\n' "$acme_mtime" "$cert_facts" "$cert_high" > "$CERT_STAMP"
        else
            cached_epoch=""
        fi
    fi

    if [ -z "$cert_high" ] && [ -n "$cached_count" ]; then
        cert_high=$cached_count
        printf '%s %s %s %s %s\n' "$cached_mtime" "$cached_epoch" "$cached_name" \
            "$cached_count" "$cert_high" > "$CERT_STAMP"
    fi

    if [ -n "$cached_epoch" ]; then
        cert_days=$(( (cached_epoch - $(date +%s)) / 86400 ))
        report+=("certs ${cert_days}d/${cached_count}")
        if [ "$cert_days" -lt "$CERT_MIN_DAYS" ]; then
            pending+=("certificate $cached_name expires in ${cert_days}d — Traefik renews at 30d, so ACME has been failing for over a week")
        fi
        if [ -n "$cert_high" ] && [ -n "$cached_count" ] && [ "$cached_count" -lt "$cert_high" ]; then
            problems+=("$(( cert_high - cached_count )) certificate(s) gone from $ACME_JSON — $cached_count now, $cert_high before; a resolver has stopped issuing and the expiry alarm goes QUIETER when this happens")
        fi
    else
        problems+=("certificate expiry unreadable in $ACME_JSON")
    fi
elif mountpoint -q /mnt/data; then
    problems+=("$ACME_JSON absent while /mnt/data is mounted — no certificate expiry is being watched")
fi

UNITS_SPEC=/etc/goss/units.yaml
if command -v systemctl >/dev/null 2>&1 && mountpoint -q /mnt/data; then

    if [ ! -f "$UNITS_SPEC" ]; then
        problems+=("goss spec $UNITS_SPEC missing — unit state was not checked")
    elif ! command -v goss >/dev/null 2>&1; then
        problems+=("goss binary missing — unit state was not checked")
    else
        units_tap=$(goss -g "$UNITS_SPEC" validate --format tap 2>&1) || true
        units_total=$(printf '%s\n' "$units_tap" | sed -n 's/^1\.\.\([0-9]*\)$/\1/p')
        units_seen=$(printf '%s\n' "$units_tap" | grep -cE '^(not )?ok [0-9]+ ') || true
        if [ -z "$units_total" ] || [ "$units_total" -eq 0 ]; then
            problems+=("goss produced no unit assertions — spec unreadable or empty")
        elif [ "$units_seen" -ne "$units_total" ]; then
            problems+=("goss declared $units_total unit assertions and produced $units_seen — the run was cut short")
        else
            units_bad=$(printf '%s\n' "$units_tap" |
                        sed -n 's/^not ok [0-9]* - [A-Za-z]*: \([^:]*\):.*/\1/p' | sort -u)
            # shellcheck disable=SC2086
            units_bad=$(gate systemd-units 240 $units_bad)
            [ -n "$units_bad" ] &&
                problems+=("units: $(printf '%s ' $units_bad | sed 's/ $//')")
        fi
    fi

    looping=$(systemctl list-units --state=activating --no-legend --plain 2>/dev/null \
              | awk '$4 == "auto-restart" {print $1}')
    # shellcheck disable=SC2086
    looping=$(gate systemd-activating 240 $looping)
    [ -n "$looping" ] && problems+=("restart loop: $(printf '%s ' $looping | sed 's/ $//')")

    badrun=""
    notrun=""
    timers_seen=0
    for t in $(systemctl list-timers 'homelab-*' --all --no-legend --no-pager 2>/dev/null | awk '{print $NF}'); do
        case "$t" in *.service) ;; *) continue ;; esac
        timers_seen=$((timers_seen + 1))
        r=$(systemctl show "$t" -p Result --value 2>/dev/null)
        fired=$(systemctl show "${t%.service}.timer" -p LastTriggerUSecMonotonic --value 2>/dev/null)
        began=$(systemctl show "$t" -p ExecMainStartTimestampMonotonic --value 2>/dev/null)
        if [ -n "$fired" ] && [ "$fired" != "0" ] && [ "${began:-0}" = "0" ]; then
            notrun="$notrun $t"
        fi
        case "$r" in ""|success|exec-condition) continue ;; esac
        badrun="$badrun $t"
    done
    # shellcheck disable=SC2086
    badrun=$(gate systemd-timer-result 240 $badrun)
    [ -n "$badrun" ] && problems+=("last run failed: $(printf '%s ' $badrun | sed 's/ $//')")
    # shellcheck disable=SC2086
    notrun=$(gate systemd-timer-never-started 240 $notrun)
    [ -n "$notrun" ] && problems+=("triggered but never started: $(printf '%s ' $notrun | sed 's/ $//')")
    [ "$timers_seen" -eq 0 ] && problems+=("no homelab-* timer was enumerated — the unit check asserted nothing")
fi

heal_script=/usr/local/sbin/homelab-stack-heal.sh
heal_installed=$(stat -c %Y "$heal_script" 2>/dev/null || echo 0)
if [ $(( $(date +%s) - heal_installed )) -gt 900 ] &&
   systemctl -q is-active homelab-stack-heal.timer 2>/dev/null &&
   [ -n "$(systemctl show homelab-stack-heal.service -p ExecMainExitTimestamp --value 2>/dev/null)" ]; then
    heal_last=$(journalctl -t homelab-heal --since -15min -o cat 2>/dev/null | grep '^checked ' | tail -1)
    if [ -z "$heal_last" ]; then
        problems+=("crash-heal has not reported in 15 min — it may be firing blind")
    else
        heal_n=$(printf '%s' "$heal_last" | sed -n 's/^checked \([0-9]\{1,\}\) .*/\1/p')
        heal_m=$(printf '%s' "$heal_last" | sed -n 's/^checked [0-9]\{1,\} of \([0-9]\{1,\}\) declared.*/\1/p')
        if [ -z "$heal_m" ]; then
            [ "${heal_n:-0}" -ge 1 ] || problems+=("crash-heal examined 0 containers — recovery is off")
        elif [ "${heal_n:-0}" -lt "$heal_m" ]; then
            problems+=("crash-heal saw ${heal_n:-0} of $heal_m declared services — it is looking at a partial stack")
        elif [ "${heal_n:-0}" -gt "$heal_m" ]; then
            problems+=("crash-heal saw ${heal_n:-0} of $heal_m declared services — it collided with a recreate and may have restarted a transient")
        fi
    fi
fi

join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }
msg=$(join ', ' "${report[@]}")

{% raw %}
if [ -z "$PENDING_PUSH_URL" ] && [ ${#pending[@]} -gt 0 ]; then
    problems+=("${pending[@]}")
    pending=()
fi

if [ -n "$PENDING_PUSH_URL" ]; then
    if [ ${#pending[@]} -gt 0 ]; then
        push_to "$PENDING_PUSH_URL" down "$(join '; ' "${pending[@]}")"
    else
        push_to "$PENDING_PUSH_URL" up "nothing waiting on a human"
    fi
fi

if [ ${#problems[@]} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "$msg"
{% endraw %}
