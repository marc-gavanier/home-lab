#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Homelab Pi — host health report
# =============================================================================
# Pushes the host-level signals that need a human to a single Uptime Kuma push
# monitor: CPU temperature, undervoltage, pending reboot, stuck security
# updates, disk capacity and unhealthy containers. A sagging PSU/cable silently
# corrupts the SD and is the prime suspect behind an unexplained poweroff; a
# Pi 4 also throttles at ~80-85C. Reads kernel sensors directly (vcgencmd is
# not guaranteed on Ubuntu Server arm64). No-ops when no push URL is
# configured.

set -uo pipefail

KUMA_PUSH_URL='{{ homelab_health_kuma_push_url | default("") }}'
# Kuma shows the push URL WITH an example query (?status=up&msg=OK&ping=); if
# that gets pasted in, our own -G params arrive as a second status=/msg= and
# Kuma reads the array as DOWN. Strip anything from '?' on so our params win.
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"

# A SECOND monitor, for conditions that wait on a human rather than on the
# machine. Empty = the split is off and everything rides the monitor above,
# which is the behaviour this script had until #216.
PENDING_PUSH_URL='{{ homelab_pending_kuma_push_url | default("") }}'
PENDING_PUSH_URL="${PENDING_PUSH_URL%%\?*}"

push_to() {   # $1 url, $2 status, $3 message
    [ -n "$1" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    printf 'url = "%s"\n' "$1" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$2" --data-urlencode "msg=$3" >/dev/null 2>&1 || true
}

notify() { push_to "$KUMA_PUSH_URL" "$1" "$2"; }

problems=()
pending=()
report=()

# --- Undervoltage ---
# The firmware latches undervoltage events into the rpi_volt hwmon alarm.
uv_seen=0
for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "rpi_volt" ] || continue
    uv_seen=1
    [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = "1" ] && problems+=("undervoltage")
done
[ "$uv_seen" = 0 ] && report+=("no rpi_volt sensor")

# --- Pending reboot ---
# Auto-reboot is disabled by policy (a reboot would leave /mnt/data locked and
# services down until a manual homelab-unlock). So a kernel/library update sits
# waiting on the operator — push DOWN once so Kuma pings, then schedule the
# reboot+unlock deliberately. State-change only, so it notifies once, not every
# heartbeat; clears to UP after the reboot.
[ -f /var/run/reboot-required ] && pending+=("reboot pending — schedule homelab reboot+unlock")

# --- Pending security updates (age-gated) ---
# unattended-upgrades installs security fixes daily, so a bare nonzero count
# would flash red in the hours before u-u runs. Only alarm if it is STILL
# nonzero after 48h — a held/failed/stuck update, or a fix that installed but
# needs a restart needrestart didn't cover. apt-check prints "all;security" on
# stderr; stamp the first time it goes nonzero, clear the stamp at zero.
APT_CHECK=/usr/lib/update-notifier/apt-check
SEC_STAMP=/var/lib/homelab-health/security-pending.stamp
if [ -x "$APT_CHECK" ]; then
    sec=$("$APT_CHECK" 2>&1 | cut -d';' -f2); sec=${sec//[^0-9]/}; sec=${sec:-0}
    if [ "$sec" -gt 0 ]; then
        report+=("$sec security updates pending")
        mkdir -p "$(dirname "$SEC_STAMP")"
        [ -f "$SEC_STAMP" ] || date +%s > "$SEC_STAMP"
        age=$(( $(date +%s) - $(cat "$SEC_STAMP" 2>/dev/null || echo 0) ))
        [ "$age" -gt 172800 ] && pending+=("$sec security updates unapplied >48h")
    else
        rm -f "$SEC_STAMP"
    fi
fi

# --- Disk capacity ---
# A full disk is the one failure nothing else here would catch: restic, Immich
# and Jellyfin write to /mnt/data, while Docker images and logs fill the SD.
# Netdata graphs it but has no notification path, so it only ever surfaces
# after something has already broken. The offsite Pi runs the same check.
DISK_THRESHOLD=85
for fs in / /mnt/data; do
    # /mnt/data is a LUKS volume unlocked by hand after a reboot (staged
    # startup). Between boot and homelab-unlock it is legitimately absent —
    # report it, but do not alarm: the "reboot pending" signal already covers
    # that window, and alarming here would cry wolf on every reboot.
    if ! mountpoint -q "$fs"; then
        report+=("$fs not mounted")
        continue
    fi
    usage=$(df --output=pcent "$fs" | tail -1 | tr -dc '0-9')
    [ -n "$usage" ] || continue
    report+=("$fs ${usage}%")
    [ "$usage" -ge "$DISK_THRESHOLD" ] && problems+=("$fs ${usage}% full")
done

# --- Moved to curated Netdata alarms (ADR-030) ------------------------------
# Swap, available memory and CPU temperature all left this script, each only
# after the whole chain had been seen to fire AND recover on the real system:
# threshold pushed past the live value, monitor red and notified, threshold
# restored, monitor green and notified again. They are now health.d/*.conf,
# reported through the `Pi resources` monitor, and the reasoning behind each
# number moved with it rather than being restated here.
#
# Undervoltage below stays, and is expected to: the firmware latches a bit, and
# there is no way to force one without actually browning out the supply — so it
# cannot be put through the same proof, and it is the signal that explains an
# unexplained poweroff.
#
# The 57 STOCK Netdata alarms still reach nobody, which remains deliberate: they
# are tuned for a generic server and the disk-backlog one alone would fire on
# every nightly backup. What changed is that a signal WE curate no longer has to
# be written in bash to reach a human.
#
# One artefact is left behind on the host by this removal:
# /var/lib/homelab-health/lowmem.stamp, which nothing reads any more.

# --- DNS upstream ---
# Nothing else detects a dead DoH upstream, and the failure is silent in the
# worst way: Pi-hole keeps answering cached names, both containers read green,
# and the LAN loses resolution for everything else.
#
# The Kuma `Pi-hole DNS` monitor cannot see it. It asks for the A record of the
# domain every 60 s, and FTL answers that from cache essentially always — 10 084
# queries for that name over 7 days produced 2 upstream forwards, both of them
# container restarts flushing the cache. It proves FTL is alive, nothing more.
# Neither can the container healthchecks: dnsproxy has none at all, and
# Pi-hole's uses `+norecurse` against a local name, so it cannot reach the
# upstream by construction.
#
# A random label cannot be served from cache, so this walks the whole path:
# FTL -> 127.0.0.1#5053 -> DoH. Verified rather than assumed — a probe query
# landed in the FTL database as `status=2 forward=127.0.0.1#5053`, 656 ms, while
# a cached answer returns in ~0 ms with no forward at all.
#
# NXDOMAIN is a success here: the question is whether the upstream ANSWERED, not
# whether the name exists. SERVFAIL, REFUSED and silence are the failures — they
# are what a dead dnsproxy produces.
DNS_STAMP=/var/lib/homelab-health/dns.stamp
DNS_PROBE_DOMAIN='{{ domain }}'
if command -v dig >/dev/null 2>&1 && [ -n "$DNS_PROBE_DOMAIN" ]; then
    rand=$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' \n')
    # No `head -1` on this pipeline: `status: X,` matches exactly one line, and
    # closing a pipe early is how the earlier probes acquired SIGPIPE races.
    dns_rc=$(dig +time=3 +tries=1 "${rand}.${DNS_PROBE_DOMAIN}" @127.0.0.1 2>/dev/null \
             | sed -n 's/.*status: \([A-Z]*\),.*/\1/p')
    case "${dns_rc:-}" in
        NOERROR|NXDOMAIN)
            report+=("dns ok")
            rm -f "$DNS_STAMP"
            ;;
        *)
            report+=("dns ${dns_rc:-no-response}")
            mkdir -p "$(dirname "$DNS_STAMP")"
            # Second consecutive failure, i.e. sustained for >5 min. Same gate as
            # the memory alarm: one upstream hiccup is not an outage, and this
            # probe deliberately leaves the cache out of the path, so it has no
            # cushion of its own.
            [ -f "$DNS_STAMP" ] && \
                problems+=("dns upstream unreachable twice running (${dns_rc:-no response})")
            date +%s > "$DNS_STAMP"
            ;;
    esac
fi

# --- Forgejo pull mirror ---
# The mirror ran 22 h behind a healthy container on 2026-08-15 and nothing
# showed it: /api/healthz answered 200, the Kuma monitor stayed UP, no timer
# failed, and the stale copy was served perfectly throughout (#123, #132).
#
# `updated_unix` is NOT the signal, though it reads like one. It moves on every
# ATTEMPT: in the 03:00 dump taken during that outage it said 00:56 UTC — four
# minutes old, four hours into the failure. Forgejo records no
# last-successful-sync anywhere, so there is nothing else in that direction.
#
# `next_update_unix` is the signal, and the same dump proves it: 2 h 30 in the
# PAST and sinking while the mirror was broken, against a future value whenever
# it is healthy. Forgejo advances it only when a sync completes. A local read,
# no network call, and no false positive from ordinary lag — the scheduled time
# is exactly what the field encodes, so being behind upstream between two syncs
# is invisible to it, which is what we want.
MIRROR_DB='{{ services_data_dir }}/forgejo/data/data/forgejo.db'
MIRROR_GRACE=3600   # a sync in flight leaves it seconds overdue, never an hour
MIRROR_STAMP=/var/lib/homelab-health/mirror.stamp
if [ -f "$MIRROR_DB" ] && command -v sqlite3 >/dev/null 2>&1; then
    # ifnull(): an empty mirror table is "nothing configured", not "unreadable"
    # — the two must not collapse into one message.
    mirror_late=$(sqlite3 -cmd '.timeout 5000' "file:$MIRROR_DB?mode=ro" \
        "select ifnull(cast(strftime('%s','now') - min(next_update_unix) as int), 'none') from mirror;" \
        2>/dev/null)
    case "${mirror_late:-}" in
        none) ;;                                    # no mirror configured
        ''|*[!0-9-]*)
            # A check that cannot run must not read as a pass. Same two-strike
            # gate as the DNS probe above, for the same reason: a momentary lock
            # on a live database is not an incident, a persistent one is.
            report+=("mirror unreadable")
            mkdir -p "$(dirname "$MIRROR_STAMP")"
            [ -f "$MIRROR_STAMP" ] && \
                problems+=("forgejo mirror state unreadable twice running — the staleness check is not running")
            date +%s > "$MIRROR_STAMP"
            ;;
        *)
            rm -f "$MIRROR_STAMP"
            if [ "$mirror_late" -gt "$MIRROR_GRACE" ]; then
                report+=("mirror $((mirror_late / 3600))h overdue")
                problems+=("forgejo mirror has not completed a sync for $((mirror_late / 3600))h — it is still serving the stale copy")
            else
                report+=("mirror ok")
            fi
            ;;
    esac
fi

# --- TLS certificate expiry ---
# Watches the OUTCOME rather than the renewal, and that is the point (#157).
#
# Uptime Kuma checks expiry on 15 of the 18 certificates. Three are unwatched:
# dns (its monitor is type=dns and never opens TLS), proxy (type=port, a bare
# TCP connect) and services (Kuma cannot monitor itself). Both of the first two
# are green, named after the service whose certificate they cannot see.
#
# Traefik would NOT hide a failure — measured rather than assumed: the string
# "Unable to obtain ACME certificate for domains" is in the binary and is
# emitted at ERROR, which passes log.level=WARN, and ERROR lines from this
# container do reach the stream. But nothing reads it: 7 application lines in
# 70 350 retained, the rest being the access log. A red line nobody greps is not
# an alert, so the control belongs here, on the consequence — which also makes
# it indifferent to WHY a renewal stopped working.
#
# 21 days: Traefik renews at 30 days remaining, so the alarm means renewal has
# been failing for over a week. Short enough to act on calmly, long enough that
# one transient failure — Cloudflare unreachable for a night — is retried and
# never seen.
ACME_JSON=/mnt/data/services/traefik/acme/acme.json
CERT_STAMP=/var/lib/homelab-health/certs
CERT_MIN_DAYS=21

if mountpoint -q /mnt/data && [ -f "$ACME_JSON" ]; then
    # Re-parsed only when Traefik rewrites the file, i.e. on issuance or
    # renewal. This runs every five minutes; forking openssl per certificate
    # that often to re-derive a date that changes four times a year would be
    # absurd. The countdown itself is arithmetic on the cached date.
    mkdir -p "$(dirname "$CERT_STAMP")"
    acme_mtime=$(stat -c %Y "$ACME_JSON" 2>/dev/null || echo "")
    cached_mtime=""; cached_epoch=""; cached_name=""; cached_count=""
    # shellcheck disable=SC2034
    read -r cached_mtime cached_epoch cached_name cached_count < "$CERT_STAMP" 2>/dev/null || true

    if [ -n "$acme_mtime" ] && [ "$acme_mtime" != "$cached_mtime" ]; then
        cert_facts=$(python3 - "$ACME_JSON" <<'PYEOF' 2>/dev/null || true
import base64, json, subprocess, sys, datetime

soonest = None
count = 0
with open(sys.argv[1]) as fh:
    store = json.load(fh)
for resolver in store.values():
    for cert in resolver.get("Certificates") or []:
        chain = base64.b64decode(cert["certificate"])
        # The leaf is first in the chain; `openssl x509` reads exactly one.
        out = subprocess.run(
            ["openssl", "x509", "-noout", "-enddate"],
            input=chain, capture_output=True,
        )
        if out.returncode != 0:
            continue
        raw = out.stdout.decode().strip().split("=", 1)[1]
        when = datetime.datetime.strptime(raw, "%b %d %H:%M:%S %Y %Z").replace(
            tzinfo=datetime.timezone.utc)
        count += 1
        name = cert["domain"]["main"]
        if soonest is None or when < soonest[0]:
            soonest = (when, name)

# Nothing parsed is a failure, not a pass: print nothing and let the caller say so.
if soonest and count:
    print(int(soonest[0].timestamp()), soonest[1], count)
PYEOF
        )
        if [ -n "$cert_facts" ]; then
            printf '%s %s\n' "$acme_mtime" "$cert_facts" > "$CERT_STAMP"
            cached_epoch=$(cut -d' ' -f2 <<< "$acme_mtime $cert_facts")
            cached_name=$(cut -d' ' -f3 <<< "$acme_mtime $cert_facts")
            cached_count=$(cut -d' ' -f4 <<< "$acme_mtime $cert_facts")
        else
            cached_epoch=""
        fi
    fi

    if [ -n "$cached_epoch" ]; then
        cert_days=$(( (cached_epoch - $(date +%s)) / 86400 ))
        report+=("certs ${cert_days}d/${cached_count}")
        if [ "$cert_days" -lt "$CERT_MIN_DAYS" ]; then
            pending+=("certificate $cached_name expires in ${cert_days}d — Traefik renews at 30d, so ACME has been failing for over a week")
        fi
    else
        problems+=("certificate expiry unreadable in $ACME_JSON")
    fi
# The last branch in this file where "cannot run" read as "pass" (#177). The
# mountpoint guard is legitimate — while /mnt/data is locked the file genuinely
# is not there, and the disk report already says so. But once the volume IS
# mounted, an absent acme.json means Traefik has never obtained a certificate or
# the store has moved, and eighteen expiry dates are being watched by nobody.
elif mountpoint -q /mnt/data; then
    problems+=("$ACME_JSON absent while /mnt/data is mounted — no certificate expiry is being watched")
fi

# --- Unhealthy containers ---
# The heal timer only resurrects containers that EXITED; one that stays up but
# fails its healthcheck is invisible. User-facing services are covered
# indirectly by the Kuma HTTP monitors — the real gap is internal containers,
# notably nextcloud-notify-push, whose death silently kills mobile push while
# Nextcloud itself keeps answering 200.
# Age-gated: a container is briefly unhealthy on every restart (and "starting"
# is deliberately not matched), so only alarm once it has stayed that way
# across two runs, i.e. >10 min.
UNHEALTHY_STAMP=/var/lib/homelab-health/unhealthy.stamp
if command -v docker >/dev/null 2>&1; then
    unhealthy=$(docker ps --filter health=unhealthy \
        --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null | sort | tr '\n' ' ')
    unhealthy="${unhealthy% }"
    if [ -n "$unhealthy" ]; then
        mkdir -p "$(dirname "$UNHEALTHY_STAMP")"
        [ -f "$UNHEALTHY_STAMP" ] || date +%s > "$UNHEALTHY_STAMP"
        age=$(( $(date +%s) - $(cat "$UNHEALTHY_STAMP" 2>/dev/null || echo 0) ))
        if [ "$age" -gt 600 ]; then
            problems+=("unhealthy >10min: $unhealthy")
        else
            report+=("unhealthy: $unhealthy")
        fi
    else
        rm -f "$UNHEALTHY_STAMP"
    fi
fi

# --- Expected containers that are not running ---
# The check above cannot see them: `docker ps --filter health=unhealthy` only
# lists running containers, and the heal timer only resurrects ones that
# EXITED. A container that fails to come back is invisible to both. That is how
# a stopped socket-proxy would go unnoticed while Traefik keeps answering 200
# from its in-memory routes, blind to every container change (issue #34).
# The list is generated from docker/compose.yaml, so it cannot drift.
# Age-gated like the check above: the staged startup brings the waves up over
# several minutes, and /mnt/data is unlocked by hand, so only alarm past 10 min.
MISSING_STAMP=/var/lib/homelab-health/missing.stamp
if command -v docker >/dev/null 2>&1 && mountpoint -q /mnt/data; then
{% set compose = lookup('file', playbook_dir + '/../../docker/compose.yaml') | from_yaml %}
    expected="{% for name, svc in compose.services.items() %}{{ svc.container_name | default(name) }} {% endfor %}"
    running=$(docker ps --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null)
    missing=""
    for c in $expected; do
        echo "$running" | grep -qx "$c" || missing="$missing $c"
    done
    missing="${missing# }"
    if [ -n "$missing" ]; then
        mkdir -p "$(dirname "$MISSING_STAMP")"
        [ -f "$MISSING_STAMP" ] || date +%s > "$MISSING_STAMP"
        age=$(( $(date +%s) - $(cat "$MISSING_STAMP" 2>/dev/null || echo 0) ))
        if [ "$age" -gt 600 ]; then
            problems+=("not running >10min: $missing")
        else
            report+=("not running: $missing")
        fi
    else
        rm -f "$MISSING_STAMP"
    fi
fi

# --- systemd units ---
# Nothing watched these until now, and a service can be dead for hours without a
# signal: claude-remote-control looped 1 112 times over 5h47 on 2026-07-27 while
# work was going on continuously on this host, and fail2ban — including its sshd
# jail — was down for six minutes the same morning (issue #52).
#
# `systemctl --failed` alone would have caught NEITHER: a unit with
# Restart=on-failure and StartLimitIntervalSec=0 restarts forever and never
# reaches the failed state. It sits in activating/auto-restart, and --failed
# stays empty. That is why NRestarts is compared between runs — a unit that
# restarted since five minutes ago is flapping, whatever it says about itself.
#
# Gated on /mnt/data like the check above: before homelab-unlock the stack is
# legitimately down and claude-remote-control legitimately retries.
UNITS_STAMP=/var/lib/homelab-health/nrestarts
# Long-running units whose "active" state is the signal. `is-enabled` is not
# usable here: docker is deliberately disabled (the staged startup owns it) and
# ssh is socket-activated, yet both must be running.
WATCHED_UNITS="docker.service containerd.service fail2ban.service claude-remote-control.service wg-quick@wg0.service"
if command -v systemctl >/dev/null 2>&1 && mountpoint -q /mnt/data; then
    mkdir -p "$(dirname "$UNITS_STAMP")"

    failed=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
    [ -n "${failed% }" ] && problems+=("systemd failed: ${failed% }")

    # Any unit stuck in auto-restart is looping, whatever it says about itself:
    # that is the state claude-remote-control sat in for 5h47. Reported on the
    # second consecutive sighting so a single legitimate restart, which passes
    # through auto-restart for RestartSec, does not page.
    LOOP_STAMP=/var/lib/homelab-health/autorestart
    looping=$(systemctl list-units --state=activating --no-legend --plain 2>/dev/null \
              | awk '$4 == "auto-restart" {print $1}' | sort | tr '\n' ' ')
    if [ -n "${looping% }" ]; then
        seen=""
        for u in $looping; do
            grep -qx "$u" "$LOOP_STAMP" 2>/dev/null && seen="$seen $u"
        done
        [ -n "$seen" ] && problems+=("restart loop:$seen")
        printf '%s\n' $looping > "$LOOP_STAMP"
    else
        rm -f "$LOOP_STAMP"
    fi

    inactive=""; flapping=""
    : > "${UNITS_STAMP}.new"
    for u in $WATCHED_UNITS; do
        state=$(systemctl is-active "$u" 2>/dev/null)
        [ "$state" = "active" ] || inactive="$inactive $u($state)"
        n=$(systemctl show "$u" -p NRestarts --value 2>/dev/null)
        [ -n "$n" ] && echo "$u $n" >> "${UNITS_STAMP}.new"
        prev=$(awk -v u="$u" '$1 == u {print $2}' "$UNITS_STAMP" 2>/dev/null)
        if [ -n "$prev" ] && [ -n "$n" ] && [ "$n" -gt "$prev" ]; then
            flapping="$flapping $u($prev->$n)"
        fi
    done
    mv "${UNITS_STAMP}.new" "$UNITS_STAMP"

    # Age-gated like everything else here: a unit can legitimately be down for a
    # few seconds — fail2ban waits for /mnt/data and comes up within 30 s of the
    # unlock, so an immediate alarm would fire on a normal boot.
    INACTIVE_STAMP=/var/lib/homelab-health/inactive
    if [ -n "$inactive" ]; then
        seen=""
        for u in $inactive; do
            grep -qx "$u" "$INACTIVE_STAMP" 2>/dev/null && seen="$seen $u"
        done
        [ -n "$seen" ] && problems+=("not active:$seen")
        printf '%s\n' $inactive > "$INACTIVE_STAMP"
    else
        rm -f "$INACTIVE_STAMP"
    fi
    # Held across a second beat, and that is the whole point. Unlike the two
    # checks above — which use a two-strike gate and therefore naturally produce
    # two consecutive bad beats — a restart is detectable for exactly ONE run by
    # construction: the comparison is against the previous NRestarts snapshot,
    # which this very run has just overwritten. Measured over 60 days: one real
    # detection (claude-remote-control.service 7->8, 2026-07-28, recorded
    # status=2) and ZERO notifications, the only two DOWN beats in that window
    # being "No heartbeat in the time window" — the dead-man's switch, not the
    # content.
    #
    # The diagnosis written here first was wrong and is corrected rather than
    # deleted, because it is the kind that repeats: it said a single bad beat
    # became PENDING and that "PENDING does not notify in Kuma v2". PENDING DOES
    # escalate — with the wrong text. Kuma's push branch raises "No heartbeat in
    # the time window" whenever the previous beat is not UP, and with a retry it
    # is that raised beat, not this script's message, that notifies. So the
    # detection reached a human and named the wrong thing (#179).
    #
    # The monitor now runs at maxretries=0, where one bad beat is DOWN and
    # carries this text. Holding the latch across a second beat is kept anyway:
    # it costs nothing and gives the message a second chance to land.
    FLAP_LATCH=/var/lib/homelab-health/flapping
    if [ -n "$flapping" ]; then
        printf '%s\n' "$flapping" > "$FLAP_LATCH"
        problems+=("restarted since last check:$flapping")
    elif [ -s "$FLAP_LATCH" ]; then
        problems+=("restarted since last check:$(cat "$FLAP_LATCH") (still)")
        rm -f "$FLAP_LATCH"
    fi

    # Timer-driven oneshots rest at inactive/dead, so their state says nothing —
    # the signal is the result of the last run. Enumerated rather than listed, so
    # a new timer is covered without editing this script.
    badrun=""
    for t in $(systemctl list-timers 'homelab-*' --all --no-legend --no-pager 2>/dev/null | awk '{print $NF}'); do
        case "$t" in *.service) ;; *) continue ;; esac
        r=$(systemctl show "$t" -p Result --value 2>/dev/null)
        [ -z "$r" ] || [ "$r" = "success" ] || badrun="$badrun $t($r)"
    done
    [ -n "$badrun" ] && problems+=("last run failed:$badrun")
fi

# --- Verdict ---
# TWO signals, not one, and that split is the whole point of #216.
#
# A pending reboot waits on a human and stays true for days by construction.
# Folded in with the acute checks it occupied the signal permanently: the
# monitor sat DOWN for a whole day, and because Kuma notifies on a state CHANGE,
# every acute condition appearing behind it reached nobody. The checks were
# working; nothing they found could get out.
#
# So conditions that wait on a person go to their own monitor, where they can
# stay red for a week without deafening anything.
#
# If that second monitor is not configured, they fold BACK into the main signal
# rather than vanishing — an unconfigured URL must not silently drop a check.
join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }
msg=$(join ', ' "${report[@]}")

{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
{% raw %}
if [ -z "$PENDING_PUSH_URL" ] && [ ${#pending[@]} -gt 0 ]; then
    problems+=("${pending[@]}")
    pending=()
fi

if [ -n "$PENDING_PUSH_URL" ]; then
    if [ ${#pending[@]} -gt 0 ]; then
        push_to "$PENDING_PUSH_URL" down "$(join '; ' "${pending[@]}")"
    else
        push_to "$PENDING_PUSH_URL" up "nothing waiting on a human"
    fi
fi

if [ ${#problems[@]} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "$msg"
{% endraw %}
