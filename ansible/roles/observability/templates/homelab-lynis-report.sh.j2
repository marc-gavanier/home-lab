#!/usr/bin/env bash
# {{ ansible_managed }}

set -uo pipefail

KUMA_PUSH_URL='{{ lynis_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"
MIN_INDEX={{ lynis_min_index | default(65) }}
REPORT=/var/log/lynis-report.dat
STATE_DIR=/var/lib/homelab-lynis
BEST_FILE="$STATE_DIR/best-index"
BEST_VER_FILE="$STATE_DIR/best-index-lynis-version"
LAST_REPORT="$STATE_DIR/last-green-report.dat"

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    local rc=0
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null || rc=$?
    case "$rc" in
        0) ;;
        28) echo "kuma-push-unconfirmed: no reply within 10s, the beat may have landed — $2" >&2 ;;
        *)  echo "kuma-push-failed: this report reached nobody — $2" >&2 ;;
    esac
}

lynis_ver=$(lynis show version 2>/dev/null | tr -cd '0-9.'); lynis_ver=${lynis_ver:-unknown}

before=$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)

lynis audit system --quick --no-colors >/dev/null 2>&1 || true

if [ ! -r "$REPORT" ]; then
    notify down "lynis produced no report"
    exit 1
fi

after=$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)
if [ "$after" = "$before" ]; then
    notify down "lynis did not refresh its report — the audit did not run"
    exit 1
fi

index=$(awk -F= '/^hardening_index=/{print $2; exit}' "$REPORT")
index=${index//[^0-9]/}; index=${index:-0}

warn_ids=$(awk -F'|' '/^warning\[\]=/{sub(/^warning\[\]=/,"",$1); printf "%s ", $1}' "$REPORT")
warn_ids=${warn_ids% }
warns=$(grep -c '^warning\[\]=' "$REPORT" 2>/dev/null || echo 0)

sugg_ids=$(awk -F'|' '/^suggestion\[\]=/{sub(/^suggestion\[\]=/,"",$1); printf "%s ", $1}' "$REPORT")
sugg_ids=${sugg_ids% }
suggs=$(grep -c '^suggestion\[\]=' "$REPORT" 2>/dev/null || echo 0)

mkdir -p "$STATE_DIR"

best=$(cat "$BEST_FILE" 2>/dev/null); best=${best//[^0-9]/}; best=${best:-0}
best_ver=$(cat "$BEST_VER_FILE" 2>/dev/null); best_ver=${best_ver:-unknown}

msg="hardening index ${index} (best ${best}), ${warns} warnings, ${suggs} suggestions"
[ -n "$warn_ids" ] && msg="$msg [${warn_ids}]"

if [ "$index" -lt "$MIN_INDEX" ]; then
    notify down "$msg — below the floor of ${MIN_INDEX}"
    exit 1
fi

if [ "$best_ver" != "unknown" ] && [ "$best_ver" != "$lynis_ver" ] && [ "$best" -gt 0 ]; then
    printf '%s\n' "$index" > "$BEST_FILE"
    printf '%s\n' "$lynis_ver" > "$BEST_VER_FILE"
    cp -f "$REPORT" "$LAST_REPORT" 2>/dev/null || true
    notify up "$msg — baseline reset, lynis ${best_ver} -> ${lynis_ver}"
    exit 0
fi

if [ "$index" -lt "$best" ]; then
    new_ids=""
    if [ -r "$LAST_REPORT" ]; then
        prev=$(awk -F'|' '/^warning\[\]=/{sub(/^warning\[\]=/,"",$1); print $1}' "$LAST_REPORT")
        for w in $warn_ids; do
            printf '%s\n' "$prev" | grep -qx "$w" || new_ids="$new_ids $w"
        done
        new_ids=${new_ids# }
    fi
    [ -n "$new_ids" ] && msg="$msg — new since last run: ${new_ids}"
    notify down "$msg — regression, was ${best} (lynis ${lynis_ver})"
    exit 1
fi

[ "$index" -gt "$best" ] && printf '%s\n' "$index" > "$BEST_FILE"
printf '%s\n' "$lynis_ver" > "$BEST_VER_FILE"

new_warn=""
new_sugg=""
if [ -r "$LAST_REPORT" ] && grep -q '^hardening_index=' "$LAST_REPORT" 2>/dev/null; then
    prev_w=$(awk -F'|' '/^warning\[\]=/{sub(/^warning\[\]=/,"",$1); print $1}' "$LAST_REPORT")
    for w in $warn_ids; do
        printf '%s\n' "$prev_w" | grep -qx "$w" || new_warn="$new_warn $w"
    done
    new_warn=${new_warn# }
    prev_s=$(awk -F'|' '/^suggestion\[\]=/{sub(/^suggestion\[\]=/,"",$1); print $1}' "$LAST_REPORT")
    for s in $sugg_ids; do
        printf '%s\n' "$prev_s" | grep -qx "$s" || new_sugg="$new_sugg $s"
    done
    new_sugg=${new_sugg# }
fi

cp -f "$REPORT" "$LAST_REPORT" 2>/dev/null || true

if [ -n "$new_warn" ]; then
    notify down "$msg — new warning(s) since the last green run: ${new_warn}"
    exit 1
fi

[ -n "$new_sugg" ] && msg="$msg — new suggestion(s): ${new_sugg}"

notify up "$msg"
