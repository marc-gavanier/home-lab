#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Homelab Pi — weekly lynis audit -> Uptime Kuma push
# =============================================================================
# Runs a lynis system audit and reports the hardening index + warning count to
# a Kuma push monitor. Pushes DOWN when the hardening index drops below the
# threshold (a regression signal — e.g. a new service loosened the posture);
# the warning count rides in the message either way. No-ops if no URL is set.

set -uo pipefail

KUMA_PUSH_URL='{{ lynis_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"   # tolerate a pasted example query string
MIN_INDEX={{ lynis_min_index | default(65) }}
REPORT=/var/log/lynis-report.dat
STATE_DIR=/var/lib/homelab-lynis
BEST_FILE="$STATE_DIR/best-index"
BEST_VER_FILE="$STATE_DIR/best-index-lynis-version"
LAST_REPORT="$STATE_DIR/last-green-report.dat"

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    #
    # The failure is KEPT, not discarded. This call used to end in `2>&1 || true`,
    # which threw away curl's diagnosis AND its verdict, so a report that reached
    # nobody was indistinguishable from one that landed. Measured on 2026-08-30:
    # three runs of homelab-health finished green, having done their work, while
    # their beats never reached Kuma and the monitor sat on a reading 16 min 55 s
    # old. `|| echo` rather than a real failure because the caller must not abort
    # on it — what failed is the report, not the check it carries. The marker
    # string is what `no-kuma-report-was-lost-in-silence` reads in the posture
    # spec; keep the two in step.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null ||
            echo "kuma-push-failed: this report reached nobody — $2" >&2
}

# The report's own timestamp, taken BEFORE the run. Everything below used to
# rest on `[ ! -r "$REPORT" ]`, which could never fire: the distribution ships
# its own lynis.timer, it is enabled, and it runs DAILY — so this file is
# permanently fresh whether or not the audit below did anything at all. lynis
# could have failed every week for months and the push would have kept carrying
# the previous run's numbers, in green. The absence of a FRESH artefact is the
# signal, not the absence of an artefact — the same reasoning the backup script
# applies to the Immich dump.
before=$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)

lynis audit system --quick --no-colors >/dev/null 2>&1 || true

if [ ! -r "$REPORT" ]; then
    notify down "lynis produced no report"
    exit 1
fi

after=$(stat -c %Y "$REPORT" 2>/dev/null || echo 0)
if [ "$after" = "$before" ]; then
    notify down "lynis did not refresh its report — the audit did not run"
    exit 1
fi

index=$(awk -F= '/^hardening_index=/{print $2; exit}' "$REPORT")
index=${index//[^0-9]/}; index=${index:-0}

# The warning TEST IDs, not just how many. On 2026-08-23 this monitor said
# "index 71 (best 73), 4 warnings — regression, was 73" and there was no way to
# learn WHICH four: the report is rewritten by the next audit, and a manual run
# two hours later had already destroyed it. The regression turned out to be
# KRNL-5830, "reboot of system is most likely needed" — a legitimate, temporary,
# operator-actionable condition that held this monitor red for three days.
# Naming them would have said so in the first message.
warn_ids=$(awk -F'|' '/^warning\[\]=/{sub(/^warning\[\]=/,"",$1); printf "%s ", $1}' "$REPORT")
warn_ids=${warn_ids% }
warns=$(grep -c '^warning\[\]=' "$REPORT" 2>/dev/null || echo 0)

mkdir -p "$STATE_DIR"

# --- The baseline, and the trap that was in it ------------------------------
# A ratchet on the best index ever recorded, because the absolute floor is
# decorative: MIN_INDEX is 65 and the index has measured 74 on five consecutive
# samples with zero variance, so a fall to 66 — nine points of hardening lost —
# is reported green. The floor stays as a backstop; the ratchet is what actually
# guards.
#
# It never lowers itself, and that was a time bomb: the hardening index is
# computed by lynis, so a lynis UPGRADE that adds tests lowers it for everyone,
# permanently, with no path back to green. The monitor would have been red
# forever for a reason that is not a regression at all — a change of ruler, not
# of what is being measured.
#
# So the baseline is tied to the version that produced it. A new lynis version
# resets it and SAYS SO rather than alarming; a regression under the same
# version is a real regression. To accept a drop deliberately under the same
# version, remove $BEST_FILE.
lynis_ver=$(lynis show version 2>/dev/null | tr -cd '0-9.'); lynis_ver=${lynis_ver:-unknown}
best=$(cat "$BEST_FILE" 2>/dev/null); best=${best//[^0-9]/}; best=${best:-0}
best_ver=$(cat "$BEST_VER_FILE" 2>/dev/null); best_ver=${best_ver:-unknown}

msg="hardening index ${index} (best ${best}), ${warns} warnings"
[ -n "$warn_ids" ] && msg="$msg [${warn_ids}]"

if [ "$index" -lt "$MIN_INDEX" ]; then
    notify down "$msg — below the floor of ${MIN_INDEX}"
    exit 1
fi

# `unknown` means this file did not exist yet, which is NOT a version change —
# it is the state every host is in the first time this runs. Treating the two
# alike would discard the recorded baseline on that first run and quietly accept
# whatever the index happened to be, which is the one moment a regression would
# be invisible. Found on deployment, 2026-08-26: best-index held 73 and the
# version file was absent, so the next scheduled audit would have rebaselined
# instead of comparing.
if [ "$best_ver" != "unknown" ] && [ "$best_ver" != "$lynis_ver" ] && [ "$best" -gt 0 ]; then
    # Not a regression: a different ruler. Report it, rebaseline, stay green —
    # and name both versions so the next audit knows the comparison restarted.
    printf '%s\n' "$index" > "$BEST_FILE"
    printf '%s\n' "$lynis_ver" > "$BEST_VER_FILE"
    cp -f "$REPORT" "$LAST_REPORT" 2>/dev/null || true
    notify up "$msg — baseline reset, lynis ${best_ver} -> ${lynis_ver}"
    exit 0
fi

if [ "$index" -lt "$best" ]; then
    # Name what is NEW since the last run rather than leaving "regression, was
    # 73" to be investigated against a report that no longer exists. The copy
    # below is what makes this possible at all.
    new_ids=""
    if [ -r "$LAST_REPORT" ]; then
        prev=$(awk -F'|' '/^warning\[\]=/{sub(/^warning\[\]=/,"",$1); print $1}' "$LAST_REPORT")
        for w in $warn_ids; do
            printf '%s\n' "$prev" | grep -qx "$w" || new_ids="$new_ids $w"
        done
        new_ids=${new_ids# }
    fi
    [ -n "$new_ids" ] && msg="$msg — new since last run: ${new_ids}"
    notify down "$msg — regression, was ${best} (lynis ${lynis_ver})"
    exit 1
fi

[ "$index" -gt "$best" ] && printf '%s\n' "$index" > "$BEST_FILE"
printf '%s\n' "$lynis_ver" > "$BEST_VER_FILE"

# Keep the report that produced a GREEN verdict, so the next regression has
# something to be compared against. lynis rewrites /var/log/lynis-report.dat on
# every run, including a manual one, so without this copy the evidence for a
# regression is gone by the time anyone reads the message about it.
cp -f "$REPORT" "$LAST_REPORT" 2>/dev/null || true

notify up "$msg"
