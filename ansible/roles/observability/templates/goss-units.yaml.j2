# {{ ansible_managed }}
# =============================================================================
# Homelab — systemd unit state, declared (ADR-030, ADR-032)
# =============================================================================
# Two of the five conditions homelab-health.sh implemented by hand. The other
# three did not move, and the reasons are worth knowing before editing this:
#
#   activating loop   the units have to be ENUMERATED and named, and goss cannot
#                     report a value — it streams stdout and every format says
#                     `object: *bytes.Reader`. It stays in the script.
#   timer last run    enumerated from `systemctl list-timers homelab-*`, so a new
#                     timer is covered without editing anything. A static spec
#                     would trade that for a list to maintain. It stays.
#   NRestarts delta   DELETED rather than moved, on the script's own measurement:
#                     "Measured over 60 days: one real detection and ZERO
#                     notifications". It cost a state file, a latch and the
#                     subtlest reasoning in that file.
#
# --- Why `running` and not `enabled` ----------------------------------------
# Measured, and it is the repository's own decision showing up in a linter: goss
# reports docker.service `enabled: Expected false to equal true`, because the
# staged startup owns docker deliberately and ssh is socket-activated. Both must
# be RUNNING and neither is enabled. Asserting `enabled` here would fail forever
# on a correct machine.
#
# --- The grace period is NOT here -------------------------------------------
# goss has no memory, and these checks exist because of one: Docker restarted on
# 2026-08-16 at 21:36:23 and was up at 21:37:02, 39 seconds where systemctl does
# not say "active". A check running every five minutes has a 13% chance of
# landing there. homelab-health.sh passes the names of failing assertions through
# the shared gate before reporting them, so a transient restart never leaves this
# spec as a notification. That composition is what made this migration possible
# at all — the gate arrived first, on purpose.
#
# Nothing here is gated on /mnt/data either. The script skips this whole spec
# before the LUKS unlock, when the stack is legitimately down and
# claude-remote-control legitimately retries.
# =============================================================================

service:
{% for u in health_watched_units %}
  # {{ u.why }}
  {{ u.unit }}:
    running: true
{% endfor %}

command:

  # The catch-all, and it is the one that names nothing — deliberately. The five
  # assertions above name their unit; this one exists for a unit NOBODY listed,
  # which is exactly the case a list cannot cover. When it fires, the operator
  # runs `systemctl --failed`, which is one command and the same one this runs.
  #
  # `systemctl --failed` alone would NOT have caught either incident that made
  # these checks exist: a unit with Restart=on-failure and StartLimitIntervalSec=0
  # restarts forever and never reaches the failed state — it sits in
  # activating/auto-restart, and --failed stays empty. That is why the script
  # still watches `activating` separately. claude-remote-control looped 1 112
  # times over 5h47 on 2026-07-27 while work was going on continuously on this
  # host, and fail2ban — including its sshd jail — was down for six minutes the
  # same morning (issue #52).
  systemd-no-failed-units:
    exec: '[ -z "$(systemctl --failed --no-legend --plain 2>/dev/null)" ]'
    exit-status: 0

  # e2scrub_all.timer is masked because it scrubs LVM logical volumes and this
  # host has none — it was green every week since installation over ZERO bytes
  # (#154). The mask is what this asserts, not the absence of the package: the
  # timer ships with e2fsprogs, so an update can put the unit file back, and the
  # thing that must survive is the decision, not the file.
  #
  # `is-enabled` on a masked unit prints `masked` and exits 1 (measured on
  # lynis.timer, which is masked here for the same class of reason). Asserting
  # BOTH the word and the exit status matters: `enabled` also exits 0, so an
  # exit-status assertion alone would pass on exactly the state this forbids.
  e2scrub-timer-still-masked:
    exec: systemctl is-enabled e2scrub_all.timer
    exit-status: 1
    stdout: ["/^masked$/"]

  # The root filesystem's boot-time check needs BOTH halves, and each is
  # asserted separately because each can be lost on its own (#154).
  #
  # The fstab half is the fragile one, and not hypothetically: cloud-init's
  # `mounts` module is enabled on this host and rewrites /etc/fstab, and
  # /etc/hosts is already wiped on every boot by the same mechanism. A passno
  # silently reset to 0 leaves the superblock triggers below still armed and
  # still green, with nothing ever consulting them — a check that is configured,
  # asserted, and never runs.
  root-fstab-has-fsck-pass:
    exec: awk '!/^#/ && $2 == "/" { print $6 }' /etc/fstab
    exit-status: 0
    stdout: ["/^[1-9]$/"]

  # The superblock half — and read #260 before reading it as a schedule.
  #
  # This comment used to say these two values are what systemd-fsck-root.service
  # consults. They are not, and that service does not run: it is skipped at
  # every boot with `ConditionPathExists=!/run/initramfs/fsck-root`, because the
  # INITRAMFS has already checked the root device. The initramfs runs before any
  # time sync, and neither Pi has an RTC, so its clock reads a frozen value —
  # 2026-07-28 17:04 on both hosts, which is also what four consecutive boots
  # stamp as their first journal entry. Every superblock therefore looks
  # future-dated to it:
  #
  #   writable: Superblock last write time (Wed Aug 26 20:55:35 2026,
  #           now = Tue Jul 28 15:04:46 2026) is in the future. FIXED.
  #
  # So a FULL check runs at every boot regardless of these triggers, and then
  # rewrites `Last checked` and the mount count backwards — which is why both
  # hosts read `Last checked: Tue Jul 28` and `Mount count: 1` after three and
  # four boots. Neither trigger can fire, and neither needs to.
  #
  # The assertion is kept because the configuration should be right the day the
  # clock is, and because a hand-run `tune2fs` that loosens it should still
  # fail here. What it must NOT be read as is proof that anything is due.
  # `root-was-checked-this-boot` below is the one that tests capability.
  root-fsck-triggers-armed:
    exec: tune2fs -l "$(findmnt -no SOURCE /)"
    exit-status: 0
    stdout:
      - "/Maximum mount count:\\s+{{ root_fsck_max_mounts }}\\b/"
      - "/Check interval:\\s+{{ root_fsck_interval_days | int * 86400 }}\\b/"

  # Capability, not configuration (#260). The two assertions above say the
  # triggers are set; this one says a check actually happened. The log lives in
  # /run, so it is this boot's and no other — an empty or absent one means
  # nothing checked the root filesystem when this host came up, which is the
  # state `fsck.mode=skip` on the kernel command line produces and which the
  # superblock assertions above would sail straight through.
  root-was-checked-this-boot:
    exec: |
      log=/run/initramfs/fsck.log
      [ -r "$log" ] || { echo "no $log — nothing recorded a root check for this boot"; exit 1; }
      grep -q 'fsck\.ext4' "$log" || { echo "$log records no ext4 check"; exit 1; }
    exit-status: 0
