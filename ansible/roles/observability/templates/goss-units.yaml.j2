# {{ ansible_managed }}

service:
{% for u in health_watched_units %}
  {{ u.unit }}:
    running: true
{% if u.enabled | default(false) %}
    enabled: true
{% endif %}
{% endfor %}

command:

  sshd-config-is-loadable:
    exec: /usr/sbin/sshd -t
    exit-status: 0

  ufw-enforcing:
    exec: ufw status verbose
    exit-status: 0
    stdout:
      - "/^Status: active$/"
      - "/^Default: deny \\(incoming\\)/"

  systemd-no-failed-units:
    exec: '[ -z "$(systemctl --failed --no-legend --plain 2>/dev/null)" ]'
    exit-status: 0

  e2scrub-timer-still-masked:
    exec: systemctl is-enabled e2scrub_all.timer
    exit-status: 1
    stdout: ["/^masked$/"]

  root-fstab-has-fsck-pass:
    exec: awk '!/^#/ && $2 == "/" { print $6 }' /etc/fstab
    exit-status: 0
    stdout: ["/^[1-9]$/"]

  root-fsck-triggers-armed:
    exec: tune2fs -l "$(findmnt -no SOURCE /)"
    exit-status: 0
    stdout:
      - "/Maximum mount count:\\s+{{ root_fsck_max_mounts }}\\b/"
      - "/Check interval:\\s+{{ root_fsck_interval_days | int * 86400 }}\\b/"

  root-was-checked-this-boot:
    exec: |
      log=/run/initramfs/fsck.log
      [ -r "$log" ] || { echo "no $log — nothing recorded a root check for this boot"; exit 1; }
      grep -q 'fsck\.ext4' "$log" || { echo "$log records no ext4 check"; exit 1; }
    exit-status: 0

  ddns-boot-run-waits-for-the-volume:
    exec: |
      b=$(systemctl show homelab-ddns.timer -p TimersMonotonic --value)
      [ -z "$b" ] || { echo "homelab-ddns.timer has a monotonic trigger again: $b"; exit 1; }
      [ -L /etc/systemd/system/mnt-data.mount.wants/homelab-ddns.service ] ||
        { echo "nothing pulls the DDNS boot run when /mnt/data mounts"; exit 1; }
    exit-status: 0

  journal-store-is-on-the-encrypted-volume:
    exec: |
      src=$(findmnt -no SOURCE --target /var/log/journal 2>/dev/null)
      mountpoint -q /var/log/journal ||
        { echo "/var/log/journal is a plain directory on the SD card, not a mount point — a reflash puts credentials back on unencrypted storage"; exit 1; }
      case "$src" in
        /dev/mapper/data_crypt*) : ;;
        *) echo "the journal store is mounted from '$src', not from the encrypted volume"; exit 1 ;;
      esac
    exit-status: 0

  restic-repo-has-no-stale-lock:
    exec: |
      d={{ backup_dir }}/restic-repo/locks
      [ -d "$d" ] || { echo "$d absent - this is no longer a restic repository"; exit 1; }
      pgrep -x restic >/dev/null 2>&1 && exit 0
      now=$(date +%s); stale=""
      for f in "$d"/*; do
        [ -f "$f" ] || continue
        age=$(( now - $(stat -c %Y "$f") ))
        [ "$age" -gt 3600 ] && stale="$stale ${f##*/} (${age}s)"
      done
      [ -z "$stale" ] || { echo "stale lock(s), no restic running:$stale"; exit 1; }
    exit-status: 0
