# {{ ansible_managed }}
[Unit]
Description=Weekly SMART short self-test on the homelab data disk

[Timer]
# Weekly rather than the offsite's monthly, because a short test costs two
# minutes instead of hours — there is no reason to space it out. Wednesday
# keeps it away from the Sunday cluster (restic prune 05:00, offsite check
# 06:00), and 04:30 is after the nightly backup window.
OnCalendar=Wed *-*-* 04:30
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
