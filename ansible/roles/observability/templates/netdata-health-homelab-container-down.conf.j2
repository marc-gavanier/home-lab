# {{ ansible_managed }}
# =============================================================================
# Curated alarm — a container that exists but is not running (ADR-030, phase 2)
# =============================================================================
# The companion to homelab-container-unhealthy: `docker ps --filter
# health=unhealthy` only lists RUNNING containers, and the heal timer only
# resurrects ones that exited on their own. A container that fails to come back
# is invisible to both. That is how a stopped socket-proxy would go unnoticed
# while Traefik keeps answering 200 from its in-memory routes, blind to every
# container change (issue #34).
#
# `max -10m of running` is 0 only if the container was running at NO point in
# the window. The gate lives in the lookup for the same reason as the alarm next
# door: `delay` postpones a notification netdata never sends, and the adapter
# reads the status directly.
#
# --- The boot window, stated rather than discovered later --------------------
# This alarm is NOT equivalent to the check it will replace, and the difference
# is worth naming before it surprises someone.
#
# homelab-health.sh gates its version on `mountpoint -q /mnt/data`, so it stays
# silent between a reboot and the manual LUKS unlock, and only then starts its
# ten-minute clock. A netdata alarm cannot test a host mountpoint. Worse, the
# ten-minute window is only as long as the chart's own history: a few minutes
# after netdata starts, `max -10m` is computed over the few minutes that exist,
# so a container still waiting for its startup wave can trip this early.
#
# Consequence, accepted deliberately: after a supervised reboot this monitor may
# go red for the length of the staged startup, and clear itself. Every other
# path — a container stopped for maintenance, one that failed to come back — is
# the same behaviour the script had.
#
# That is exactly why phase 2 deletes nothing. The script's check stays until
# this one has been watched through a real reboot; if the boot window turns out
# to be noisy, the answer is to keep the gated check for this one condition, not
# to widen the window here.
# =============================================================================

 template: homelab_container_down
       on: docker.container_state
    class: Errors
     type: Docker
component: Container
   lookup: max -10m unaligned of running
    units: boolean
    every: 1m
     warn: $this == 0
  summary: A container exists but has not been running for ten minutes
     info: Container present in the engine and not running for 10m — expected containers that are ABSENT entirely are covered by the goss spec, not here
       to: silent
