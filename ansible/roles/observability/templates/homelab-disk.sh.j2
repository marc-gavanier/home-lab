#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Homelab Pi — daily disk-health report
# =============================================================================
# The 5 TB disk carries every service's data, the media library and the local
# restic repository, and until now nothing watched it. The offsite Pi — which
# holds a *copy* — had a weekly SMART report and a monthly long self-test since
# July; the original had neither. The only self-test ever run on this drive was
# a short one at 16 power-on hours, measured 2026-08-15 at 2363.
#
# Daily rather than the offsite's weekly, because this drive takes writes from
# 25 services continuously while the offsite one is read once a night. Reading
# the attributes costs nothing and never spins the drive up: it is always awake.
#
# The overall `smartctl -H` verdict is deliberately NOT trusted on its own — it
# stays PASSED until a drive is nearly dead. The early-warning counters are
# checked individually, so any of them leaving zero reports DOWN long before the
# verdict flips. Same reasoning, same counter list as the offsite report.
#
# Power and thermal for the Pi itself stay in homelab-health.sh (every 5 min);
# this is about the disk, and it has its own push monitor so a slowly rotting
# drive cannot hide inside a signal that carries CPU temperature.

set -uo pipefail

KUMA_PUSH_URL='{{ disk_health_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"   # strip a pasted example query (see homelab-health.sh)
MOUNT='{{ data_mount_point }}'
DISK='{{ data_disk_device }}'
DRIVE=${DISK%[0-9]*}

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null 2>&1 || true
}

problems=()
report=()

# --- Capacity ---
# /mnt/data is unlocked by hand after a reboot. Until then there is no
# filesystem to measure — but the drive is still there and its SMART data still
# readable, which is the part that matters here. Report the gap, keep going.

if mountpoint -q "$MOUNT"; then
    usage=$(df --output=pcent "$MOUNT" | tail -1 | tr -dc '0-9')
    [ "$usage" -ge 85 ] && problems+=("disk ${usage}% full")
    report+=("disk ${usage}%")
else
    report+=("locked")
fi

# --- SMART ---
# smartctl exit status is a bitmask: bit 3 (value 8) = disk failing;
# bits 0-2 = command/device errors (USB bridge quirks — not a disk failure).

smart_out=$(smartctl -H -A -l selftest "$DRIVE" 2>/dev/null)
rc=$?
if [ $((rc & 8)) -ne 0 ]; then
    problems+=("SMART FAILING")
fi

raw() { awk -v id="$1" '$1 == id { print $10; exit }' <<<"$smart_out"; }

# Readability is asserted on a VALUE, not on the output being non-empty.
#
# On 2026-08-15 the unreadable case was promoted from a report line to a
# problem, which was the right call and not enough: the branch requires the
# output to be EMPTY, and measurement on this host 2026-08-17 shows it never is.
# smartctl writes its refusals to stdout, so a device it cannot talk to returns
# rc=1 with 285 bytes of "Unable to detect device type". Execution then fell
# through to the normal path, every attribute lookup came back empty, every
# check below was skipped in silence, and the run still ended green.
#
# Power-on hours is the instrument: present on every ATA drive, already needed
# for the self-test staleness check below, and it can only parse as a number if
# the attribute table was genuinely read. Same guard in the offsite sibling
# (#155) — the two scripts drift apart precisely when one is corrected alone.
power_on_h=$(raw 9)
if ! [[ "$power_on_h" =~ ^[0-9]+$ ]]; then
    problems+=("SMART unreadable (rc=$rc)")
else
    # Each of these is an early failure predictor, and each must stay at zero:
    # media decay (5/197/198), data-path corruption (184), read failures the
    # drive corrected but should not have had (187), and USB cable or bridge
    # trouble (199) — the fault that killed the first candidate disk.
    for spec in 5:realloc 184:end-to-end 187:uncorrectable \
                197:pending 198:offline-uncorrectable 199:crc-err; do
        v=$(raw "${spec%%:*}")
        if [ -n "$v" ] && [ "$v" != "0" ]; then
            problems+=("SMART ${spec#*:}=$v")
        fi
    done

    # Temperature (attribute 194). 60C rather than the offsite SSD's 70: this is
    # a spinning drive in an enclosure, rated to 65, and it already idles near 53.
    hdd_temp=$(raw 194)
    if [ -n "$hdd_temp" ]; then
        report+=("hdd ${hdd_temp}C")
        [ "$hdd_temp" -ge 60 ] && problems+=("hdd ${hdd_temp}C")
    fi

    # Last self-test — an EXTENDED one since #207, started weekly by
    # homelab-smart-test.timer. Only the most recent log entry is read, so a
    # failure that has since been repaired does not alarm forever.
    #
    # The condition is stated positively, and that is the fix rather than a
    # style choice. It used to read `grep -qiE 'fail|aborted'`, which alarms on
    # the two outcomes somebody thought of and stays silent on every other —
    # "Interrupted (host reset)", "Completed: unknown failure", a status a
    # future smartctl invents, or a log this parser failed to read. Each of
    # those is a self-test that did not clean-complete, reported as health.
    # Anything that is not a clean completion or a run still going is a problem.
    selftest=$(awk '/^# 1/ { $1=""; $2=""; print; exit }' <<<"$smart_out" | xargs)
    if [ -n "$selftest" ]; then
        grep -qiE 'completed without error|in progress' <<<"$selftest" \
            || problems+=("self-test: $selftest")
        # Dead-man's check on the timer itself: the log stamps each test in
        # drive power-on hours, so comparing with attribute 9 catches a silently
        # dead timer instead of leaving an eternally green "Completed without
        # error" from a year ago — which is exactly the state this drive was
        # found in, its only self-test dating back to 16 power-on hours out of
        # 2363. 336 h = two missed weekly runs.
        test_h=$(awk '/^# 1/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { print $(i + 1); exit } }' <<<"$smart_out")
        if [ -n "$test_h" ] && [ $((power_on_h - test_h)) -gt 336 ]; then
            problems+=("self-test stale ($(((power_on_h - test_h) / 24))d ago)")
        fi
    else
        report+=("no self-test yet")
    fi
fi

# --- Filesystem, as opposed to disk ---
# The middle layer was missing: SMART watches the hardware and nothing watched
# the filesystem on top of it. ext4 keeps an error counter in the superblock,
# and that counter is the only trace that survives both a reboot and journal
# rotation — so it is precisely what an intermittent problem leaves behind after
# every other record of it is gone. Nobody read it.
#
# A clean filesystem prints NO "FS Error count" line at all, so its presence is
# itself the signal; `Filesystem state` is the second one, and it reads
# "clean with errors" rather than "clean" once anything has been recorded.
# Both volumes are clean today, so this instruments a margin that has never been
# spent rather than fixing something.
#
# `errors=remount-ro` — the other half of the answer, both volumes being on
# "Continue" — is deliberately NOT changed here. Turning a data volume
# read-only mid-incident is a real trade-off on a host that serves media and
# backups, and it deserves its own decision rather than riding along.
ext4_bad=""
# An empty result was indistinguishable from a clean pass: with /mnt/data locked
# the loop visits only `/`, and with findmnt absent or the daemon confused it
# visits nothing at all — and the push said `ext4 clean` either way, asserting
# for filesystems it never opened (#177). Same shape as "posture OK on 0
# containers". Counting what was actually visited is the whole fix, and putting
# the count in the message makes the locked case visible instead of silent.
ext4_seen=0
while read -r src tgt; do
    ext4_seen=$((ext4_seen + 1))
    hdr=$(dumpe2fs -h "$src" 2>/dev/null) || { ext4_bad="$ext4_bad $tgt(unreadable)"; continue; }
    state=$(awk -F: '/^Filesystem state/ { gsub(/^ +| +$/, "", $2); print $2 }' <<<"$hdr")
    errs=$(awk -F: '/^FS Error count/ { gsub(/ /, "", $2); print $2 }' <<<"$hdr")
    # An empty state means the header parsed but told us nothing — read as a
    # failure, not as a pass, like every other check in this stack.
    case "$state" in
        clean) ;;
        "")    ext4_bad="$ext4_bad $tgt(state unreadable)" ;;
        *)     ext4_bad="$ext4_bad $tgt($state)" ;;
    esac
    [ -n "$errs" ] && ext4_bad="$ext4_bad $tgt($errs recorded errors)"
done < <(findmnt -l -t ext4 -no SOURCE,TARGET)

if [ "$ext4_seen" -eq 0 ]; then
    problems+=("ext4: no filesystem was visited — the check asserted nothing")
elif [ -n "$ext4_bad" ]; then
    problems+=("ext4:$ext4_bad")
else
    report+=("ext4 clean ($ext4_seen)")
fi

# --- Verdict ---

join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }

msg=$(join ', ' "${report[@]}")
{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "$msg"
