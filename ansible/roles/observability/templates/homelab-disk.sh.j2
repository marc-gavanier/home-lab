#!/usr/bin/env bash
# {{ ansible_managed }}

set -uo pipefail

KUMA_PUSH_URL='{{ disk_health_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"
MOUNT='{{ data_mount_point }}'
DISK='{{ data_disk_device }}'
DRIVE=${DISK%[0-9]*}

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    local rc=0
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null || rc=$?
    case "$rc" in
        0) ;;
        28) echo "kuma-push-unconfirmed: no reply within 10s, the beat may have landed — $2" >&2 ;;
        *)  echo "kuma-push-failed: this report reached nobody — $2" >&2 ;;
    esac
}

problems=()
report=()

if mountpoint -q "$MOUNT"; then
    usage=$(df --output=pcent "$MOUNT" | tail -1 | tr -dc '0-9')
    [ "$usage" -ge 85 ] && problems+=("disk ${usage}% full")
    report+=("disk ${usage}%")
else
    report+=("locked")
fi

smart_out=$(smartctl -H -A -l selftest "$DRIVE" 2>/dev/null)
rc=$?
if [ $((rc & 8)) -ne 0 ]; then
    problems+=("SMART FAILING")
fi

raw() { awk -v id="$1" '$1 == id { print $10; exit }' <<<"$smart_out"; }

power_on_h=$(raw 9)
if ! [[ "$power_on_h" =~ ^[0-9]+$ ]]; then
    problems+=("SMART unreadable (rc=$rc)")
else
    smart_seen=0
    smart_absent=""
    for spec in 5:realloc 184:end-to-end 187:uncorrectable \
                198:offline-uncorrectable 199:crc-err; do
        v=$(raw "${spec%%:*}")
        if [ -z "$v" ]; then
            smart_absent="$smart_absent ${spec#*:}"
            continue
        fi
        smart_seen=$((smart_seen + 1))
        if [ "$v" != "0" ]; then
            problems+=("SMART ${spec#*:}=$v")
        fi
    done
    if [ "$smart_seen" -eq 0 ]; then
        problems+=("SMART: none of the five predictors is readable — the check asserted nothing")
    else
        report+=("SMART ${smart_seen}/5${smart_absent:+ (absent:$smart_absent)}")
    fi

    hdd_temp=$(raw 194)
    hdd_tmax=$(smartctl -x "$DRIVE" 2>/dev/null |
               awk -F: '/Power Cycle Min\/Max Temperature/ {
                            gsub(/[^0-9\/]/, "", $2); split($2, a, "/"); print a[2]; exit }')
    if [ -n "$hdd_temp" ]; then
        if [ -n "$hdd_tmax" ]; then
            report+=("hdd ${hdd_temp}C (peak ${hdd_tmax}C)")
            [ "$hdd_tmax" -ge 60 ] && problems+=("hdd peak ${hdd_tmax}C this power cycle")
        else
            report+=("hdd ${hdd_temp}C (no peak counter)")
            [ "$hdd_temp" -ge 60 ] && problems+=("hdd ${hdd_temp}C")
        fi
    fi

    selftest=$(awk '/^# 1/ { $1=""; $2=""; print; exit }' <<<"$smart_out" | xargs)
    done_test=$(awk '/^#[[:space:]]+[0-9]+/ { if ($0 ~ /Completed/) { $1=""; $2=""; print; exit } }' \
                <<<"$smart_out" | xargs)

    if [ -n "$selftest" ]; then
        case "$(tr '[:upper:]' '[:lower:]' <<<"$selftest")" in
            *"completed without error"*) ;;
            *"completed:"*)              problems+=("self-test: $selftest") ;;
            *abort*|*interrupt*|*"in progress"*)
                                         report+=("self-test: $selftest") ;;
            *)                           problems+=("self-test: $selftest") ;;
        esac

        test_h=$(awk '/^#[[:space:]]+[0-9]+/ { if ($0 ~ /Completed/) { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { print $(i + 1); exit } } }' \
                 <<<"$smart_out")
        if [ -z "$test_h" ]; then
            problems+=("no completed self-test in the log")
        elif [ $((power_on_h - test_h)) -gt 336 ]; then
            problems+=("self-test stale ($(((power_on_h - test_h) / 24))d ago)")
        fi
    else
        report+=("no self-test yet")
    fi

    PENDING_STATE=/var/lib/homelab-disk/pending.last
    pending=$(raw 197)
    if [ -z "$pending" ]; then
        problems+=("SMART pending unreadable")
    elif [ "$pending" = "0" ]; then
        rm -f "$PENDING_STATE" 2>/dev/null || true
    else
        report+=("pending $pending")
        last=$(cat "$PENDING_STATE" 2>/dev/null || true)
        mkdir -p "$(dirname "$PENDING_STATE")" 2>/dev/null || true
        printf '%s\n' "$pending" > "$PENDING_STATE" 2>/dev/null || true

        if [ -n "$last" ] && [ "$pending" -gt "$last" ] 2>/dev/null; then
            problems+=("SMART pending rose $last -> $pending")
        elif [ -z "$done_test" ]; then
            problems+=("SMART pending=$pending and no completed self-test to weigh it against")
        elif ! grep -qi 'completed without error' <<<"$done_test"; then
            problems+=("SMART pending=$pending, last completed self-test: $done_test")
        fi
    fi
fi

ext4_bad=""
ext4_seen=0
ext4_devs=""
while read -r src tgt; do
    src="${src%%\[*}"
    case " $ext4_devs " in *" $src "*) continue ;; esac
    ext4_devs="$ext4_devs $src"
    ext4_seen=$((ext4_seen + 1))
    hdr=$(dumpe2fs -h "$src" 2>/dev/null) || { ext4_bad="$ext4_bad $tgt(unreadable)"; continue; }
    state=$(awk -F: '/^Filesystem state/ { gsub(/^ +| +$/, "", $2); print $2 }' <<<"$hdr")
    errs=$(awk -F: '/^FS Error count/ { gsub(/ /, "", $2); print $2 }' <<<"$hdr")
    case "$state" in
        clean) ;;
        "")    ext4_bad="$ext4_bad $tgt(state unreadable)" ;;
        *)     ext4_bad="$ext4_bad $tgt($state)" ;;
    esac
    [ -n "$errs" ] && ext4_bad="$ext4_bad $tgt($errs recorded errors)"
done < <(findmnt -l -t ext4 -no SOURCE,TARGET)

if [ "$ext4_seen" -eq 0 ]; then
    problems+=("ext4: no filesystem was visited — the check asserted nothing")
elif [ -n "$ext4_bad" ]; then
    problems+=("ext4:$ext4_bad")
else
    report+=("ext4 clean ($ext4_seen)")
fi

join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }

msg=$(join ', ' "${report[@]}")
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "$msg"
