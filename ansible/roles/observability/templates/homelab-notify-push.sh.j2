#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Homelab Pi — Nextcloud notify_push self-test
# =============================================================================
# notify_push fails silently by construction: when the push connection breaks,
# the desktop and mobile clients fall back to polling every 30s. Files keep
# syncing, nothing logs an error, and the only symptom is a Pi quietly doing
# more work than it should. That is why this needs an active probe and not a
# monitor — there is nothing to observe from the outside.
#
# An HTTP check cannot stand in for it. The binary answers 404 on `/` and 400
# on `/test/cookie` whether or not it can reach Redis, load mount info, or be
# trusted as a proxy (measured 2026-08-15), so a status-code probe stays green
# through every failure that matters.
#
# The six steps this runs are the ones that have actually broken here — the
# 403 through the DNS hairpin, the untrusted reverse proxy, the missing trusted
# domain (knowledge/runbooks/notify-push-troubleshooting.md). All of them
# depend on proxy and DNS configuration this repo changes regularly, which is
# also why the cadence is hourly: the failure follows a deploy rather than
# arriving on its own, and should surface within the hour of causing it.
# One occ call, measured at 2.0s. No-ops when no push URL is configured.

set -uo pipefail

KUMA_PUSH_URL='{{ notify_push_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"   # strip a pasted example query (see homelab-health.sh)

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    #
    # The failure is KEPT, not discarded. This call used to end in `2>&1 || true`,
    # which threw away curl's diagnosis AND its verdict, so a report that reached
    # nobody was indistinguishable from one that landed. Measured on 2026-08-30:
    # three runs of homelab-health finished green, having done their work, while
    # their beats never reached Kuma and the monitor sat on a reading 16 min 55 s
    # old. `|| echo` rather than a real failure because the caller must not abort
    # on it — what failed is the report, not the check it carries. The marker
    # string is what `no-kuma-report-was-lost-in-silence` reads in the posture
    # spec; keep the two in step.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null ||
            echo "kuma-push-failed: this report reached nobody — $2" >&2
}

# Same reasoning as the posture check: /mnt/data is unlocked by hand after a
# reboot, so until then the stack is legitimately down and there is nothing to
# test. Alarming here would cry wolf on every boot.
if ! mountpoint -q /mnt/data; then
    notify up "/mnt/data locked — self-test skipped"
    exit 0
fi

if ! docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -qx nextcloud; then
    notify up "nextcloud not running — self-test skipped"
    exit 0
fi

out=$(docker exec -u www-data nextcloud php occ notify_push:self-test 2>&1)
rc=$?

# Two different failures, and both have to be caught. A non-zero exit means the
# command could not run at all; a ✗ line means it ran and a step failed. The
# failing lines go into the push message, so the Discord alert names the step
# instead of just saying something broke.
failed=$(printf '%s\n' "$out" | grep '✗' | tr '\n' ';' | sed 's/;$//')

if [ "$rc" -ne 0 ] || [ -n "$failed" ]; then
    notify down "${failed:-self-test exited $rc: $(printf '%s' "$out" | tail -1)}"
    exit 1
fi

# Count the passing steps rather than asserting six of them: an app version
# that adds a seventh check would otherwise read as a regression.
passed=$(printf '%s\n' "$out" | grep -c '✓')

# Context, never an alarm. Zero connections is the normal state when every
# client is asleep, so it says something about usage, not about health.
conns=$(docker exec -u www-data nextcloud php occ notify_push:metrics 2>/dev/null \
        | awk -F': ' '/Active connection count/ {print $2}')

# --- Nextcloud cron freshness ---
# Nothing watched it (#177), and the silent failure mode is documented in this
# very repository: crond up, cron.php never running, the container Up and both
# HTTP monitors green, while every background job — file scans, trash and
# version expiry, federated retries, notifications — quietly stops.
#
# `core lastcron` is the unix timestamp cron.php last COMPLETED, so it moves
# only on a real run. One hour is twelve missed five-minute runs, well clear of
# a single slow one. Unreadable reports rather than passes, which is the rule
# the rest of this stack follows.
CRON_MAX_AGE=3600
lastcron=$(docker exec -u www-data nextcloud php occ config:app:get core lastcron 2>/dev/null | tr -dc '0-9')
if [ -z "$lastcron" ]; then
    notify down "self-test ok (${passed} checks) but nextcloud cron: lastcron unreadable"
    exit 1
fi
cron_age=$(( $(date +%s) - lastcron ))
if [ "$cron_age" -gt "$CRON_MAX_AGE" ]; then
    notify down "nextcloud cron last completed ${cron_age}s ago (> ${CRON_MAX_AGE}s) — background jobs have stopped"
    exit 1
fi

notify up "self-test ok (${passed} checks), ${conns:-?} active connection(s), cron ${cron_age}s"
