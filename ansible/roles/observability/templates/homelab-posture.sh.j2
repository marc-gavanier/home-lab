#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Homelab Pi — container security posture check
# =============================================================================
# Asserts that the container hardening is still in place. Nothing else does,
# and every failure this stack has produced was invisible from the outside:
# Uptime Kuma stayed healthy with every ping monitor dead, SearXNG ran two weeks
# on a stub config, netdata reported working charts while running as root. A
# drifted posture would look exactly as normal (issue #33).
#
# The expected values are GENERATED FROM docker/compose.yaml at deploy time, so
# this check cannot drift from the file it is checking: adding a service or
# changing a capability updates the expectation on the next deploy, by
# construction. Hand-maintaining that table would rot at the first new service.
#
# Runs daily rather than every five minutes: posture only changes when a
# container is recreated, and the netdata assertions cost a docker exec each.
# No-ops when no push URL is configured.

set -uo pipefail

KUMA_PUSH_URL='{{ homelab_posture_kuma_push_url | default("") }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"   # strip a pasted example query (see homelab-health.sh)

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null 2>&1 || true
}

problems=()
checked=0

# The operator's uid. A service data directory owned by it, under a container
# that does not itself run as it, is the signature of #138/#144 — see the
# writability derivation below. Resolved once, and never guessed: an
# unresolvable value makes the assertion report instead of silently passing.
OPERATOR_UID=$(id -u '{{ ansible_user }}' 2>/dev/null)

# /mnt/data is unlocked by hand after a reboot: until then the stack is
# legitimately down and there is nothing to assert. The health report already
# covers that window, and alarming here would cry wolf on every boot.
if ! mountpoint -q /mnt/data; then
    notify up "/mnt/data locked — posture not checked"
    exit 0
fi

# No blanket raw block here (#261). One stood at this line and was closed by
# the FIRST inner endraw, 58 lines below, so its own opening marker was emitted
# literally into the deployed script and prefixed a Go template format string.
# Nothing between here and there needs escaping; every Go template below carries
# its own pair, which is the form to keep.
inspect() { docker inspect -f "$2" "$1" 2>/dev/null; }


# --- The declarative half runs first (ADR-032) -------------------------------
# The declarative assertions live in /etc/goss/posture.yaml, generated from
# compose.yaml at deploy time — 326 of them on this host today, a number that
# moves with the compose file and is therefore read from goss rather than
# written down here:
# every container's privileged flag, dropped and added capabilities, read-only
# rootfs, no-new-privileges, user, the AppArmor profile the kernel actually
# applied, netdata's three axes, the fail2ban jails, and the credential store
# modes.
#
# They are declared rather than looped over, and that is the point. Four of the
# ten fixes this file has needed were controls that COULD NOT FAIL — "posture OK
# on 0 containers" was a green push, ten controls could not report the failure
# they named. A loop can visit nothing and return true; goss prints its count,
# so "checked nothing" is not a state it can be in.
GOSS_SPEC=/etc/goss/posture.yaml

if [ ! -r "$GOSS_SPEC" ]; then
    problems+=("goss spec $GOSS_SPEC missing — the declarative assertions did not run")
elif ! command -v goss >/dev/null 2>&1; then
    problems+=("goss binary missing — the declarative assertions did not run")
else
    goss_out=$(goss -g "$GOSS_SPEC" validate --format tap 2>&1) || true
    # The plan line is goss's own count. Its absence means goss failed to parse
    # the spec rather than found nothing wrong, and those must not read alike.
    goss_total=$(printf '%s\n' "$goss_out" | sed -n 's/^1\.\.\([0-9]*\)$/\1/p')
    if [ -z "$goss_total" ] || [ "$goss_total" -eq 0 ]; then
        problems+=("goss produced no assertions — spec unreadable or empty")
    else
        checked=$((checked + goss_total))
        while IFS= read -r line; do
            [ -n "$line" ] && problems+=("${line#not ok [0-9]* - }")
        done < <(printf '%s\n' "$goss_out" | grep '^not ok' || true)
    fi
fi

# --- What goss cannot express: a derivation, not an assertion ----------------
# Whether a container can create files in its own data directory is not a
# property to look up, it is one to work out: resolve the read-write bind
# mounts, compare each owner against the uid the container runs as. A container
# holding DAC_OVERRIDE bypasses the bits anyway, so there is nothing to assert
# for it (#144).
if [ -z "$OPERATOR_UID" ]; then
    problems+=("operator uid unresolved — the writability check cannot run")
else
    while read -r name; do
        [ -n "$name" ] || continue
        # wg-easy was exempted here from 2026-08-17 to 2026-08-25 with the note
        # "#138: cannot write, tracked". A known defect became a permanent hole
        # in the control that would have caught it coming back — and #160, the
        # deploy-path half of the same defect, was found by an audit rather than
        # by this check, because this check had been told not to look. An
        # exemption that outlives the ticket it names is indistinguishable from
        # a blind spot. #138 is fixed; the exemption is gone with it.
        case " $(inspect "$name" '{% raw %}{{range .HostConfig.CapAdd}}{{.}} {{end}}{% endraw %}') " in
            *" CAP_DAC_OVERRIDE "*) continue ;;
        esac
        ctr_uid=$(inspect "$name" '{% raw %}{{.Config.User}}{% endraw %}')
        ctr_uid="${ctr_uid%%:*}"; ctr_uid="${ctr_uid:-0}"
        [ "$ctr_uid" = "$OPERATOR_UID" ] && continue
        while read -r sdir; do
            [ -d "$sdir" ] || continue
            owner=$(stat -c %u "$sdir" 2>/dev/null) || continue
            [ "$owner" = "$OPERATOR_UID" ] || continue
            problems+=("$name: $sdir owned by uid $owner, container runs as $ctr_uid and cannot create files there")
        done < <(inspect "$name" '{% raw %}{{range .Mounts}}{{if and (eq .Type "bind") .RW}}{{.Source}}{{"\n"}}{{end}}{{end}}{% endraw %}')
        checked=$((checked + 1))
    done < <(docker ps --format '{% raw %}{{.Names}}{% endraw %}' 2>/dev/null)
fi

# --- Vaultwarden: config.json must not contradict the compose environment ---
# Vaultwarden's config.json takes precedence over the environment, and the
# admin panel rewrites it in full every time it is saved. A setting declared in
# compose.yaml is therefore free to be inert, and three of them were — from
# 2026-05-15 until #124, icon downloads, Sends and password hints all ran
# INVERTED while this repo said otherwise. The container printed the warning at
# every start; nothing read it.
#
# Both sides are read from the running system, so like the fail2ban check above
# there is no expectation list that can drift. Only a real contradiction counts:
# a key held at the same value is redundant, not dangerous, and four of them are
# (the panel writes back what it was given).
if [ "$(docker inspect -f '{% raw %}{{.State.Status}}{% endraw %}' vaultwarden 2>/dev/null)" = "running" ]; then
    vw_src=$(docker inspect -f '{% raw %}{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}{% endraw %}' \
             vaultwarden 2>/dev/null)
    vw_cfg="$vw_src/config.json"
    # An ABSENT config.json is the ideal state — nothing to shadow, nothing to
    # assert. An UNRESOLVABLE mount is not the same thing: it would make this
    # check disappear without a word, which is the mechanism it exists to catch.
    # Collapsing the two into one silent skip would reproduce the defect here.
    if [ -z "$vw_src" ]; then
        problems+=("vaultwarden: no /data mount — config.json check cannot run")
    elif [ -r "$vw_cfg" ]; then
        # *_FILE indirections are resolved first, and that is not a refinement:
        # compose injects ADMIN_TOKEN_FILE while config.json holds admin_token,
        # so the raw comparison looked up "admin_token_file", never found it,
        # and silently compared nothing (#159). The two values happen to be
        # identical today; a rotation of the vaulted token would have been inert
        # while this check went on reporting agreement.
        #
        # A file that cannot be read is reported rather than passed through —
        # falling back to the raw KEY_FILE line would restore exactly the blind
        # spot being fixed. The resolved value is a hash and is never printed:
        # the comparison below emits key names only.
        #
        # Only paths under /run/secrets/, which is where this stack mounts them.
        # Matching every *_FILE variable was too broad: vaultwarden also sets
        # LOG_FILE=/data/logs/vaultwarden.log, and logrotate empties that file
        # every week — so the check read 0 bytes and reported a secret it could
        # not read, every run, from 2026-08-22 onward. Worse in the other
        # direction: a NON-empty log would have been spliced into this
        # line-oriented listing as LOG=<the whole log>, and any log line shaped
        # like key=value could have raised a conflict out of nothing.
        vw_env=$(docker inspect -f '{% raw %}{{range .Config.Env}}{{println .}}{{end}}{% endraw %}' \
                 vaultwarden 2>/dev/null | while IFS= read -r line; do
            case "$line" in
                *_FILE=/run/secrets/*)
                    vk=${line%%=*}
                    vv=$(docker exec vaultwarden cat "${line#*=}" 2>/dev/null)
                    if [ -n "$vv" ]; then
                        printf '%s=%s\n' "${vk%_FILE}" "$vv"
                    else
                        printf 'UNREADABLE_%s=\n' "$vk"
                    fi
                    ;;
                *) printf '%s\n' "$line" ;;
            esac
        done)
        case "$vw_env" in
            *UNREADABLE_*) problems+=("vaultwarden: a *_FILE secret could not be read — the config.json comparison is incomplete") ;;
        esac
        # Prints OK when clean, so a check that cannot run is not read as a pass.
        conflicts=$(printf '%s\n' "$vw_env" | python3 -c '
import json, sys
cfg = json.load(open(sys.argv[1]))
bad = []
for line in sys.stdin:
    if "=" not in line:
        continue
    k, v = line.strip().split("=", 1)
    key = k.lower()
    if key in cfg and str(cfg[key]).lower() != v.lower():
        bad.append(key)
print(" ".join(sorted(bad)) if bad else "OK")
' "$vw_cfg" 2>/dev/null)
        case "$conflicts" in
            OK) ;;
            "") problems+=("vaultwarden: config.json check did not run") ;;
            *)  problems+=("vaultwarden: config.json overrides compose [$conflicts]") ;;
        esac
    fi
fi

# --- Database credentials: the file must still open the database -----------
# POSTGRES_PASSWORD_FILE and MYSQL_PASSWORD_FILE are read by the image
# entrypoint during initdb and never again — every later start prints "Skipping
# initialization" and ignores them. So writing a new password into the secret
# and restarting rotates NOTHING, while the deploy reports changed and a handler
# visibly restarts the service (#159). The operation is impossible; the evidence
# of work is not.
#
# An entrypoint's behaviour cannot be observed, but its consequence can: if the
# file and the database ever stop agreeing, the credential in the file no longer
# opens the database. That is what this asserts, and it is why the rotation
# procedure in knowledge/runbooks/rotate-a-secret.md ends with a deploy — this
# check is the acceptance test for having followed it.
#
# ADDRESSED BY CONTAINER NAME, not 127.0.0.1, and that detail is the whole
# check: initdb writes `host all all 127.0.0.1/32 trust` into pg_hba, so over
# the loopback Postgres accepts ANY password. Measured — a deliberately wrong
# password returned 1. Over the docker network name the `host all all all
# scram-sha-256` rule applies and a wrong password is refused. MariaDB refuses
# on the loopback already, which is why the two families differ here.
cred_probe() {
    local c="$1" engine="$2" secret="$3" out=""
    [ "$(inspect "$c" '{% raw %}{{.State.Status}}{% endraw %}')" = "running" ] || return 0
    case "$engine" in
        pg) out=$(docker exec "$c" sh -c \
              "PGPASSWORD=\$(cat /run/secrets/$secret) psql -h $c -U \$POSTGRES_USER -d \$POSTGRES_DB -tAc 'select 1'" 2>/dev/null) ;;
        my) out=$(docker exec "$c" sh -c \
              "MYSQL_PWD=\$(cat /run/secrets/$secret) mariadb -h 127.0.0.1 -u \$MYSQL_USER -N -e 'select 1'" 2>/dev/null) ;;
    esac
    [ "$(printf '%s' "$out" | tr -d '[:space:]')" = "1" ] \
        || problems+=("$c: /run/secrets/$secret no longer opens the database — see knowledge/runbooks/rotate-a-secret.md")
}

cred_probe immich-db    pg immich_db_password
cred_probe miniflux-db  pg miniflux_db_password
cred_probe nextcloud-db my nextcloud_db_password

# Miniflux is the one service whose application side carries the password too:
# it takes a whole connection string rather than a password to slot into one. So
# the DSN can drift from the database's own secret without either probe above
# noticing — and the symptom would be Miniflux failing to connect at the next
# restart, not at the deploy that caused it.
MINIFLUX_DSN=/mnt/data/secrets/docker/miniflux_database_url
MINIFLUX_PW=/mnt/data/secrets/docker/miniflux_db_password
if [ -r "$MINIFLUX_DSN" ] && [ -r "$MINIFLUX_PW" ]; then
    dsn_pw=$(sed -n 's/.*password=\([^ ]*\).*/\1/p' "$MINIFLUX_DSN")
    if [ -z "$dsn_pw" ]; then
        problems+=("miniflux: no password= field in the connection string")
    elif [ "$dsn_pw" != "$(cat "$MINIFLUX_PW")" ]; then
        problems+=("miniflux: the application connection string and the database password disagree")
    fi
fi

# --- Verdict ---------------------------------------------------------------
{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    printf '%s\n' "${problems[@]}" >&2
    notify down "$(printf '%s; ' "${problems[@]}")"
    exit 1
fi

notify up "posture OK — $checked checks"
