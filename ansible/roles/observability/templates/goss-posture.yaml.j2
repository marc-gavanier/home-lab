# {{ ansible_managed }}

# [critical]: never write Go template delimiters anywhere in this file, comments included: goss evaluates them
{% set compose = lookup('file', playbook_dir + '/../../docker/compose.yaml') | from_yaml %}
{%- set _cred_all = [] %}
{%- for _n, _s in compose.services.items() %}
{%-   for _v in _s.volumes | default([]) %}
{%-     if (_v | string).startswith('${SERVICES_DATA_DIR}/') %}
{%-       set _ = _cred_all.append((_v | string).split(':')[0] | replace('${SERVICES_DATA_DIR}/', '')) %}
{%-     endif %}
{%-   endfor %}
{%- endfor %}
{%- set _cred_stores = [] %}
{%- for _src in _cred_all | unique %}
{%-   if (_cred_all | select('equalto', _src) | list | length) == 1
        and _src not in credential_store_exemptions
        and '.' not in _src.split('/')[-1] %}
{%-     set _ = _cred_stores.append(_src) %}
{%-   endif %}
{%- endfor %}
{%- set _cred_min = _cred_stores | length %}
file:
  /mnt/data/secrets:
    exists: true
    mode: "0711"
  /mnt/data/secrets/docker:
    exists: true
    mode: "0700"

command:
  credential-stores-all-closed:
    exec: |
      base={{ services_data_dir }}
      exempt="{{ credential_store_exemptions.keys() | list | join(' ') }}"
      want={{ credential_store_default_mode }}; want=${want#0}
      bad=""
      for src in $(docker inspect $(docker ps -aq) \
            | jq -r --arg b "$base/" '.[] | .Mounts[]? | select(.Type == "bind") | select(.Source | startswith($b)) | .Source' \
            | sort | uniq -c | awk '$1 == 1 { print $2 }'); do
        [ -d "$src" ] || continue
        rel=${src#$base/}
        case " $exempt " in *" $rel "*) continue ;; esac
        mode=$(stat -c %a "$src")
        [ "$mode" = "$want" ] || bad="$bad $rel=$mode"
      done
      [ -z "$bad" ] || { echo "not $want:$bad"; exit 1; }
    timeout: 90000
    exit-status: 0

  credential-stores-shared-set-unchanged:
    exec: |
      base={{ services_data_dir }}
      want="{{ credential_store_shared | sort | join(' ') }}"
      got=$(docker inspect $(docker ps -aq) \
            | jq -r --arg b "$base/" '.[] | .Mounts[]? | select(.Type == "bind") | select(.Source | startswith($b)) | .Source' \
            | sort | uniq -c | awk -v b="$base/" '$1 > 1 { sub("^" b, "", $2); print $2 }' \
            | sort | tr '\n' ' ')
      got=${got% }
      [ "$got" = "$want" ] || { echo "shared stores are [$got], declared [$want]"; exit 1; }
    timeout: 90000
    exit-status: 0

  containers-run-the-image-their-tag-designates:
    exec: |
      rows=$(docker inspect $(docker ps -q) \
            | jq -r '.[] | (.Name | ltrimstr("/")) + "|" + .Config.Image + "|" + .Image')
      [ -n "$rows" ] || { echo "no running container inspected — the derivation returned nothing"; exit 1; }
      tags=$(printf '%s\n' "$rows" | awk -F'|' '{ print $2 }' | sort -u)
      map=$(docker image inspect $tags 2>/dev/null \
            | jq -r '.[] | .Id as $i | (.RepoTags[]? | . + " " + $i)')
      n=0
      bad=""
      for row in $rows; do
        name=${row%%|*}; rest=${row#*|}; tag=${rest%%|*}; running=${rest#*|}
        case "$tag" in *@sha256:*) continue ;; esac
        declared=$(printf '%s\n' "$map" | awk -v t="$tag" '$1 == t { print $2; exit }')
        [ -n "$declared" ] || continue
        n=$((n+1))
        [ "$running" = "$declared" ] || bad="$bad ${name}(${tag})"
      done
      [ "$n" -ge 1 ] || { echo "no running container resolved its own tag — the derivation returned nothing"; exit 1; }
      [ -z "$bad" ] || { echo "running an image its declared tag no longer designates:$bad"; exit 1; }
    timeout: 90000
    exit-status: 0

  credential-stores-derivation-nonempty:
    exec: |
      base={{ services_data_dir }}
      exempt="{{ credential_store_exemptions.keys() | list | join(' ') }}"
      n=0
      for src in $(docker inspect $(docker ps -aq) \
            | jq -r --arg b "$base/" '.[] | .Mounts[]? | select(.Type == "bind") | select(.Source | startswith($b)) | .Source' \
            | sort | uniq -c | awk '$1 == 1 { print $2 }'); do
        [ -d "$src" ] || continue
        rel=${src#$base/}
        case " $exempt " in *" $rel "*) continue ;; esac
        n=$((n + 1))
      done
      [ "$n" -ge {{ _cred_min }} ] || { echo "derivation returned $n stores, compose.yaml declares {{ _cred_min }}"; exit 1; }
    timeout: 60000
    exit-status: 0

{%- set _secret_pairs = [] %}
{%- for _sn, _sv in compose.services.items() %}
{%-   for _sec in _sv.secrets | default([]) %}
{%-     set _ = _secret_pairs.append((_sv.container_name | default(_sn)) ~ ' ' ~ _sec) %}
{%-   endfor %}
{%- endfor %}

  secret-mounts-carry-the-current-value:
    exec: |
      pids=$(docker inspect $(docker ps -q) 2>/dev/null \
             | jq -r '.[] | (.Name | ltrimstr("/")) + ":" + (.State.Pid | tostring)')
      [ -n "$pids" ] || { echo "no running container answered docker inspect — this check examined nothing"; exit 1; }
      read_pairs=0
      compared=0
      stale=""
      while read -r cname sname; do
        [ -n "$cname" ] || continue
        read_pairs=$((read_pairs + 1))
        pid=""
        for row in $pids; do
          case "$row" in "$cname":*) pid=${row#*:}; break ;; esac
        done
        case "$pid" in ''|0|null) continue ;; esac
        host=$(sha256sum "/mnt/data/secrets/docker/$sname" 2>/dev/null | cut -c1-64)
        seen=$(sha256sum "/proc/$pid/root/run/secrets/$sname" 2>/dev/null | cut -c1-64)
        [ -n "$host" ] && [ -n "$seen" ] || continue
        compared=$((compared + 1))
        [ "$host" = "$seen" ] || stale="$stale $cname:$sname"
      done <<'PAIRS'
{% for _pair in _secret_pairs %}
      {{ _pair }}
{% endfor %}
      PAIRS
      [ "$read_pairs" -eq {{ _secret_pairs | length }} ] || { echo "read $read_pairs secret mounts, compose.yaml declares {{ _secret_pairs | length }} — the derivation stopped matching, so this check proves nothing"; exit 1; }
      [ "$compared" -gt 0 ] || { echo "not one of the {{ _secret_pairs | length }} secret mounts could be compared — every consumer is down, or /proc is not readable here"; exit 1; }
      [ -z "$stale" ] || { echo "container still holds the PREVIOUS value of:$stale — the deploy that rotated it did not restart the consumer, and the old credential is still live"; exit 1; }
    exit-status: 0
    timeout: 90000

  backup-dumps-mode:
    exec: stat -c %a {{ backup_dir }}/dumps 2>/dev/null || echo absent
    timeout: 60000
    exit-status: 0
    stdout: ["/^(700|absent)$/"]

  backup-root-nothing-world-readable:
    exec: find {{ backup_dir }} -maxdepth 2 -type f -perm /o+r -printf '%m %p\n'
    timeout: 60000
    exit-status: 0
    stdout: ["!/./"]

  immich-dump-dir-closed:
    exec: stat -c %a {{ immich_backup_dir }}
    timeout: 60000
    exit-status: 0
    stdout: ["/^700$/"]

{% for name, svc in compose.services.items() %}
{%- set cname = svc.container_name | default(name) %}
{%- set caplist = (svc.cap_add | default([])) | sort %}
{%- set caps = ('CAP_' ~ caplist | join(' CAP_')) if caplist else '' %}
{%- set ro = 'true' if svc.read_only | default(false) else 'false' %}
{%- set optstr = (svc.security_opt | default([])) | join(' ') %}
{%- set nnp = 'false' if cname in ['collabora', 'netdata'] else 'true' %}
{%- set aa = optstr.split('apparmor=')[1].split(' ')[0] if 'apparmor=' in optstr else '' %}
{%- set usr = svc.user | default('') %}
  {{ cname }}-not-privileged:
    exec: docker inspect {{ cname }} | jq -r '.[0].HostConfig.Privileged'
    exit-status: 0
    stdout: ["/^false$/"]
  {{ cname }}-cap-drop-all:
    exec: docker inspect {{ cname }} | jq -r '[.[0].HostConfig.CapDrop[]?] | join(" ")'
    exit-status: 0
    stdout: ["/(^|\\s)ALL(\\s|$)/"]
  {{ cname }}-cap-add:
    exec: docker inspect {{ cname }} | jq -r '[.[0].HostConfig.CapAdd[]?] | sort | join(" ")'
    exit-status: 0
    stdout: ["/^{{ caps }}$/"]
  {{ cname }}-read-only-rootfs:
    exec: docker inspect {{ cname }} | jq -r '.[0].HostConfig.ReadonlyRootfs'
    exit-status: 0
    stdout: ["/^{{ ro }}$/"]
  {{ cname }}-no-new-privileges:
    exec: docker inspect {{ cname }} | jq -r '[.[0].HostConfig.SecurityOpt[]?] | join(" ") | test("(^| )no-new-privileges([:=]true)?( |$)")'
    exit-status: 0
    stdout: ["/^{{ nnp }}$/"]
{% if usr and '${DOCKER_GID}' in usr %}
  {{ cname }}-user:
    exec: |
      want="{{ usr | replace('${DOCKER_GID}', '$(getent group docker | cut -d: -f3)') }}"
      got=$(docker inspect {{ cname }} | jq -r '.[0].Config.User')
      [ "$got" = "$want" ] || { echo "{{ cname }} runs as $got, compose declares $want"; exit 1; }
    exit-status: 0
{% elif usr %}
  {{ cname }}-user:
    exec: docker inspect {{ cname }} | jq -r '.[0].Config.User'
    exit-status: 0
    stdout: ["/^{{ usr }}$/"]
{% endif %}
{%- set pinned = [] %}
{%- for p in svc.ports | default([]) %}
{%-   if (p | string).split(':') | length >= 3 %}{%- set _ = pinned.append((p | string).split(':')) %}{%- endif %}
{%- endfor %}
{% if pinned %}
  {{ cname }}-pinned-port-bindings:
    exec: |
{% for pp in pinned %}
      ips=$(docker inspect {{ cname }} \
              | jq -r '.[0].NetworkSettings.Ports // {} | to_entries[] | select(.value != null) | .value[] | select(.HostPort=="{{ pp[1] }}") | .HostIp' \
              | sort -u | tr '\n' ' ')
      [ "$ips" = "{{ pp[0] }} " ] || { echo "host port {{ pp[1] }} bound to [$ips], compose pins it to {{ pp[0] }}"; exit 1; }
{% endfor %}
    exit-status: 0
{% endif %}
{% if aa %}
  {{ cname }}-apparmor-enforced:
    exec: docker exec {{ cname }} cat /proc/1/attr/current
    exit-status: 0
    stdout: ["/^{{ aa }} \\(enforce\\)/"]
{% endif %}
{% endfor %}
{%- set declared = [] %}
{%- for name, svc in compose.services.items() %}
{%-   for p in svc.ports | default([]) %}
{%-     set parts = (p | string).split(':') %}
{%-     set _ = declared.append(parts[0] if parts | length < 3 else parts[1]) %}
{%-   endfor %}
{%- endfor %}

  only-socket-proxy-mounts-the-docker-socket:
    exec: |
      n=$(docker inspect $(docker ps -aq) \
            | jq -r '.[] | select([.Mounts[]?.Source] | index("/var/run/docker.sock")) | .Name' \
            | tr -d '/' | sort | tr '\n' ' ')
      [ "$n" = "socket-proxy " ] || { echo "docker.sock is mounted by: $n"; exit 1; }
    timeout: 60000
    exit-status: 0

  socket-proxy-refuses-file-reads:
    exec: |
      ping=$(docker exec netdata curl -s -o /dev/null -w '%{http_code}' http://socket-proxy:2375/_ping)
      [ "$ping" = 200 ] || { echo "control failed: /_ping through the proxy answered $ping, so no refusal below can be trusted"; exit 1; }
      for p in archive export; do
        c=$(docker exec netdata curl -s -o /dev/null -w '%{http_code}' "http://socket-proxy:2375/containers/socket-proxy/$p?path=/")
        [ "$c" = 403 ] || { echo "the socket proxy answers $c to /containers/{id}/$p: every container's files are readable through it"; exit 1; }
      done
    timeout: 60000
    exit-status: 0

  no-undeclared-published-ports:
    exec: |
      declared="{{ declared | unique | join(' ') }}"
      live=$(docker inspect $(docker ps -q) \
               | jq -r '.[] | .NetworkSettings.Ports // {} | to_entries[] | select(.value != null) | .value[] | .HostPort' \
               | sort -u)
      [ -n "$live" ] || { echo "no published host port was found at all — the derivation asserted nothing"; exit 2; }
      for p in $live; do
        case " $declared " in
          *" $p "*) ;;
          *) echo "a container publishes host port $p, which compose.yaml does not declare"; exit 1 ;;
        esac
      done
    timeout: 60000
    exit-status: 0

  netdata-runs-as-201:
    exec: docker exec netdata awk '/^Uid:/ {print $2}' /proc/1/status
    timeout: 60000
    exit-status: 0
    stdout: ["/^201$/"]
  netdata-apparmor-matches-dockerd:
    exec: |
      strings /usr/bin/dockerd | awk '
        { sub(/^[ \t]+/, ""); sub(/[ \t]*#.*$/, "") }
        /^deny / { if (FILENAME == "-") upstream[$0] = 1; else ours[$0] = 1 }
        END {
          missing = 0
          for (rule in upstream) if (!(rule in ours)) {
            printf "docker-default has a rule this profile lacks: %s\n", rule
            missing++
          }
          if (missing > 0) exit 1
          if (length(upstream) < 10) {
            print "parsed fewer than 10 deny rules out of dockerd — the binary "
            print "moved and this assertion is comparing against nothing"
            exit 1
          }
        }' /etc/apparmor.d/homelab-netdata -
    timeout: 180000
    exit-status: 0

  pihole-credential-files-not-world-readable:
    exec: |
      d={{ services_data_dir }}/pihole/etc
      n=0; bad=""
      for f in "$d/pihole.toml" "$d/pihole-FTL.db" "$d"/*.key "$d"/cli_pw; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        m=$(stat -c %a "$f")
        case "$m" in *[4567]) bad="$bad $m ${f##*/}" ;; esac
      done
      if [ "$n" -lt 2 ]; then
        echo "only $n credential file(s) found under $d — the set stopped being derivable"
        exit 1
      fi
      [ -z "$bad" ] || { echo "world-readable:$bad"; exit 1; }
    timeout: 60000
    exit-status: 0

  pihole-store-not-traversable-by-others:
    exec: stat -c %a {{ services_data_dir }}/pihole
    timeout: 60000
    exit-status: 0
    stdout: ["/^750$/"]

{% set _fw_ports = [] %}
{%- for _r in ufw_service_rules | default([]) %}
{%- set _pp = _r.port ~ '/' ~ (_r.proto | default('tcp')) %}
{%- if _pp not in _fw_ports %}{% set _ = _fw_ports.append(_pp) %}{% endif %}
{%- endfor %}
  sysctl-declared-values-are-the-effective-ones:
    exec: |
      decl=/etc/sysctl.d/99-homelab.conf
      [ -r "$decl" ] || { echo "$decl unreadable — the comparison has no source"; exit 1; }
      n=0
      bad=""
      while IFS= read -r line; do
        case "$line" in ''|\#*|\;*) continue ;; esac
        case "$line" in *=*) : ;; *) continue ;; esac
        k=$(printf '%s' "${line%%=*}" | tr -d ' \t')
        v=$(printf '%s' "${line#*=}" | tr -s ' \t' ' ' | sed 's/^ //;s/ $//')
        eff=$(sysctl -n "$k" 2>/dev/null | tr -s ' \t' ' ' | sed 's/^ //;s/ $//')
        n=$((n+1))
        [ "$eff" = "$v" ] || bad="$bad ${k}(declared=${v},effective=${eff:-unset})"
      done < "$decl"
      declared=$(grep -cE '^[a-z].*=' "$decl")
      [ "$n" -ge 1 ] || { echo "no key parsed out of $decl"; exit 1; }
      [ "$n" -eq "$declared" ] || {
        echo "compared $n key(s) against $declared declaration(s) in $decl — the parse is losing lines"
        exit 1
      }
      [ -z "$bad" ] || { echo "declared in $decl, not what the kernel holds:$bad"; exit 1; }
    timeout: 60000
    exit-status: 0

  ufw-enforces-every-rule-the-inventory-declares:
    exec: |
      status=$(ufw status verbose 2>/dev/null)
      printf '%s\n' "$status" | grep -qE '^Status: active$' || { echo "ufw is not active"; exit 1; }
      printf '%s\n' "$status" | grep -qE '^Default: deny \(incoming\)' ||
        { echo "ufw default incoming policy is not deny: $(printf '%s\n' "$status" | grep -E '^Default:')"; exit 1; }
      n=0
      bad=""
      for pp in {{ _fw_ports | join(' ') }}; do
        n=$((n+1))
        printf '%s\n' "$status" | grep -qE "^${pp} +ALLOW" || bad="$bad $pp"
      done
      for src in {{ ssh_allowed_sources | join(' ') }}; do
        n=$((n+1))
        printf '%s\n' "$status" | grep -qE "^{{ ssh_port_hardened }}/tcp +ALLOW( IN)? +${src}" ||
          bad="$bad ssh-from-${src}"
      done
      [ "$n" -ge 1 ] || { echo "the inventory declares no rule — the derivation returned nothing"; exit 1; }
      [ -z "$bad" ] || { echo "declared in the inventory, absent from ufw:$bad"; exit 1; }
    timeout: 60000
    exit-status: 0

  sshd-applies-the-directives-the-managed-file-sets:
    exec: |
      n=0
      bad=""
      while read -r k v; do
        case "$k" in ''|\#*) continue ;; esac
        case "$v" in -*) continue ;; esac
        lk=$(printf '%s' "$k" | tr 'A-Z' 'a-z')
        case "$lk" in include|match|hostkey|subsystem|acceptenv|authorizedkeysfile|hostkeyalgorithms) continue ;; esac
        eff=$(sshd -T 2>/dev/null | awk -v k="$lk" '$1==k {sub(/^[^ ]* /,""); print; exit}')
        n=$((n+1))
        a=$(printf '%s' "$eff" | tr 'A-Z' 'a-z')
        b=$(printf '%s' "$v" | tr 'A-Z' 'a-z')
        [ "$a" = "$b" ] || bad="$bad ${k}(file=${v},effective=${eff:-unset})"
      done < /etc/ssh/sshd_config
      [ "$n" -ge 1 ] || { echo "no directive parsed out of sshd_config"; exit 1; }
      [ -z "$bad" ] || { echo "sshd_config sets one value and sshd applies another:$bad"; exit 1; }
    timeout: 60000
    exit-status: 0

  fail2ban-jails-all-loaded:
    exec: |
      want=$(grep -oE '^\[[a-z0-9_-]+\]' /etc/fail2ban/jail.local | tr -d '[]' | grep -v '^DEFAULT$' | sort | tr '\n' ' ')
      have=$(fail2ban-client status | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' '\n' | grep -v '^$' | sort | tr '\n' ' ')
      [ -n "$want" ] || { echo "no jail parsed from /etc/fail2ban/jail.local — absent or unreadable"; exit 1; }
      [ -n "$have" ] || { echo "fail2ban-client returned no jail list — the server is not answering"; exit 1; }
      test "$want" = "$have"
    timeout: 60000
    exit-status: 0

  traefik-access-log-carries-no-credential:
    exec: |
      up=$(docker inspect traefik-log-redactor 2>/dev/null | jq -r '.[0].State.Running')
      if [ "$up" != "true" ]; then
        echo "traefik-log-redactor is not running — no access line reaches any log"
        exit 1
      fi
      pat='[?&]([Aa]ccess_?[Tt]oken|[Aa]pi_?[Kk]ey|token|auth|secret|password|sig|signature|t|p)='
      pat_path='/api/push/'
      window=48h
      set -- $( { docker logs --since "$window" traefik 2>&1
                  docker logs --since "$window" traefik-log-redactor 2>&1
                } | awk -v pat="$pat" -v pat_path="$pat_path" '
        /GET|POST|HEAD|PUT|DELETE/ { http++ }
        { line = $0
          while (match(line, pat "[^ \"&]*")) {
            v = substr(line, RSTART, RLENGTH)
            if (v !~ /=\*\*\*$/) bad++
            line = substr(line, RSTART + RLENGTH)
          }
          if (index($0, pat_path)) {
            line = $0
            while (match(line, pat_path "[^ ?\"]*")) {
              v = substr(line, RSTART, RLENGTH)
              if (v !~ /\*\*\*$/) bad++
              line = substr(line, RSTART + RLENGTH)
            }
          } }
        END { print (http+0), (bad+0) }')
      seen=$1
      bad=$2
      if [ "${seen:-0}" -lt 1 ]; then
        echo "the redactor is running but produced no HTTP line in $window —"
        echo "this assertion would otherwise pass over an empty set"
        exit 1
      fi
      if [ "${bad:-0}" -gt 0 ]; then
        echo "$bad credential value(s) reached a durable container log"
        exit 1
      fi
    timeout: 300000
    exit-status: 0

  traefik-raw-access-log-stays-in-ram-and-root-only:
    exec: |
      case "$(findmnt -no FSTYPE --target /run/traefik 2>/dev/null)" in
        tmpfs) ;;
        *) echo "/run/traefik is not on a tmpfs — the raw access log reaches disk"; exit 1 ;;
      esac
      m=$(stat -c '%a %U:%G' /run/traefik 2>/dev/null)
      if [ "$m" != "750 root:root" ]; then
        echo "/run/traefik is '$m', expected '750 root:root'"
        exit 1
      fi
    timeout: 60000
    exit-status: 0

  nextcloud-redis-refuses-an-unauthenticated-caller:
    exec: |
      ip=$(docker inspect nextcloud-redis 2>/dev/null |
           jq -r '.[0].NetworkSettings.Networks[].IPAddress' 2>/dev/null | head -1)
      case "$ip" in
        ''|*[!0-9.]*) echo "cannot read nextcloud-redis's address — nothing was tested"; exit 1 ;;
      esac
      reply=$(timeout 5 bash -c "exec 3<>/dev/tcp/$ip/6379 && printf 'PING\r\nQUIT\r\n' >&3 && cat <&3" 2>/dev/null)
      case "$reply" in
        *NOAUTH*)
          exit 0 ;;
        *PONG*)
          echo "$ip:6379 answered PONG to an unauthenticated ping from the host — requirepass is NOT in force, and every live Nextcloud session is readable by any local account"
          exit 1 ;;
        '')
          echo "no reply at all from $ip:6379 — the probe proved nothing, which is not the same as a refusal"
          exit 1 ;;
        *)
          echo "unexpected reply from $ip:6379: $reply"
          exit 1 ;;
      esac
    timeout: 90000
    exit-status: 0

  wireguard-peers-are-the-enrolled-clients:
    exec: |
      live=$(docker exec wg-easy wg show wg0 peers 2>/dev/null | sort)
      [ -n "$live" ] || { echo "wg-easy's wg0 reports no peers at all"; exit 1; }
      enrolled=$(sqlite3 -readonly \
        "file:{{ services_data_dir }}/wireguard/wg-easy.db?mode=ro" \
        'select public_key from clients_table where enabled=1;' 2>/dev/null | sort)
      [ -n "$enrolled" ] || { echo "no enabled client in wg-easy.db — wrong store?"; exit 1; }
      [ "$live" = "$enrolled" ] || {
        echo "live peers and enabled clients differ ($(echo "$live" | wc -l) live," \
             "$(echo "$enrolled" | wc -l) enabled) — key fingerprints only:"
        printf '%s\n' "$live" "$enrolled" | sort | uniq -u | cut -c1-12 | sed 's/^/  /'
        exit 1
      }
    timeout: 90000
    exit-status: 0

  sysctl-declared-knobs-reach-every-interface:
    exec: |
      decl=/etc/sysctl.d/99-homelab.conf
      [ -r "$decl" ] || { echo "$decl unreadable — the derivation has no source"; exit 1; }
      knobs=$(sed -n 's/^net\.ipv6\.conf\.all\.\([a-z_]*\) *=.*/\1/p' "$decl" | sort -u)
      [ -n "$knobs" ] || { echo "derived ZERO ipv6 knobs from $decl — the sed no longer matches"; exit 1; }
      declared=$(grep -c '^net\.ipv6\.conf\.all\.' "$decl")
      found=$(printf '%s\n' $knobs | wc -l)
      [ "$found" -eq "$declared" ] || {
        echo "derived $found ipv6 knob(s) from $declared declaration(s) in $decl"
        echo "the sed is losing lines — the sweep would be narrower than the file"
        exit 1
      }
      bad=0; seen=0
      for k in $knobs; do
        want=$(sysctl -n "net.ipv6.conf.all.$k" 2>/dev/null) || continue
        for line in $(grep -H . /proc/sys/net/ipv6/conf/*/"$k" 2>/dev/null); do
          path=${line%%:*}
          have=${line##*:}
          iface=${path#/proc/sys/net/ipv6/conf/}
          iface=${iface%/$k}
          case "$iface" in all|default|lo) continue ;; esac
          seen=$((seen + 1))
          [ "$have" = "-1" ] && continue
          if [ "$have" != "$want" ]; then
            echo "net.ipv6.conf.$iface.$k=$have but the declaration says $want"
            bad=$((bad + 1))
          fi
        done
      done
      [ "$seen" -gt 0 ] || { echo "swept ZERO interface/knob pairs — vacuous"; exit 1; }
      [ "$bad" -eq 0 ] || { echo "$bad declared knob(s) never reached the interface they name"; exit 1; }
    timeout: 60000
    exit-status: 0

  claude-state-is-on-the-encrypted-volume:
    exec: |
      data=$(stat -c %d /mnt/data)
      bad=""
      [ "$(stat -c %d /home/claude/.claude 2>/dev/null)" = "$data" ] || bad="$bad /home/claude/.claude"
      cache=$(ps -C rclone -o args= | sed -n 's/.*--cache-dir[ =]\([^ ]*\).*/\1/p' | head -1)
      [ -n "$cache" ] && [ "$(stat -c %d "$cache" 2>/dev/null)" = "$data" ] || bad="$bad rclone-cache(${cache:-default})"
      [ ! -e /home/claude/.cache/rclone ] || bad="$bad /home/claude/.cache/rclone"
      [ -z "$bad" ] || { echo "on the SD card, not the encrypted volume:$bad"; exit 1; }
    exit-status: 0
    timeout: 10000
