# {{ ansible_managed }}
[Unit]
Description=Weekly lynis security audit

[Timer]
# Weekly (not monthly): Uptime Kuma caps the push heartbeat interval at 24 days,
# so a monthly cadence would flag DOWN between runs. Weekly fits comfortably
# (Kuma interval ~8 days) and gives a finer dead-man's signal.
OnCalendar=weekly
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
