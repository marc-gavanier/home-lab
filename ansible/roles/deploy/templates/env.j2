# {{ ansible_managed }}
# =============================================================================
# Home Lab — Environment Variables
# =============================================================================
# Note: $ characters are escaped as $$ for Docker Compose compatibility
{% set esc = {'fn': '$'} %}

# --- General ---
TZ=Europe/Paris
DOMAIN={{ domain }}
PI_LAN_IP={{ homelab_ip }}

# --- Storage paths ---
SERVICES_DATA_DIR={{ services_data_dir }}
MEDIA_DIR={{ media_dir }}

# --- Traefik ---
TRAEFIK_ACME_EMAIL={{ traefik_acme_email }}
# Cloudflare API token (scoped Zone:DNS:Edit + Zone:Read) for the ACME DNS-01
# challenge — lets Traefik prove domain control via DNS TXT records instead of
# inbound HTTP-01, so services need no public A record / open :80 (ADR-014).
CF_DNS_API_TOKEN={{ cloudflare_dns_api_token | replace('$', '$$') }}

# --- Pi-hole ---
PIHOLE_PASSWORD={{ pihole_password | replace('$', '$$') }}

# --- WireGuard ---
WG_HOST=vpn.{{ domain }}
WG_PASSWORD_HASH={{ wg_password_hash | replace('$', '$$') }}

# Service passwords are deliberately absent below: they are written as
# individual files under /mnt/data/secrets/docker/ and injected as Docker
# secrets, so they appear neither here nor in `docker inspect` (ADR-016).
# Only non-secret identifiers remain.

# --- Nextcloud ---
NEXTCLOUD_DB_NAME={{ nextcloud_db_name | default('nextcloud') }}
NEXTCLOUD_DB_USER={{ nextcloud_db_user | default('nextcloud') }}

# --- Vaultwarden ---
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- Immich ---
IMMICH_DB_USER={{ immich_db_user | default('immich') }}
IMMICH_DB_NAME={{ immich_db_name | default('immich') }}

# --- Transmission ---
PUID={{ getent_passwd[ansible_user][1] }}
PGID={{ getent_passwd[ansible_user][2] }}
TRANSMISSION_USER={{ transmission_user | default('admin') }}
