# {{ ansible_managed }}
# =============================================================================
# Traefik — Static configuration
# =============================================================================

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      middlewares:
        # Applied to EVERY HTTPS router (routers can still add their own):
        - vpn-only@file        # VPN/LAN access only (403 to the internet)
        - secure-headers@file  # HSTS, SAMEORIGIN, nosniff, referrer-policy
        - rate-limit@file      # 100 req/s per source IP (DoS/brute-force cap)
      tls:
        certResolver: letsencrypt
  ping:
    address: ":8082"      # internal only (not published) — for the container healthcheck

# Health endpoint used by the container healthcheck (`traefik healthcheck`).
# Bound to the internal ping entryPoint above — no TLS, no vpn-only middleware.
ping:
  entryPoint: ping

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: /acme/acme.json
      # DNS-01 via Cloudflare (token read from /run/secrets by lego, through
      # CF_DNS_API_TOKEN_FILE — ADR-016): proves domain control by writing
      # _acme-challenge TXT records, so certs need no public A record or
      # inbound :80 — services can stay out of public DNS.
      # Each router keeps its own certresolver → per-host certs, deliberately NOT
      # a *.{{ domain }} wildcard (one key valid for subdomains served elsewhere,
      # e.g. a static site on GitHub Pages). See ADR-014.
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"

providers:
  docker:
    # Reached through the read-only docker-socket-proxy (compose service), never
    # the raw socket — Traefik holds no direct Docker API access.
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: WARN

# No `filters.statusCodes` here, deliberately (#259). It used to keep only
# 400-599, which made this a log of REFUSALS rather than a log of requests —
# and #128 then drew a census of "who reaches Traefik" from it and concluded
# that the offsite Pi never did. It did; it simply never failed. Removing the
# entry it was granted on the strength of that census took offsite's only
# reporting channel away for a week. An instrument that cannot observe a
# success must not be asked who is present.
#
# And not /dev/stdout either, deliberately (#287, ADR-034). Removing the filter
# above is what made this visible: with 400-599 gone the log keeps successful
# requests too, and some clients can only present their credential in the query
# string — SignalR cannot set an Authorization header, a media player following
# a stream URL has nowhere else to put it. stdout is what `docker logs` keeps
# and what Dozzle serves to every account authorised for it, so the raw line
# must not go there.
#
# Traefik cannot mask part of a field. Measured on 3.7.11, both formats:
# `fields.names.RequestPath: redact` is a NO-OP — the value passes through
# verbatim — and `drop` blanks the whole path for every line, which would leave
# vaultwarden, whose own log carries no request line at all, with no HTTP
# visibility anywhere. So the line is written to a tmpfs here and
# traefik-log-redactor is what turns it into the durable, masked container log.
accessLog:
  filePath: /var/log/traefik/access.log
