# {{ ansible_managed }}
# SearXNG — private metasearch
# Single-user, VPN-only instance: no Redis/Valkey (limiter disabled).
use_default_settings: true

server:
  secret_key: "{{ searxng_secret_key }}"
  base_url: "https://search.{{ domain }}/"
  limiter: false
  image_proxy: true

search:
  safe_search: 0
  autocomplete: "duckduckgo"

ui:
  default_locale: "fr"
  # Force the dark style so theme-dependent assets (e.g. select arrows) match the
  # Gerbier dark branding applied via docker/branding/searxng.
  theme_args:
    simple_style: dark
