# {{ ansible_managed }}
# wg-easy 15 admin settings — read by the HOST, never by the container.
#
# v15 keeps its configuration in SQLite and accepts none of it from the
# environment, so these values reach it through its API: once at migration
# time (roles/deploy/tasks/wg_easy_migrate.yml) and then on every deploy
# (roles/deploy/tasks/wg_easy_config.yml), which is what keeps this repository
# — and not the web UI — the source of truth. See ADR-020.
#
# PLAINTEXT password on purpose: v15 hashes with argon2 on its side and no
# longer takes a precomputed hash the way v14 did. Hence 0600 root:root on the
# encrypted volume, and not homelab.env (group docker, mounted into containers).

WG_ADMIN_USERNAME=admin
WG_ADMIN_PASSWORD={{ wg_password }}

# Endpoint advertised in generated client configs.
WG_HOST=vpn.{{ domain }}
WG_PORT=51820

# Pi-hole, so VPN clients keep ad-blocking and split DNS. The migration import
# does NOT carry this over: it leaves Cloudflare's 1.1.1.1 behind, which would
# silently take every newly generated client off Pi-hole.
WG_DNS={{ homelab_ip }}

# IPv4 only: this host has no global IPv6 (see DISABLE_IPV6 in compose.yaml).
WG_ALLOWED_IPS=0.0.0.0/0
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=0
