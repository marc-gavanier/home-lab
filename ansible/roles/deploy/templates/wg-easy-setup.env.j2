# {{ ansible_managed }}
# wg-easy 15 admin settings — read by the HOST, never by the container.
#
# v15 keeps its configuration in SQLite and accepts none of it from the
# environment, so these values reach it through its API on every deploy
# (roles/deploy/tasks/wg_easy_config.yml), which is what keeps this repository
# — and not the web UI — the source of truth. They first reached it at
# migration time; that one-shot code was removed once 15 was established, and
# ADR-020 remains the record of how the migration was done.
#
# PLAINTEXT password on purpose: v15 hashes with argon2 on its side and no
# longer takes a precomputed hash the way v14 did. Hence 0600 root:root on the
# encrypted volume, and not homelab.env (group docker, mounted into containers).

# Single-quoted, like every secret in this role's three sibling templates
# (backup.env.j2, ddns.env.j2, killswitch.env.j2). This one was the exception and
# it is the file that carries a password in cleartext by design, which makes it
# the worst place to be the exception. The consumer is
# homelab-wg-easy-config.sh.j2, which does `. "$SETUP_ENV"` — a shell source, so
# an unquoted value containing `$`, a space, a quote or a backslash is expanded
# or split, and wg-easy is then configured with a password nobody typed while the
# deploy reports success. It works today only because the generator happens to
# produce none of those characters, which is a property written down nowhere.
WG_ADMIN_USERNAME=admin
WG_ADMIN_PASSWORD='{{ wg_password }}'

# Endpoint advertised in generated client configs.
WG_HOST=vpn.{{ domain }}
WG_PORT=51820

# Pi-hole, so VPN clients keep ad-blocking and split DNS. The migration import
# does NOT carry this over: it leaves Cloudflare's 1.1.1.1 behind, which would
# silently take every newly generated client off Pi-hole.
WG_DNS={{ homelab_ip }}

# IPv4 only: this host has no global IPv6 (see DISABLE_IPV6 in compose.yaml).
WG_ALLOWED_IPS=0.0.0.0/0
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=0
