#!/bin/bash
# {{ ansible_managed }}
#
# One-shot migration of wg-easy 14 -> 15 (issue #48, ADR-020).
#
# v15 is a rewrite: the configuration moves from wg0.json to SQLite, and the
# only supported import path is an HTTP call that must run BEFORE the setup is
# marked complete. There is no `compose up` that performs it, so without this
# script the new image would start on a v14 data directory, find no database,
# reopen its setup wizard, and bring up NO tunnel at all — taking the VPN and
# the offsite backup link with it, while the container stays green.
#
# Shape, and the reason for it: everything that can fail is done on a COPY of
# the data directory, in a throwaway container that publishes nothing. The live
# service keeps running throughout. Production is touched only once the staged
# database has been verified to carry the same server key and the same peers.
# Downtime is then the container swap, seconds, not the migration.
#
# Safe to re-run: it does nothing once wg-easy.db exists, and refuses to retry
# after a failed attempt (marker file) so a broken migration cannot loop into a
# repeated VPN outage on every deploy.

set -euo pipefail

DATA_DIR="{{ services_data_dir }}/wireguard"
STAGING="/mnt/data/tmp/wg-easy-v15-staging"
BACKUP_ROOT="/mnt/data/backups/wg-easy-v14"
SETUP_ENV="/mnt/data/secrets/wg-easy-setup.env"
COMPOSE_DIR="/opt/homelab"
FAILED_MARKER="$DATA_DIR/.v15-migration-failed"

IMAGE_NEW="ghcr.io/wg-easy/wg-easy:15.3.0"
IMAGE_OLD="ghcr.io/wg-easy/wg-easy:14"

STAGING_NAME="wg-easy-v15-staging"
STAGING_PORT="51931"          # loopback only, and only while staging runs
OFFSITE_IP="{{ hostvars['offsite'].offsite_wg_ip | default('10.8.0.4') }}"
PROBE_TIMEOUT=150             # seconds to wait for the offsite link to return

log() { echo "[wg-easy-migrate] $*"; }
die() { echo "[wg-easy-migrate] ERROR: $*" >&2; exit 1; }

# --- Guards ---------------------------------------------------------------

# Before anything else: an unmounted /mnt/data makes wg0.json look absent, and
# the "fresh install" branch below would then wave the migration through and let
# v15 start on an empty directory — the exact outage this script exists to
# prevent. Refuse to guess.
mountpoint -q /mnt/data || die "/mnt/data is not mounted (homelab-unlock first)"

[ -f "$FAILED_MARKER" ] && die "a previous migration failed and rolled back.
    Investigate, then remove $FAILED_MARKER to allow another attempt."

if [ -f "$DATA_DIR/wg-easy.db" ]; then
    log "already migrated (wg-easy.db present) — nothing to do"
    exit 0
fi

if [ ! -f "$DATA_DIR/wg0.json" ]; then
    log "no wg0.json: fresh install, v15 will run its own setup — nothing to do"
    exit 0
fi

[ -r "$SETUP_ENV" ] || die "$SETUP_ENV missing or unreadable"
# `set -a` on purpose: the python helpers below read these through os.environ,
# and a plain `.` would only make them shell variables.
set -a
# shellcheck disable=SC1090
. "$SETUP_ENV"
set +a

for v in WG_ADMIN_USERNAME WG_ADMIN_PASSWORD WG_HOST WG_PORT WG_DNS WG_ALLOWED_IPS; do
    [ -n "${!v:-}" ] || die "$v is empty in $SETUP_ENV"
done

cleanup_staging() {
    docker rm -f "$STAGING_NAME" >/dev/null 2>&1 || true
    rm -rf "$STAGING"
}
trap cleanup_staging EXIT

# --- 1. Pull first, before anything is dismantled -------------------------
# Pinning a tag the registry does not publish is how the DoH switch took DNS
# down on 2026-07-27: `up` failed after the working container was gone.

log "pulling $IMAGE_NEW"
docker pull "$IMAGE_NEW" || die "cannot pull $IMAGE_NEW — nothing was touched"

# --- 2. Back up the v14 state (this is the rollback) ----------------------

TS="$(date +%Y%m%d-%H%M%S)"
BACKUP="$BACKUP_ROOT/$TS"
mkdir -p "$BACKUP"
cp -a "$DATA_DIR/wg0.json" "$BACKUP/wg0.json"
# `if`, not `[ -f x ] && cp`: under `set -e` a false test is a failing command
# and would abort the script here, before anything had gone wrong.
if [ -f "$DATA_DIR/wg0.conf" ]; then cp -a "$DATA_DIR/wg0.conf" "$BACKUP/wg0.conf"; fi
chmod 700 "$BACKUP"
log "v14 state backed up to $BACKUP"

EXPECTED_PEERS="$(python3 -c "import json;print(len(json.load(open('$DATA_DIR/wg0.json'))['clients']))")"
log "$EXPECTED_PEERS peers to carry over"

# --- 3. Stage: migrate a COPY, live service untouched ---------------------

rm -rf "$STAGING"
mkdir -p "$STAGING/data"
cp -a "$DATA_DIR/wg0.json" "$STAGING/wg0.json"
chmod 700 "$STAGING"

log "starting staging container (publishes nothing but 127.0.0.1:$STAGING_PORT)"
docker run -d --name "$STAGING_NAME" --no-healthcheck \
    --cap-drop ALL --cap-add NET_ADMIN --cap-add NET_RAW \
    --security-opt no-new-privileges:true --read-only \
    --tmpfs /run:size=8m --tmpfs /tmp:size=8m \
    -e INSECURE=true -e DISABLE_IPV6=true \
    -p "127.0.0.1:$STAGING_PORT:51821" \
    -v "$STAGING/data:/etc/wireguard" \
    "$IMAGE_NEW" >/dev/null || die "staging container would not start"

API="http://127.0.0.1:$STAGING_PORT"

# Readiness is "the HTTP server answers at all", not "answers 200": before setup
# the root redirects and the setup routes reject invalid steps with 400. Any
# status code other than curl's 000 (no connection) means it is listening.
api_reachable() {
    [ "$(curl -s -o /dev/null -w '%{http_code}' "$API/" || true)" != "000" ]
}

ready=no
for _ in $(seq 1 30); do
    sleep 2
    if api_reachable; then ready=yes; break; fi
done
[ "$ready" = yes ] || die "staging API never answered on $API"

log "creating the admin user"
curl -sf -X POST "$API/api/setup/2" -H 'Content-Type: application/json' \
    --data-binary @<(python3 -c "
import json,os
print(json.dumps({'username': os.environ['WG_ADMIN_USERNAME'],
                  'password': os.environ['WG_ADMIN_PASSWORD'],
                  'confirmPassword': os.environ['WG_ADMIN_PASSWORD']}))") \
    >/dev/null || die "setup step 2 failed"

log "importing wg0.json"
python3 - "$STAGING/wg0.json" "$API" <<'PY' || die "the import call failed"
import json, sys, urllib.request
path, api = sys.argv[1], sys.argv[2]
body = json.dumps({"file": open(path).read()}).encode()
req = urllib.request.Request(api + "/api/setup/migrate", data=body,
                             headers={"Content-Type": "application/json"},
                             method="POST")
r = urllib.request.urlopen(req, timeout=60)
assert r.status == 200, r.status
PY

# --- 4. Verify the staged database BEFORE touching production -------------
# The one thing that must not go wrong: the offsite Pi sits behind a NAT we do
# not control and initiates the handshake, so a changed server key would make
# it unreachable with no remote repair. Assert the key and the peers survived.

log "verifying the staged database against wg0.json"
python3 - "$STAGING/wg0.json" "$STAGING/data/wg-easy.db" "$EXPECTED_PEERS" <<'PY' \
    || die "staged database does not match wg0.json — production NOT touched"
import json, sqlite3, sys
old = json.load(open(sys.argv[1]))
db = sqlite3.connect(sys.argv[2]); db.row_factory = sqlite3.Row
iface = db.execute("select * from interfaces_table").fetchone()
assert iface, "no interface row"
assert iface["public_key"] == old["server"]["publicKey"], "server public key changed"
assert iface["private_key"] == old["server"]["privateKey"], "server private key changed"
got = sorted((r["public_key"], r["ipv4_address"]) for r in
             db.execute("select * from clients_table"))
exp = sorted((c["publicKey"], c["address"]) for c in old["clients"].values())
assert got == exp, "peer set differs"
assert len(got) == int(sys.argv[3]), "peer count differs"
print("server key preserved, %d peers preserved" % len(got))
PY

# --- 5. Restore the settings the import does not carry --------------------
# migrate() leaves `host` empty and DNS on Cloudflare's 1.1.1.1. Left alone,
# every newly generated client config would silently leave Pi-hole.

log "restoring host, Pi-hole DNS and allowed IPs"
COOKIE="$(mktemp)"; trap 'rm -f "$COOKIE"; cleanup_staging' EXIT
curl -sf -c "$COOKIE" -X POST "$API/api/session" -H 'Content-Type: application/json' \
    --data-binary @<(python3 -c "
import json,os
print(json.dumps({'username': os.environ['WG_ADMIN_USERNAME'],
                  'password': os.environ['WG_ADMIN_PASSWORD'],
                  'remember': False}))") \
    >/dev/null || die "cannot authenticate against the staging API"

curl -sf -b "$COOKIE" -X POST "$API/api/admin/userconfig" \
    -H 'Content-Type: application/json' \
    --data-binary @<(python3 -c "
import json,os
print(json.dumps({
  'host': os.environ['WG_HOST'], 'port': int(os.environ['WG_PORT']),
  'defaultMtu': int(os.environ.get('WG_MTU','1420')),
  'defaultPersistentKeepalive': int(os.environ.get('WG_PERSISTENT_KEEPALIVE','0')),
  'defaultDns': [x.strip() for x in os.environ['WG_DNS'].split(',')],
  'defaultAllowedIps': [x.strip() for x in os.environ['WG_ALLOWED_IPS'].split(',')],
  'defaultJC': 7, 'defaultJMin': 10, 'defaultJMax': 1000,
  'defaultI1': '', 'defaultI2': '', 'defaultI3': '', 'defaultI4': '', 'defaultI5': ''}))") \
    >/dev/null || die "cannot write the user config on the staging instance"

docker rm -f "$STAGING_NAME" >/dev/null 2>&1 || true

# --- 6. The swap ----------------------------------------------------------
# From here the tunnel is down until step 7 succeeds.

rollback() {
    log "ROLLING BACK to $IMAGE_OLD"
    rm -f "$DATA_DIR/wg-easy.db"
    cp -a "$BACKUP/wg0.json" "$DATA_DIR/wg0.json"
    if [ -f "$BACKUP/wg0.conf" ]; then cp -a "$BACKUP/wg0.conf" "$DATA_DIR/wg0.conf"; fi
    cat > "$COMPOSE_DIR/compose.wg-easy-rollback.yml" <<EOF
services:
  wg-easy:
    image: $IMAGE_OLD
EOF
    (cd "$COMPOSE_DIR" && docker compose \
        -f compose.yaml -f compose.wg-easy-rollback.yml up -d wg-easy) || true
    touch "$FAILED_MARKER"
    log "rolled back. $FAILED_MARKER blocks further attempts until you remove it."
}

# `rm -sf`, not `stop`: the crash-heal timer resurrects containers it finds
# EXITED, and it fires every two minutes. A stopped wg-easy could therefore be
# brought back up mid-swap — on v15, against a directory whose database is only
# half in place. A removed container is invisible to it, which is the same
# reason maintenance uses `compose down <svc>` rather than `stop`.
log "removing the v14 container and swapping in the migrated database"
(cd "$COMPOSE_DIR" && docker compose rm -sf wg-easy) || die "could not remove wg-easy"
cp -a "$STAGING/data/wg-easy.db" "$DATA_DIR/wg-easy.db"
if [ -f "$STAGING/data/wg0.conf" ]; then cp -a "$STAGING/data/wg0.conf" "$DATA_DIR/wg0.conf"; fi

if ! (cd "$COMPOSE_DIR" && docker compose up -d wg-easy); then
    rollback; die "v15 would not start"
fi

# The import assigns IPv6 addresses even with DISABLE_IPV6=true, because it runs
# after startup while the cleanup runs AT startup. One restart clears them, so
# the probe below reads the steady state and not a transient one.
log "restarting once so the IPv6 cleanup runs over the imported rows"
(cd "$COMPOSE_DIR" && docker compose restart wg-easy) || { rollback; die "restart failed"; }

# --- 7. Probe the function, offsite first ---------------------------------
# Not container status: the whole point of this migration is that v15 can be
# green with no tunnel at all. The offsite Pi is the probe that matters, and it
# exercises the full path — host wg0 -> wg-easy -> offsite.

log "probing (offsite first), up to ${PROBE_TIMEOUT}s"
ok=no
for _ in $(seq 1 $((PROBE_TIMEOUT / 5))); do
    sleep 5
    # `|| true`, never `|| echo 0`: grep -c already PRINTS 0 when it matches
    # nothing and then exits 1, so the fallback would append a second line and
    # the integer test below would blow up instead of simply retrying.
    peers="$(docker exec wg-easy wg show wg0 2>/dev/null | grep -c '^peer' || true)"
    peers="${peers:-0}"
    [ "$peers" -eq "$EXPECTED_PEERS" ] || continue
    ping -c 2 -W 3 "$OFFSITE_IP" >/dev/null 2>&1 || continue
    ok=yes; break
done

if [ "$ok" != yes ]; then
    log "probe FAILED: peers=${peers:-?}/$EXPECTED_PEERS, offsite $OFFSITE_IP unreachable"
    rollback
    die "migration rolled back — the VPN is back on v14"
fi

log "OK: $EXPECTED_PEERS peers configured and the offsite Pi answers through the tunnel"
rm -f "$COMPOSE_DIR/compose.wg-easy-rollback.yml"
log "migration complete. v14 state kept in $BACKUP"
