# {{ ansible_managed }}
# Cloudflare DDNS configuration (systemd EnvironmentFile — no $$ escaping)
CF_DNS_API_TOKEN='{{ cloudflare_dns_api_token }}'
CF_ZONE='{{ domain }}'
CF_RECORD='vpn.{{ domain }}'

# Optional Uptime Kuma push monitor (dead-man's switch). Empty = disabled.
# No monitor is provisioned for DDNS by default; set this to enable one later.
KUMA_DDNS_PUSH_URL='{{ ddns_kuma_push_url | default("") }}'
