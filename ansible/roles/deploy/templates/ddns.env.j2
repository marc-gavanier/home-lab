# {{ ansible_managed }}
# Cloudflare DDNS configuration (systemd EnvironmentFile — no $$ escaping)
CF_DNS_API_TOKEN='{{ cloudflare_dns_api_token }}'
CF_ZONE='{{ domain }}'
CF_RECORD='vpn.{{ domain }}'

# Uptime Kuma push monitor (dead-man's switch). Empty = disabled.
# The "DDNS" monitor exists since 2026-08-12 (issue #79); this repository's own
# host sets the URL in the vault. It stays optional because a fresh install has
# no Kuma to push to yet, and the script no-ops on an empty value.
# Paste the URL Kuma shows, query string included — the script strips everything
# from the first '?' before adding its own status and msg, and without that the
# duplicated parameters would register every push as DOWN.
KUMA_DDNS_PUSH_URL='{{ ddns_kuma_push_url | default("") }}'
