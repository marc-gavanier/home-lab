# {{ ansible_managed }}
# Restic backup configuration
RESTIC_REPOSITORY='{{ backup_dir }}/restic-repo'
RESTIC_PASSWORD='{{ restic_password }}'

# Database credentials for dumps.
# Immich is NOT dumped here — it uses its own scheduled DB backup (writes into
# the restic set at services/immich/upload/backups). Vaultwarden and Forgejo
# need no credentials either: both are SQLite files copied host-side.
NEXTCLOUD_DB_USER='{{ nextcloud_db_user | default("nextcloud") }}'
NEXTCLOUD_DB_PASSWORD='{{ nextcloud_db_password }}'
NEXTCLOUD_DB_NAME='{{ nextcloud_db_name | default("nextcloud") }}'

# Miniflux, dumped with pg_dump through `docker exec`. No password: the socket
# inside the container is trusted, so only the role and database names travel.
MINIFLUX_DB_USER='{{ miniflux_db_user | default("miniflux") }}'
MINIFLUX_DB_NAME='{{ miniflux_db_name | default("miniflux") }}'

# Uptime Kuma push monitor (backup dead-man's switch). Empty = monitoring disabled.
KUMA_PUSH_URL='{{ backup_kuma_push_url | default("") }}'

# Weekly local prune+check maintenance (local-maintenance.sh). Empty = disabled.
KUMA_LOCAL_MAINT_PUSH_URL='{{ local_maintenance_kuma_push_url | default("") }}'

# --- Offsite replication (ADR-010) ---
# rest-server on the offsite Pi, reached through WireGuard. Empty repository
# disables the copy step. Connection details come from the offsite host_vars
# (single source of truth); only the repo password is homelab-local.
{% if offsite_restic_password is defined and offsite_restic_password %}
OFFSITE_RESTIC_REPOSITORY='rest:http://{{ hostvars["offsite"].offsite_wg_ip }}:{{ hostvars["offsite"].rest_server_port }}/'
OFFSITE_RESTIC_PASSWORD='{{ offsite_restic_password }}'
OFFSITE_REST_USER='{{ hostvars["offsite"].rest_server_auth_user }}'
OFFSITE_REST_PASSWORD='{{ hostvars["offsite"].rest_server_auth_password }}'
{% else %}
OFFSITE_RESTIC_REPOSITORY=''
{% endif %}
# Dedicated Kuma push monitors: nightly offsite copy + weekly offsite check.
KUMA_OFFSITE_PUSH_URL='{{ offsite_copy_kuma_push_url | default("") }}'
KUMA_OFFSITE_CHECK_PUSH_URL='{{ offsite_check_kuma_push_url | default("") }}'
