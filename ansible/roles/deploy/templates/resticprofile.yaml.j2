# {{ ansible_managed }}
# =============================================================================
# resticprofile — ADR-031
# =============================================================================
# The ORCHESTRATION half of backup.sh: what to back up, where to copy it, what
# to keep. The database dumps and the assertions that check them are NOT here
# and are not meant to be — no tool expresses them, and the assertions exist
# because of #190. They keep their own script.
#
# It now drives all three timers: the nightly backup+copy, the weekly local
# prune+check, and the weekly offsite check. backup.sh, local-maintenance.sh and
# offsite-check.sh are gone.
#
# Repository paths come from the environment, so backup.env stays the single
# place they are defined and no path is duplicated here.
version: "1"

homelab:
  repository: '{{ "{{ .Env.RESTIC_REPOSITORY }}" }}'
  password-file: /mnt/data/secrets/restic_password
  # Concurrency protection, and it replaces something specific: backup.sh wrapped
  # its copy step in `flock /var/lock/offsite-copy.lock` after a collision
  # between the 2026-07-12 seed and the nightly copy put ~100 GB of duplicates
  # on the append-only repository, reclaimable only by a manual prune.
  #
  # This lock is stronger than the one it replaces — it covers the WHOLE profile,
  # backup and copy alike, not just the copy step. Verified: a second invocation
  # during a running one is refused with "another process is already running
  # this profile" and the first completes untouched.
  #
  # Any manual run must therefore go through resticprofile rather than restic
  # directly, which is what makes the protection hold.
  lock: /var/lock/resticprofile-homelab.lock

  # A repository on a LUKS volume that may not be mounted. Failing loudly beats
  # initialising a second, empty repository on the mountpoint's own directory.
  initialize: false

  # The offsite repository is a REST server behind HTTP auth, and restic reads
  # those credentials from RESTIC_REST_USERNAME / RESTIC_REST_PASSWORD — names
  # backup.env does not use. backup.sh set them inline on the copy command; here
  # they are mapped once.
  #
  # Found the hard way: without this the copy dies with
  #   Fatal: unable to open config file: unexpected HTTP response (401)
  # which is at least a loud failure, and the notification hook reported it
  # correctly — that half of the migration proved itself by breaking.
  #
  # Harmless on the local repository: it is a filesystem path, so REST
  # credentials are ignored there.
  env:
    RESTIC_REST_USERNAME: '{{ "{{ .Env.OFFSITE_REST_USER }}" }}'
    RESTIC_REST_PASSWORD: '{{ "{{ .Env.OFFSITE_REST_PASSWORD }}" }}'

  backup:
    # --- Dumps, and then their assertions (ADR-031, ADR-032) ---------------
    # This was a 373-line script. ADR-031 kept it and said why: "resticprofile
    # has no equivalent" for the assertions. True when written, and stale since
    # ADR-032 installed goss — so the dump COMMANDS are hooks and the assertions
    # are a declared spec, generated from the same two lists in group_vars. A
    # database added there gets dumped AND checked, and cannot get one without
    # the other, which is the defect #177 named wearing different clothes.
    #
    # The directory is emptied first, and that is not housekeeping. A `sqlite3
    # .backup` that fails does NOT touch its destination — measured: 12288
    # bytes, 2 tables, quick_check ok, byte-for-byte unchanged after a failed
    # run. So a dump left by an earlier run passes every assertion while being a
    # day old. It needs a run that ABORTED, and the log shows 103 "started"
    # against 102 "completed", the orphan being 2026-07-12.
    #
    # 0700 explicitly, not the unit's umask (#199): under UMask=0022 `mkdir -p`
    # gave 0755 and the dumps 0644, under parents 0755 all the way up — so for
    # the length of every run, any local unprivileged account could read the
    # complete Vaultwarden vault, the Kuma database with its push tokens,
    # Nextcloud's password hashes and the Forgejo database. Read back out of a
    # snapshot, so those are the modes that really existed. The #177 sweep closed
    # the six LIVE stores and never looked at the copy made of them every night.
    #
    # Creating it here also keeps the snapshot's path set stable at five whether
    # or not anything populated it: `restic forget` groups by `host,paths`, so a
    # snapshot with four paths forms its own retention group and gets its own
    # 7 daily / 4 weekly / 6 monthly. The first real run of this profile did
    # exactly that.
    #
    # EVERY dump ends `|| true`, deliberately. A run-before that fails makes
    # resticprofile abort the backup, and one bad dump must never cost the
    # snapshot of everything else — the failure is deferred and reported by the
    # notification hook instead. That is why the assertions exist: a dump command
    # that fails silently is caught by the check that opens its file, not by an
    # exit code, which is the lesson of #190 where the file existed and the guard
    # was satisfied while the content was truncated.
    run-before:
      - rm -rf {{ backup_dir }}/dumps
      - install -d -m 0700 {{ backup_dir }}/dumps

      # Nextcloud MariaDB. The password is read from the secret already mounted
      # in the container and handed over through MYSQL_PWD — never through
      # `-p"…"`, which put it in the argv of the host's `docker` client for the
      # 6 to 9 seconds this takes, every night at a fixed and known hour (#198).
      # /proc carries no hidepid here. The single quotes keep the expansion
      # INSIDE the container: expanded on the host, the secret path does not
      # exist and the dump would run with an empty password.
      - >-
        docker exec nextcloud-db sh -c 'MYSQL_PWD=$(cat /run/secrets/nextcloud_db_password)
        mariadb-dump --single-transaction --routines --triggers
        -u"${MYSQL_USER:-nextcloud}" "${MYSQL_DATABASE:-nextcloud}"'
        > {{ backup_dir }}/dumps/nextcloud.sql 2>> {{ backup_log }} || true

      # SQLite, via the Online Backup API. Restic snapshotting a live database
      # while the service runs can capture a torn WAL state; `.backup` writes a
      # consistent copy under concurrent writes. Host-side because none of these
      # images ships the sqlite3 CLI. Kuma gets a busy timeout on top: it is
      # under constant write pressure (a heartbeat row per monitor per interval)
      # so unlike the others it genuinely collides, and `.backup` returns
      # SQLITE_BUSY on a locked source.
      #
      # Guarded on the source EXISTING, and that guard is load-bearing rather
      # than defensive: `sqlite3 <missing> ".backup dest"` does not fail, it
      # CREATES the missing database and copies the empty result. The dump would
      # then satisfy the `-source` assertion that exists to catch a moved path,
      # and leave an empty database sitting in the service's own directory.
      # Found by rendering this block and reading it, before it ever ran.
{% for d in backup_sqlite_dumps %}
      - >-
        test -f {{ d.source }} && sqlite3 -cmd '.timeout 5000' {{ d.source }}
        ".backup '{{ backup_dir }}/dumps/{{ d.file }}'" 2>> {{ backup_log }} || true
{% endfor %}

      # Miniflux PostgreSQL. services/miniflux/db is in the source list below,
      # but restic walks it file by file while Postgres writes: the copy is not
      # atomic and can restore to a torn cluster. Plain SQL rather than .gz on
      # purpose — restic deduplicates a text dump from one day to the next, while
      # a compressed one changes end to end on any edit and crosses the offsite
      # link whole every night. No password: the image entrypoint writes
      # `local all all trust` and docker exec connects over the unix socket.
      - >-
        docker exec miniflux-db pg_dump -U '{{ miniflux_db_user | default("miniflux") }}'
        '{{ miniflux_db_name | default("miniflux") }}'
        > {{ backup_dir }}/dumps/miniflux.sql 2>> {{ backup_log }} || true

      # The assertions, run BEFORE the snapshot so what is asserted is what gets
      # snapshotted. `|| true` for the same reason as the dumps: the verdict is
      # deferred to the notification hook, which reads this TAP file. An ABSENT
      # file therefore means the dump step did not run at all, which is not the
      # same as "no failures" and must not read as success.
      - >-
        goss -g /etc/goss/backup-dumps.yaml validate --format tap
        > {{ dump_tap }} 2>&1 || true

    # resticprofile hooks receive PROFILE_NAME and PROFILE_COMMAND and nothing
    # else — no snapshot id, no summary, and there is no run status file either.
    # So the notification is built by a small adapter rather than reproduced
    # from configuration, which cannot see any of it.
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up backup
      # backup.sh removed the dumps once the snapshot held them, and so does
      # this. On SUCCESS only, deliberately — `run-finally` would also fire on a
      # failed backup and destroy the dumps that failure needs looking at. The
      # next run's run-before recreates the directory, so the path set stays
      # five either way.
      - rm -rf /mnt/data/backups/dumps
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down backup

    # Identical to the list backup.sh passed, including the exclude: the
    # libresign aarch64 blob is regenerated on demand and costs more to store
    # than to rebuild.
    source:
      - /mnt/data/services
      - /mnt/data/media
      - /mnt/data/backups/dumps
      - /mnt/data/secrets
      - /opt/homelab
    exclude:
      - /mnt/data/services/nextcloud/data/data/appdata_*/libresign/aarch64
    tag:
      - auto
    # restic's own summary, which the current script parses out of --json to
    # build its Kuma message. Phase 2 reads it from here instead.
    verbose: true

  # Nightly forget, weekly prune — the split backup.sh already makes, and for
  # the same reason: forget is cheap and prune rewrites the repository.
  retention:
    after-backup: true
    keep-daily: 7
    keep-weekly: 4
    keep-monthly: 6
    prune: false
    # `path: false` is NOT a default — resticprofile otherwise derives a
    # `--path` filter from the backup sources, and `backup.sh` runs a plain
    # `restic forget` with no filter at all. The difference is not cosmetic:
    # a filter EXCLUDES snapshots whose path set does not match, so any older
    # snapshot taken before a source was added would never be considered for
    # removal and would accumulate for ever. Caught by reading `resticprofile
    # show` rather than by trusting the config to mean what it looks like.
    path: false

  # ADR-010. `restic copy` is idempotent — verified in the spike: a second copy
  # with nothing changed wrote nothing and left the destination at one snapshot.
  # So the "last 7 days" bound backup.sh computes with a JSON listing and a
  # Python filter is an optimisation, not a correctness requirement, and
  # re-offering a snapshot already present on an append-only repository is a
  # no-op. That is the most convoluted part of the script gone.
  copy:
    repository: '{{ "{{ .Env.OFFSITE_RESTIC_REPOSITORY }}" }}'
    password-file: /mnt/data/secrets/offsite_restic_password
    # The destination exists and is append-only; creating it here would be a
    # symptom of pointing at the wrong place.
    initialize: false

    # Its OWN monitor, as in backup.sh. The copy fails for entirely different
    # reasons — the tunnel, the remote host — and folding it into the backup
    # signal would hide one behind the other.
    #
    # `backup` does NOT trigger `copy`: verified, only the backup hook fired.
    # resticprofile's groups assemble PROFILES, not commands within one, so the
    # nightly job runs both commands from the systemd unit. Switching the timer
    # to `backup` alone would have stopped offsite replication silently, while
    # every run reported success.
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up copy
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down copy

  # --- Weekly maintenance, replacing local-maintenance.sh --------------------
  # prune and check share ONE monitor, and only the LAST command pushes the
  # success. If prune also pushed `up`, a deep check running for an hour behind
  # it would leave Kuma claiming the maintenance had already completed.
  #
  # The failure path is what makes one monitor enough. `Type=oneshot` stops at
  # the first failing ExecStart, and resticprofile exits 1 on a failed restic
  # command (probed: exit 1, only run-after-fail fired). So a failed prune pushes
  # DOWN and check never runs to overwrite it — the verdict the two commands used
  # to compute jointly in shell now falls out of the ordering.
  prune:
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down maintenance

  check:
    # A ROTATING deep check: one twelfth of the data each month, so the whole
    # repository is verified over a year without ever paying for it in one go.
    # Carried over from local-maintenance.sh, which computed the same fraction
    # in shell — and it matters more now than when it was written, with a drive
    # showing pending sectors (#207).
    #
    # Deep only in the first week of the month; the other weekly runs check
    # metadata alone. The timer fires four times a month, so making every run
    # read data would quadruple the I/O on that drive rather than verify more.
    #
    # The mode travels WITH the run, in the same branch that decides it (#290).
    # Nothing downstream can derive it: resticprofile's hooks receive
    # PROFILE_NAME and PROFILE_COMMAND and nothing else, so a notification that
    # wants to say which check ran has to be told here or not at all.
    #
    # It is not a nicety. This is the only operation in the whole chain that
    # re-reads the repository's actual bytes, and after ADR-031 its Kuma message
    # was byte-identical to a metadata run's — while the journal that carried the
    # difference holds 16.8 days against a 30-day period. Kuma keeps 180 days of
    # heartbeat messages, so moving the distinction into the message moves the
    # evidence into a store that outlives the event.
    #
    # It also closes the silent-degradation path. If the host is off for the
    # first week of a month the catch-up fires on a day this branch no longer
    # matches, the run quietly becomes metadata-only, and a twelfth of the
    # repository goes unverified for another year. It still does — resticprofile
    # cannot know what ran last month — but the beat now SAYS metadata, and
    # `restic-deep-check-not-stale` in the posture spec fails when no deep beat
    # has landed in 40 days.
{% raw %}{{ if le .Now.Day 7 }}
    read-data-subset: '{{ printf "%d" .Now.Month }}/12'
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up maintenance deep {{ printf "%d" .Now.Month }}
{{ else }}
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up maintenance metadata
{{ end }}{% endraw %}
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down maintenance

# --- The offsite repository, replacing offsite-check.sh ----------------------
# A profile of its own rather than a section: `check` runs against the profile's
# repository, and the offsite one is a different repository with different
# credentials. Nothing here backs up — it only verifies what the copy put there.
offsite:
  repository: '{{ "{{ .Env.OFFSITE_RESTIC_REPOSITORY }}" }}'
  password-file: /mnt/data/secrets/offsite_restic_password
  initialize: false
  lock: /var/lock/resticprofile-offsite.lock

  env:
    RESTIC_REST_USERNAME: '{{ "{{ .Env.OFFSITE_REST_USER }}" }}'
    RESTIC_REST_PASSWORD: '{{ "{{ .Env.OFFSITE_REST_PASSWORD }}" }}'

  check:
    # Metadata only, deliberately. The repository is append-only and reached
    # over the tunnel; reading its data back would pull hundreds of gigabytes
    # across a domestic uplink to verify bytes the remote host can verify
    # itself. What this asserts is that the repository is READABLE and
    # structurally intact, which is what a copy target has to be.
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up offsite-check
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down offsite-check
