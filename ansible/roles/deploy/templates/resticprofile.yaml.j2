# {{ ansible_managed }}
version: "1"

homelab:
  repository: '{{ "{{ .Env.RESTIC_REPOSITORY }}" }}'
  password-file: /mnt/data/secrets/restic_password
  status-file: /var/lib/homelab-backup/status.json
  lock: /run/lock/resticprofile-homelab.lock

  initialize: false

  env:
    RESTIC_REST_USERNAME: '{{ "{{ .Env.OFFSITE_REST_USER }}" }}'
    RESTIC_REST_PASSWORD: '{{ "{{ .Env.OFFSITE_REST_PASSWORD }}" }}'

  backup:
    run-before:
      - rm -rf {{ backup_dir }}/dumps
      - install -d -m 0700 {{ backup_dir }}/dumps

      - >-
        docker exec nextcloud-db sh -c 'MYSQL_PWD=$(cat /run/secrets/nextcloud_db_password)
        mariadb-dump --single-transaction --routines --triggers
        -u"${MYSQL_USER:-nextcloud}" "${MYSQL_DATABASE:-nextcloud}"'
        > {{ backup_dir }}/dumps/nextcloud.sql 2>> {{ backup_log }} || true

{% for d in backup_sqlite_dumps %}
      - >-
        test -f {{ d.source }} && sqlite3 -cmd '.timeout 5000' {{ d.source }}
        ".backup '{{ backup_dir }}/dumps/{{ d.file }}'" 2>> {{ backup_log }} || true
{% endfor %}

      - >-
        docker exec miniflux-db pg_dump -U '{{ miniflux_db_user | default("miniflux") }}'
        '{{ miniflux_db_name | default("miniflux") }}'
        > {{ backup_dir }}/dumps/miniflux.sql 2>> {{ backup_log }} || true

      - >-
        goss -g /etc/goss/backup-dumps.yaml validate --format tap
        > {{ dump_tap }} 2>&1 || true

    run-after:
      - /opt/homelab/scripts/backup-notify.sh up backup
      - rm -rf /mnt/data/backups/dumps
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down backup

    source:
      - /mnt/data/services
      - /mnt/data/media
      - /mnt/data/backups/dumps
      - /mnt/data/secrets
      - /opt/homelab
    exclude:
      - /mnt/data/services/nextcloud/data/data/appdata_*/libresign/aarch64

      - /mnt/data/services/netdata/cache

      - /mnt/data/services/pihole/etc/pihole-FTL.db
      - /mnt/data/services/pihole/etc/pihole-FTL.db-wal
      - /mnt/data/services/pihole/etc/pihole-FTL.db-shm

      - /mnt/data/services/miniflux/db
      - /mnt/data/services/nextcloud/db
      - /mnt/data/services/immich/db
      - /mnt/data/services/uptime-kuma/kuma.db
      - /mnt/data/services/uptime-kuma/kuma.db-wal
      - /mnt/data/services/uptime-kuma/kuma.db-shm

      - /mnt/data/services/calibre-web/processed_books/failed
      - /mnt/data/services/calibre-web/processed_books/imported
      - /mnt/data/services/calibre-web/processed_books/fixed_originals
      - /mnt/data/services/calibre-web/processed_books/duplicate_resolutions

      - /mnt/data/services/uptime-kuma/kuma-pre-*
    tag:
      - auto
    verbose: true

  retention:
    after-backup: true
    keep-daily: 7
    keep-weekly: 4
    keep-monthly: 6
    prune: false
    path: false

  copy:
    repository: '{{ "{{ .Env.OFFSITE_RESTIC_REPOSITORY }}" }}'
    password-file: /mnt/data/secrets/offsite_restic_password
    initialize: false

    run-after:
      - /opt/homelab/scripts/backup-notify.sh up copy
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down copy

  prune:
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down maintenance

  check:
{% raw %}{{ if le .Now.Day 7 }}
    read-data-subset: '{{ printf "%d" .Now.Month }}/12'
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up maintenance deep {{ printf "%d" .Now.Month }}
{{ else }}
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up maintenance metadata
{{ end }}{% endraw %}
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down maintenance

offsite:
  repository: '{{ "{{ .Env.OFFSITE_RESTIC_REPOSITORY }}" }}'
  password-file: /mnt/data/secrets/offsite_restic_password
  initialize: false
  lock: /run/lock/resticprofile-offsite.lock

  env:
    RESTIC_REST_USERNAME: '{{ "{{ .Env.OFFSITE_REST_USER }}" }}'
    RESTIC_REST_PASSWORD: '{{ "{{ .Env.OFFSITE_REST_PASSWORD }}" }}'

  check:
    run-after:
      - /opt/homelab/scripts/backup-notify.sh up offsite-check
    run-after-fail:
      - /opt/homelab/scripts/backup-notify.sh down offsite-check
