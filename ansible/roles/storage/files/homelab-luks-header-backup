#!/usr/bin/env bash

set -euo pipefail

DEVICE="${1:-/dev/sda1}"
OUT="/root/luks-header-${DEVICE//\//_}-$(date +%Y%m%d-%H%M%S).img"

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: run as root (needs raw access to $DEVICE)" >&2
    exit 1
fi

if ! cryptsetup isLuks "$DEVICE"; then
    echo "ERROR: $DEVICE is not a LUKS device" >&2
    exit 1
fi

old=$(ls -1 /root/luks-header-*.img 2>/dev/null || true)
if [ -n "$old" ]; then
    echo "WARNING: header copies from an earlier run are still on this machine:" >&2
    printf '  %s\n' $old >&2
    echo "  Each is as sensitive as the passphrase. Shred them once they are safe." >&2
    echo >&2
fi

umask 077
cryptsetup luksHeaderBackup "$DEVICE" --header-backup-file "$OUT"
chmod 600 "$OUT"

echo
echo "Header backed up to: $OUT"
echo "SHA256: $(sha256sum "$OUT" | cut -d' ' -f1)"
echo "Size:   $(du -h "$OUT" | cut -f1)"
echo
echo "NEXT (this file is as sensitive as the passphrase — do NOT leave it here):"
echo "  1. Move it off this machine, to BOTH of the independent places named in"
echo "     knowledge/runbooks/luks-header-backup.md."
echo "  2. Shred the working copy:  shred -u '$OUT'"

if [ -e /run/homelab/tamper-armed ]; then
    echo
    echo "STOP — the USB tamper response is ARMED right now."
    echo "Plugging or unplugging ANYTHING powers this machine off, and there is"
    echo "no way back in remotely. Before you touch a cable:"
    echo "    sudo homelab-tamper-disarm"
    echo "and once the copy is done, put it back:"
    echo "    sudo homelab-tamper-arm"
fi
