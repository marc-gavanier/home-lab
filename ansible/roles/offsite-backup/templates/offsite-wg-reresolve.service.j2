# {{ ansible_managed }}
[Unit]
Description=Re-resolve the homelab WireGuard endpoint when the tunnel goes quiet
Documentation=https://github.com/marc-gavanier/home-lab/issues/180
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/offsite-wg-reresolve.sh
