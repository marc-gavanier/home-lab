#!/usr/bin/env bash
# {{ ansible_managed }}

set -uo pipefail

KUMA_PUSH_URL='{{ offsite_health_kuma_push_url }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"
MOUNT='{{ backup_mount_point }}'
DRIVE='{{ backup_disk_device_base }}'
SPEC=/etc/goss/offsite-health.yaml

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    local rc=0
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 30 --connect-timeout 5 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null || rc=$?
    case "$rc" in
        0) ;;
        28) echo "kuma-push-unconfirmed: no reply within 30s, the beat may have landed — $2" >&2 ;;
        *)  echo "kuma-push-failed: this report reached nobody — $2" >&2 ;;
    esac
}

problems=()

if ! . /usr/local/lib/homelab-gate.sh 2>/dev/null; then
    problems+=("homelab-gate.sh missing — the update grace period is disabled")
    gate() { shift 2; [ "$#" -gt 0 ] && printf '%s\n' "$@"; }
fi

if [ ! -f "$SPEC" ]; then
    problems+=("goss spec missing — nothing was asserted")
elif ! command -v goss >/dev/null 2>&1; then
    problems+=("goss binary missing — nothing was asserted")
else
    tap=$(goss -g "$SPEC" validate --format tap 2>&1) || true
    total=$(printf '%s\n' "$tap" | sed -n 's/^1\.\.\([0-9]*\)$/\1/p')
    seen=$(printf '%s\n' "$tap" | grep -cE '^(not )?ok [0-9]+ ') || true
    if [ -z "$total" ] || [ "$total" -eq 0 ]; then
        problems+=("goss produced no assertions — spec unreadable or empty")
    elif [ "$seen" -ne "$total" ]; then
        problems+=("goss declared $total assertions and produced $seen — the run was cut short")
    else
        failed=$(printf '%s\n' "$tap" | sed -n 's/^not ok [0-9]* - [A-Za-z]*: \([^:]*\):.*/\1/p' |
                 sort -u | tr '\n' ' ')
        if [ -n "${failed% }" ]; then
            # shellcheck disable=SC2086
            if printf '%s\n' $failed | grep -qx offsite-no-failed-units; then
                failed_units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
                [ -n "${failed_units% }" ] && failed="$failed(failed: ${failed_units% }) "
            fi
            problems+=("${failed% }")
        fi
    fi
fi

APT_CHECK=/usr/lib/update-notifier/apt-check
if [ -x "$APT_CHECK" ]; then
    apt_out=$("$APT_CHECK" 2>&1); apt_rc=$?
    if [ "$apt_rc" -ne 0 ] || ! [[ "${apt_out##*$'\n'}" =~ ^[0-9]+\;([0-9]+)$ ]]; then
        problems+=("apt-check failed (rc=$apt_rc: ${apt_out%%$'\n'*}) — security updates are not being counted")
    elif [ "${BASH_REMATCH[1]}" -gt 0 ]; then
        sec=${BASH_REMATCH[1]}
        [ -n "$(gate security-updates 172800 nonzero)" ] &&
            problems+=("$sec security updates unapplied >48h")
    else
        gate security-updates 172800
    fi

    lists_ok=$(stat -c %Y /var/lib/apt/periodic/update-success-stamp 2>/dev/null || echo "")
    if [ -z "$lists_ok" ]; then
        problems+=("no successful apt update on record — the security count cannot see new fixes")
    elif [ $(( $(date +%s) - lists_ok )) -gt 259200 ]; then
        problems+=("package lists last refreshed $(( ($(date +%s) - lists_ok) / 3600 ))h ago — apt update is failing, so the security count cannot see new fixes")
    fi
fi

disk=$(df --output=pcent "$MOUNT" 2>/dev/null | tail -1 | tr -dc '0-9')
cpu=$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 ))
ssd_line=$(smartctl -A "$DRIVE" 2>/dev/null | awk '$1 == 194 { print; exit }')
ssd=$(printf '%s\n' "$ssd_line" | awk '{ print $10 }')
ssd_max=$(printf '%s\n' "$ssd_line" | sed -n 's/.*Min\/Max *[0-9]*\/\([0-9]*\).*/\1/p')
hs=$(wg show wg0 latest-handshakes 2>/dev/null | awk 'NR == 1 { print $2 }')
tunnel=$([ -n "${hs:-}" ] && echo "$(( $(date +%s) - hs ))s" || echo "down")

msg="disk ${disk:-?}%, cpu ${cpu}C, ssd ${ssd:-?}C${ssd_max:+ (max ${ssd_max}C)}, tunnel ${tunnel}${total:+, ${total} checks}"

if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(printf '%s; ' "${problems[@]}" | sed 's/; $//') | $msg"
    exit 1
fi

notify up "$msg"
