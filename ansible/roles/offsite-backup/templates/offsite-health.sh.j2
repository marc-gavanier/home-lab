#!/usr/bin/env bash
# =============================================================================
# Offsite Pi — weekly disk-health report (generated by Ansible)
# =============================================================================
# Pushes disk, SMART and Pi power/thermal health to an Uptime Kuma push
# monitor. The overall `smartctl -H` verdict is notoriously optimistic (it
# stays PASSED until the drive is nearly dead), so the early-warning counters
# are checked individually: any of them leaving zero reports DOWN long before
# the verdict flips. A monthly long self-test (offsite-smart-test.timer) makes
# the drive scan its own surface; its last result is checked here too.
# The restic repo itself is checked weekly FROM the homelab (it holds the
# repo password; this host deliberately does not).

set -uo pipefail

KUMA_PUSH_URL='{{ offsite_health_kuma_push_url }}'
MOUNT='{{ backup_mount_point }}'
DISK='{{ backup_disk_device }}'
DRIVE=${DISK%[0-9]*}

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    curl -fsS -m 10 --retry 2 -G "$KUMA_PUSH_URL" \
        --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null 2>&1 || true
}

problems=()
report=()

# --- Mount & capacity ---

if ! mountpoint -q "$MOUNT"; then
    notify down "backup disk not mounted"
    exit 1
fi

usage=$(df --output=pcent "$MOUNT" | tail -1 | tr -dc '0-9')
[ "$usage" -ge 85 ] && problems+=("disk ${usage}% full")
report+=("disk ${usage}%")

# --- SMART ---
# smartctl exit status is a bitmask: bit 3 (value 8) = disk failing;
# bits 0-2 = command/device errors (USB bridge quirks — not a disk failure).

smart_out=$(smartctl -H -A -l selftest "$DRIVE" 2>/dev/null)
rc=$?
if [ $((rc & 8)) -ne 0 ]; then
    problems+=("SMART FAILING")
elif [ $((rc & 7)) -ne 0 ] && [ -z "$smart_out" ]; then
    report+=("SMART unreadable")
fi

if [ -n "$smart_out" ]; then
    raw()  { awk -v id="$1" '$1 == id { print $10; exit }' <<<"$smart_out"; }
    norm() { awk -v id="$1" '$1 == id { print $4 + 0; exit }' <<<"$smart_out"; }

    # Error counters that must stay at zero — each one is an early failure
    # predictor: media decay (5/170/187), NAND wearout (171/172), data-path
    # corruption (184), USB cable/bridge trouble (199).
    for spec in 5:realloc 170:grown-bad-blocks 171:program-fail 172:erase-fail \
                184:end-to-end 187:uncorrectable 199:crc-err; do
        v=$(raw "${spec%%:*}")
        if [ -n "$v" ] && [ "$v" != "0" ]; then
            problems+=("SMART ${spec#*:}=$v")
        fi
    done

    # Remaining spare-block reserve (normalized: 100 = full, vendor floor 4)
    spare=$(norm 232)
    if [ -n "$spare" ] && [ "$spare" -lt 50 ]; then
        problems+=("spare blocks ${spare}%")
    fi

    # SSD temperature (attribute 194, raw first field)
    ssd_temp=$(raw 194)
    if [ -n "$ssd_temp" ]; then
        report+=("ssd ${ssd_temp}C")
        [ "$ssd_temp" -ge 70 ] && problems+=("ssd ${ssd_temp}C")
    fi

    # Last long self-test (started monthly by offsite-smart-test.timer)
    selftest=$(awk '/^# 1/ { $1=""; $2=""; print; exit }' <<<"$smart_out" | xargs)
    if [ -n "$selftest" ]; then
        grep -qiE 'fail|aborted' <<<"$selftest" && problems+=("self-test: $selftest")
        # Dead-man's check on the monthly timer itself: the log stamps each
        # test in drive power-on hours — compare with attribute 9 so a
        # silently dead timer surfaces here instead of leaving an eternally
        # green "Completed without error" from months ago.
        now_h=$(raw 9)
        test_h=$(awk '/^# 1/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { print $(i + 1); exit } }' <<<"$smart_out")
        if [ -n "$now_h" ] && [ -n "$test_h" ] && [ $((now_h - test_h)) -gt 840 ]; then
            problems+=("self-test stale ($(((now_h - test_h) / 24))d ago)")
        fi
    else
        report+=("no self-test yet")
    fi
fi

# --- Pi power & thermal ---
# A sagging power supply silently corrupts disks; the firmware latches
# undervoltage events into the rpi_volt hwmon alarm.

cpu_temp=$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))
report+=("cpu ${cpu_temp}C")

for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "rpi_volt" ] || continue
    [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = "1" ] && problems+=("undervoltage")
done

# --- Verdict ---

join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }

msg=$(join ', ' "${report[@]}")
{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "SMART ok, $msg"
