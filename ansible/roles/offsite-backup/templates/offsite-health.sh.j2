#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Offsite Pi — weekly disk-health report
# =============================================================================
# Pushes disk, SMART and Pi power/thermal health to an Uptime Kuma push
# monitor. The overall `smartctl -H` verdict is notoriously optimistic (it
# stays PASSED until the drive is nearly dead), so the early-warning counters
# are checked individually: any of them leaving zero reports DOWN long before
# the verdict flips. A monthly long self-test (offsite-smart-test.timer) makes
# the drive scan its own surface; its last result is checked here too.
# The restic repo itself is checked weekly FROM the homelab (it holds the
# repo password; this host deliberately does not).

set -uo pipefail

KUMA_PUSH_URL='{{ offsite_health_kuma_push_url }}'
MOUNT='{{ backup_mount_point }}'
DISK='{{ backup_disk_device }}'
DRIVE=${DISK%[0-9]*}

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv there
    # either.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null 2>&1 || true
}

problems=()
report=()

# --- Mount & capacity ---

if ! mountpoint -q "$MOUNT"; then
    notify down "backup disk not mounted"
    exit 1
fi

usage=$(df --output=pcent "$MOUNT" | tail -1 | tr -dc '0-9')
[ "$usage" -ge 85 ] && problems+=("disk ${usage}% full")
report+=("disk ${usage}%")

# --- Filesystem, as opposed to disk ---
# Carried over from homelab-disk.sh: the sweep of #155 brought the lynis timer
# and the SMART guard to this host and left the ext4 superblock counter behind
# (#177). SMART watches the hardware and nothing watched the filesystem on top
# of it, on the volume holding the only offsite copy — reported once a week.
#
# A clean filesystem prints NO "FS Error count" line, so its presence is itself
# the signal; `Filesystem state` reads "clean with errors" rather than "clean"
# once anything has been recorded. An empty state means the header parsed and
# told us nothing, which reads as a failure like everything else here, and a
# loop that visited nothing reports rather than passes.
ext4_bad=""
ext4_seen=0
while read -r src tgt; do
    ext4_seen=$((ext4_seen + 1))
    hdr=$(dumpe2fs -h "$src" 2>/dev/null) || { ext4_bad="$ext4_bad $tgt(unreadable)"; continue; }
    state=$(awk -F: '/^Filesystem state/ { gsub(/^ +| +$/, "", $2); print $2 }' <<<"$hdr")
    errs=$(awk -F: '/^FS Error count/ { gsub(/ /, "", $2); print $2 }' <<<"$hdr")
    case "$state" in
        clean) ;;
        "")    ext4_bad="$ext4_bad $tgt(state unreadable)" ;;
        *)     ext4_bad="$ext4_bad $tgt($state)" ;;
    esac
    [ -n "$errs" ] && ext4_bad="$ext4_bad $tgt($errs recorded errors)"
done < <(findmnt -l -t ext4 -no SOURCE,TARGET)

if [ "$ext4_seen" -eq 0 ]; then
    problems+=("ext4: no filesystem was visited — the check asserted nothing")
elif [ -n "$ext4_bad" ]; then
    problems+=("ext4:$ext4_bad")
else
    report+=("ext4 clean ($ext4_seen)")
fi

# --- SMART ---
# smartctl exit status is a bitmask: bit 3 (value 8) = disk failing;
# bits 0-2 = command/device errors (USB bridge quirks — not a disk failure).

smart_out=$(smartctl -H -A -l selftest "$DRIVE" 2>/dev/null)
rc=$?
if [ $((rc & 8)) -ne 0 ]; then
    problems+=("SMART FAILING")
fi

raw()  { awk -v id="$1" '$1 == id { print $10; exit }' <<<"$smart_out"; }
norm() { awk -v id="$1" '$1 == id { print $4 + 0; exit }' <<<"$smart_out"; }

# Readability is asserted on a VALUE, not on the output being non-empty.
#
# The previous guard classified unreadable SMART as a *report* line, and only
# when the output was EMPTY. Measured on this host 2026-08-17: smartctl writes
# its refusals to stdout, so a device it cannot talk to returns rc=1 with 282
# bytes of "Unable to detect device type" — non-empty, so the branch never
# fired. Execution then fell into the normal path, every attribute lookup came
# back empty, every check below was skipped in silence, and the run still ended
# on `notify up "SMART ok"`. A USB-SATA bridge that stops passing SAT commands
# fails exactly that way, on the host least likely to be looked at directly.
#
# Power-on hours is the instrument: present on every ATA drive, already needed
# for the self-test staleness check below, and it can only parse as a number if
# the attribute table was genuinely read.
power_on_h=$(raw 9)
if ! [[ "$power_on_h" =~ ^[0-9]+$ ]]; then
    problems+=("SMART unreadable (rc=$rc)")
else
    # Error counters that must stay at zero — each one is an early failure
    # predictor: media decay (5/170/187), NAND wearout (171/172), data-path
    # corruption (184), USB cable/bridge trouble (199).
    for spec in 5:realloc 170:grown-bad-blocks 171:program-fail 172:erase-fail \
                184:end-to-end 187:uncorrectable 199:crc-err; do
        v=$(raw "${spec%%:*}")
        if [ -n "$v" ] && [ "$v" != "0" ]; then
            problems+=("SMART ${spec#*:}=$v")
        fi
    done

    # Remaining spare-block reserve (normalized: 100 = full, vendor floor 4)
    spare=$(norm 232)
    if [ -n "$spare" ] && [ "$spare" -lt 50 ]; then
        problems+=("spare blocks ${spare}%")
    fi

    # SSD temperature (attribute 194, raw first field)
    ssd_temp=$(raw 194)
    if [ -n "$ssd_temp" ]; then
        report+=("ssd ${ssd_temp}C")
        [ "$ssd_temp" -ge 70 ] && problems+=("ssd ${ssd_temp}C")
    fi

    # Last long self-test (started monthly by offsite-smart-test.timer)
    selftest=$(awk '/^# 1/ { $1=""; $2=""; print; exit }' <<<"$smart_out" | xargs)
    if [ -n "$selftest" ]; then
        grep -qiE 'fail|aborted' <<<"$selftest" && problems+=("self-test: $selftest")
        # Dead-man's check on the monthly timer itself: the log stamps each
        # test in drive power-on hours — compare with attribute 9 so a
        # silently dead timer surfaces here instead of leaving an eternally
        # green "Completed without error" from months ago.
        test_h=$(awk '/^# 1/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { print $(i + 1); exit } }' <<<"$smart_out")
        if [ -n "$test_h" ] && [ $((power_on_h - test_h)) -gt 840 ]; then
            problems+=("self-test stale ($(((power_on_h - test_h) / 24))d ago)")
        fi
    else
        report+=("no self-test yet")
    fi
fi

# --- Pi power & thermal ---
# A sagging power supply silently corrupts disks; the firmware latches
# undervoltage events into the rpi_volt hwmon alarm.

cpu_temp=$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))
report+=("cpu ${cpu_temp}C")

for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "rpi_volt" ] || continue
    [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = "1" ] && problems+=("undervoltage")
done

# --- Verdict ---

join() { local out; out=$(printf "%s$1" "${@:2}"); echo "${out%"$1"}"; }

msg=$(join ', ' "${report[@]}")
{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(join '; ' "${problems[@]}") | $msg"
    exit 1
fi

notify up "SMART ok, $msg"
