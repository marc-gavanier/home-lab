#!/usr/bin/env bash
# {{ ansible_managed }}
# =============================================================================
# Offsite Pi — weekly health, the half goss cannot express
# =============================================================================
# This was 247 lines. ADR-030 had written this host off — "no Docker at all, so
# nothing there moves to Netdata" — which was true of Netdata and read as true
# of the whole migration. goss is a single static binary and never needed
# Docker, so the sixteen assertions are now /etc/goss/offsite-health.yaml and
# what remains here is what a declarative spec has no way to say.
#
# THREE things, and each is here for its own reason:
#
#   1. the PUSH. Nothing listens on this host and nothing should: it dials out,
#      so there is no new port on a machine nobody can reach physically. That
#      was the choice taken over `goss serve` plus an HTTP monitor, which would
#      have deleted this file entirely.
#
#   2. the security-update gate. It has to remember when the count first went
#      nonzero, and goss has no memory. It uses the shared gate (ADR-030), which
#      is why that library is deployed here too.
#
#   3. the READINGS. goss answers pass or fail and carries no values, and this
#      host has no dashboard of any kind — no Netdata, no metrics, nothing. Four
#      numbers in the weekly message are the only visibility anyone has into it.
#
# The verdict itself is goss's: its TAP plan line is the count and its `not ok`
# lines are the diagnosis, named after the failure mode because goss streams
# stdout and never reports a value (measured on the backup dumps).
# =============================================================================

set -uo pipefail

KUMA_PUSH_URL='{{ offsite_health_kuma_push_url }}'
KUMA_PUSH_URL="${KUMA_PUSH_URL%%\?*}"   # strip a pasted example query — duplicates read as DOWN
MOUNT='{{ backup_mount_point }}'
DRIVE='{{ backup_disk_device_base }}'
SPEC=/etc/goss/offsite-health.yaml

notify() {
    [ -n "$KUMA_PUSH_URL" ] || return 0
    # The push URL carries the monitor's own token, so it goes in on stdin
    # instead of argv: /proc is mounted without hidepid, any local account can
    # read another process's command line, and this runs unattended on a timer
    # (#177). printf is a shell builtin, so the value never reaches an argv.
    printf 'url = "%s"\n' "$KUMA_PUSH_URL" |
        curl -fsS -m 10 --retry 2 -K - -G \
            --data-urlencode "status=$1" --data-urlencode "msg=$2" >/dev/null 2>&1 || true
}

problems=()

# Degrade LOUD if the gate library is missing: without the fallback `gate` is an
# unknown command, the substitution is empty, and the update check silently
# stops reporting for good — the shape catalogued in #220.
if ! . /usr/local/lib/homelab-gate.sh 2>/dev/null; then
    problems+=("homelab-gate.sh missing — the update grace period is disabled")
    gate() { shift 2; [ "$#" -gt 0 ] && printf '%s\n' "$@"; }
fi

# --- The declarative half ----------------------------------------------------
# The plan line is goss's own count. Its absence means goss did not parse the
# spec, which must read as a failure rather than as nothing to report: a loop
# that visits nothing returns true, and that is the defect this whole file has
# been rewritten around twice (#156, #177).
if [ ! -f "$SPEC" ]; then
    problems+=("goss spec missing — nothing was asserted")
elif ! command -v goss >/dev/null 2>&1; then
    problems+=("goss binary missing — nothing was asserted")
else
    tap=$(goss -g "$SPEC" validate --format tap 2>&1) || true
    total=$(printf '%s\n' "$tap" | sed -n 's/^1\.\.\([0-9]*\)$/\1/p')
    if [ -z "$total" ] || [ "$total" -eq 0 ]; then
        problems+=("goss produced no assertions — spec unreadable or empty")
    else
        failed=$(printf '%s\n' "$tap" | sed -n 's/^not ok [0-9]* - [A-Za-z]*: \([^:]*\):.*/\1/p' |
                 sort -u | tr '\n' ' ')
        [ -n "${failed% }" ] && problems+=("${failed% }")
    fi
fi

# --- Pending security updates, which needs a memory goss has not -------------
# unattended-upgrades installs security fixes daily, so a bare nonzero count
# would flash red in the hours before it runs. Only alarm if it is STILL nonzero
# after 48h — a held, failed, or stuck update. The reboot half is deliberately
# absent: this host sets Automatic-Reboot at 04:00 (ADR-013) because it has no
# LUKS volume to unlock, so a pending reboot resolves itself overnight.
#
# One consequence of the weekly cadence, worth stating: 48h here means in
# practice "still pending at the next weekly run".
APT_CHECK=/usr/lib/update-notifier/apt-check
if [ -x "$APT_CHECK" ]; then
    sec=$("$APT_CHECK" 2>&1 | cut -d';' -f2); sec=${sec//[^0-9]/}; sec=${sec:-0}
    if [ "$sec" -gt 0 ]; then
        [ -n "$(gate security-updates 172800 nonzero)" ] &&
            problems+=("$sec security updates unapplied >48h")
    else
        gate security-updates 172800
    fi
fi

# --- Readings, because nothing else here reports a number --------------------
disk=$(df --output=pcent "$MOUNT" 2>/dev/null | tail -1 | tr -dc '0-9')
cpu=$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 ))
ssd=$(smartctl -A "$DRIVE" 2>/dev/null | awk '$1 == 194 { print $10; exit }')
hs=$(wg show wg0 latest-handshakes 2>/dev/null | awk 'NR == 1 { print $2 }')
tunnel=$([ -n "${hs:-}" ] && echo "$(( $(date +%s) - hs ))s" || echo "down")

msg="disk ${disk:-?}%, cpu ${cpu}C, ssd ${ssd:-?}C, tunnel ${tunnel}${total:+, ${total} checks}"

{# bash ${#array[@]} reads as a Jinja comment opener — shield it #}
if [ {% raw %}${#problems[@]}{% endraw %} -gt 0 ]; then
    notify down "$(printf '%s; ' "${problems[@]}" | sed 's/; $//') | $msg"
    exit 1
fi

notify up "$msg"
