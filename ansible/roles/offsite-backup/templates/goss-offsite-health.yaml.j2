# {{ ansible_managed }}
# =============================================================================
# Offsite Pi — weekly health, declared (ADR-030, ADR-032)
# =============================================================================
# ADR-030 wrote this host off — "the offsite host has no Docker at all, so
# nothing there moves to Netdata without a native install on a machine nobody
# can reach physically". True of Netdata, and it was read as true of the whole
# migration. goss is a single static binary: it never needed Docker.
#
# One assertion per failure MODE, named after it, for the reason measured on the
# backup dumps: goss streams a command's stdout and never materialises it, so
# every output format reports `object: *bytes.Reader` rather than the value. The
# name is the only thing it always prints, so the name carries the diagnosis.
#
# What is NOT here: the pending-security-updates check. It needs to remember
# when the count first went nonzero, and goss has no memory. It stays in the
# runner, on the shared gate (ADR-030).
#
# POSIX sh, not bash: goss runs each command with /bin/sh, which is dash here.
# The first draft used herestrings and process substitution and four assertions
# came back with exit status 2 — a syntax error, which goss reports exactly like
# a failed check. Measured on the offsite host before deploying anything, which
# is the only reason it is not four permanently-red assertions on the machine
# nobody can reach.
#
# Every check runs smartctl afresh. Twelve invocations a week on a drive that is
# otherwise idle, against one shared parse in the script this replaces — paid
# deliberately, because a shared variable is what let the 2026-08-17 defect hide:
# smartctl wrote its refusal to STDOUT, the emptiness test never fired, every
# attribute lookup came back empty and every check below was skipped in silence
# while the run still reported success.
# =============================================================================

# --- Unit state, absent from this host until 2026-08-29 ----------------------
# The homelab had three independent layers watching systemd; this file had NONE,
# across 177 services and 18 timers. The gap was invisible for the usual reason:
# what is not declared is not checked, so nothing was ever red about it.
#
# `running` and not `enabled`, for the same reason as the homelab's units spec:
# these are RemainAfterExit oneshots or socket-activated, and asserting `enabled`
# would fail forever on a correct machine.
service:
  rest-server.service:
    # The reason this host exists. It answered on every probe anyway, which is
    # precisely why nobody noticed nothing was asserting it.
    running: true
  wg-quick@wg0.service:
    # The only route in. If this is down, every other assertion here is
    # unreachable and the silence reads as health.
    running: true
  ssh.service:
    running: true
  fail2ban.service:
    running: true

mount:
  # Native resource rather than a command, and the first thing asserted: every
  # other check on this file is meaningless if the volume is not there.
  {{ backup_mount_point }}:
    exists: true
    opts:
      - rw

command:

  # The catch-all the four named units cannot provide: a unit NOBODY listed.
  # `systemctl --failed` is one command and the same one the operator would run.
  offsite-no-failed-units:
    exec: systemctl --failed --no-legend --plain
    exit-status: 0
    stdout: []

  # ufw is a oneshot and sits in `active (exited)` on a correct machine, so a
  # service resource would assert the wrong thing about the component whose job
  # is to keep enforcing after its unit exited. On this host UFW is the ONLY rule
  # that filters — there is no Docker publishing ports around it.
  offsite-ufw-enforcing:
    exec: ufw status
    exit-status: 0
    stdout: ["/^Status: active$/"]

  # The tunnel-recovery path, and settled.md calls it the only one that works
  # after a home address change: roaming cannot repair that direction, so this
  # timer sending first is what reopens the NAT mapping. It was unwatched.
  offsite-wg-reresolve-timer-active:
    exec: systemctl is-active offsite-wg-reresolve.timer
    exit-status: 0
    stdout: ["/^active$/"]

  # --- Parity with the homelab, DERIVED rather than listed (#291, class C02) -
  # The assertions below are generated from `homelab_control_timers`, one per
  # distinct counterpart named there. They are not the gate on their own — a
  # variable is still something a human writes. The gate is on the homelab side
  # (`offsite-parity-register-covers-every-control-timer`), which fails when a
  # deployed control timer is absent from that register, so the register cannot
  # be shorter than reality and these cannot be shorter than the register.
  #
  # #285 closed C02 with seven hand-written assertions. They were correct and
  # they were green; the eighth divergence appeared the same day anyway, which
  # is what a list does and what this pair is meant to stop.
{% for c in homelab_control_timers | selectattr('offsite', 'defined') | map(attribute='offsite') | unique | sort %}
  offsite-carries-{{ c }}:
    exec: systemctl is-active {{ c }}.timer
    exit-status: 0
    stdout: ["/^active$/"]
{% endfor %}

  # The decision of #291 made continuous. Both tools are ones THIS REPO installs
  # or removes, so the list is closed by the roles rather than by memory: lynis
  # is installed only where `lynis_scheduled` is set, and rkhunter was purged
  # everywhere in #155. An audit tool that reappears here without a schedule is
  # the exact shape that made C02 reopen — installed, masked, last report months
  # old, and reading as coverage on any inventory.
  offsite-no-audit-tool-without-a-schedule:
    exec: |
      bad=""
      for p in lynis rkhunter; do
        if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q "ok installed"; then
          bad="$bad $p"
        fi
      done
      [ -z "$bad" ] || { echo "installed with nothing scheduling it:$bad"; exit 1; }
    exit-status: 0

  # --- The clock before the clock (#292, class C42) --------------------------
  # This board has no RTC. Without fake-hwclock, systemd starts it at the mtime
  # of its own binary — 2026-07-28 on both hosts, measured — and every entry
  # written before the first NTP reply carries that date. The journal segment
  # opened in that window is NAMED for it, becomes the oldest file on the host,
  # and journald's vacuum removes it first: the beginning of the current boot,
  # deleted before anything genuinely old.
  #
  # Asserted on freshness rather than on the package being installed, because
  # installed-and-never-run is the shape this repo has already refused twice
  # (#155, #291).
  #
  # 900 s, tracking the save interval — the drop-in in base/tasks/clock.yml puts
  # BOTH hosts on a 5-minute save, so the old 7200 s would have meant 24 missed
  # saves here too and let a dead timer stay green for most of a day. 900 s is
  # three missed saves, the same slack the old number expressed against the old
  # cadence. Changed with its homelab twin deliberately: the interval and the
  # tolerance are one decision in two files, and splitting them is how the
  # second one rots.
  fake-hwclock-data-is-fresh:
    exec: |
      for u in fake-hwclock-load.service fake-hwclock-save.timer; do
        [ "$(systemctl is-enabled "$u" 2>/dev/null)" = "enabled" ] ||
          { echo "$u is not enabled — the clock is not restored at boot"; exit 1; }
      done
      f=/etc/fake-hwclock.data
      [ -f "$f" ] || { echo "$f absent — nothing sets this board's clock before NTP"; exit 1; }
      age=$(( $(date +%s) - $(stat -c %Y "$f") ))
      [ "$age" -le 900 ] || {
        echo "fake-hwclock last saved ${age}s ago — the restored clock is drifting back toward the systemd build date"
        exit 1
      }
    exit-status: 0

  offsite-disk-capacity:
    exec: '[ "$(df --output=pcent {{ backup_mount_point }} | tail -1 | tr -dc 0-9)" -lt 85 ]'
    exit-status: 0

  # The assertion above this one is about the filesystem's CONTENT; this one is
  # about the thing that claimed to verify it. e2scrub_all.timer was enabled and
  # green here every week, and `e2scrub_all -n` returns nothing on this host —
  # it scrubs LVM logical volumes and there is no LVM (#154). Masked by the base
  # role, on both hosts, for the reason #155 taught: a fix applied to the
  # homelab's roles leaves this machine running the no-op for another day.
  #
  # `is-enabled` prints `masked` and exits 1. Both are asserted — `enabled`
  # exits 0, so the exit status alone would pass on the very state this forbids.
  offsite-e2scrub-timer-masked:
    exec: systemctl is-enabled e2scrub_all.timer
    exit-status: 1
    stdout: ["/^masked$/"]

  # A clean filesystem prints NO "FS Error count" line, so its presence is
  # itself the signal; `Filesystem state` reads "clean with errors" rather than
  # "clean" once anything has been recorded. A loop that visited NOTHING must
  # report rather than pass — the guard of #156, kept: `seen` is asserted.
  offsite-ext4-clean:
    exec: |
      findmnt -l -t ext4 -no SOURCE | {
        seen=0
        while read -r src; do
          seen=$((seen + 1))
          hdr=$(dumpe2fs -h "$src" 2>/dev/null) || exit 1
          state=$(printf '%s\n' "$hdr" | awk -F: '/^Filesystem state/ { gsub(/^ +| +$/, "", $2); print $2 }')
          [ "$state" = clean ] || exit 1
          [ -z "$(printf '%s\n' "$hdr" | awk -F: '/^FS Error count/ { gsub(/ /, "", $2); print $2 }')" ] || exit 1
        done
        [ "$seen" -gt 0 ]
      }
    exit-status: 0

  # --- The backup disk had no filesystem check of any kind (#260) -----------
  # It holds the entire offsite restic copy and reached 48 days old with
  # `Maximum mount count: -1`, `Check interval: 0` and `passno 0` — never
  # checked since mkfs, and nothing that would ever check it. #254 armed the
  # homelab's data volume and put the task in the `storage` role, which does not
  # run here.
  #
  # Two halves again, and the fstab one carries the weight: only the boot-time
  # fsck consults the superblock triggers, so `passno 0` made arming them pure
  # decoration. Asserted separately because each can be lost on its own.
  offsite-backup-disk-has-fsck-pass:
    exec: awk '!/^#/ && $2 == "{{ backup_mount_point }}" { print $6 }' /etc/fstab
    exit-status: 0
    stdout: ["/^[1-9]$/"]

  # The superblock half. Not a schedule — the frozen boot clock makes every
  # superblock look future-dated to the initramfs, which then checks in full and
  # rewrites these values backwards. They are asserted so the configuration is
  # right the day the clock is; `passno` above is what does the work today.
  offsite-backup-disk-fsck-triggers-armed:
    exec: tune2fs -l {{ backup_disk_device }}
    exit-status: 0
    stdout:
      - "/Maximum mount count:\\s+-1\\b/"
      - "/Check interval:\\s+{{ data_fsck_interval_days | default(30) | int * 86400 }}\\b/"

  # smartctl's exit status is a bitmask: bit 3 (value 8) means the disk is
  # failing. Bits 0-2 are command/device errors — USB bridge quirks, not a disk
  # failure — so only bit 3 is asserted here.
  offsite-smart-verdict:
    exec: 'smartctl -H {{ backup_disk_device_base }} >/dev/null 2>&1; [ $(( $? & 8 )) -eq 0 ]'
    exit-status: 0

  # Readability asserted on a VALUE, not on the output being non-empty.
  # Measured on this host 2026-08-17: smartctl writes its refusals to stdout, so
  # a device it cannot talk to returns rc=1 with 282 bytes of "Unable to detect
  # device type" — non-empty. The old guard never fired, and a USB-SATA bridge
  # that stops passing SAT commands fails exactly that way, on the host least
  # likely to be looked at directly. Power-on hours is the instrument: present
  # on every ATA drive, and it can only parse as a number if the attribute table
  # was genuinely read.
  offsite-smart-readable:
    exec: |
      h=$(smartctl -A {{ backup_disk_device_base }} 2>/dev/null | awk '$1 == 9 { print $10; exit }')
      case "$h" in ''|*[!0-9]*) exit 1 ;; *) exit 0 ;; esac
    exit-status: 0

  # Early failure predictors, each its own assertion so the name says which one
  # moved: media decay (5/170/187), NAND wearout (171/172), data-path corruption
  # (184), USB cable or bridge trouble (199). Any of them leaving zero reports
  # long before the overall verdict flips — that verdict stays PASSED until the
  # drive is nearly dead.
{% for a in offsite_smart_counters %}
  offsite-smart-{{ a.name }}:
    exec: '[ "$(smartctl -A {{ backup_disk_device_base }} 2>/dev/null | awk ''$1 == {{ a.id }} { print $10; exit }'')" = 0 ]'
    exit-status: 0
{% endfor %}

  # Remaining spare-block reserve, normalized: 100 is full, the vendor floor is 4.
  offsite-smart-spare-blocks:
    exec: '[ "$(smartctl -A {{ backup_disk_device_base }} 2>/dev/null | awk ''$1 == 232 { print $4 + 0; exit }'')" -ge 50 ]'
    exit-status: 0

  # Deliberately the CURRENT value and not the drive's Min/Max. This assertion
  # runs weekly, so it samples a cool moment by construction — but the only
  # maximum this drive exposes is the attribute line's own `(Min/Max 16/61)`,
  # whose window is undocumented and most likely lifetime. A threshold on a
  # figure that can never come back down latches red forever on one past event.
  # The peak is REPORTED by offsite-health.sh instead, for a human to read. The
  # homelab uses a `Power Cycle Min/Max` that resets at every boot, which is why
  # it could take the other route.
  offsite-ssd-temperature:
    exec: '[ "$(smartctl -A {{ backup_disk_device_base }} 2>/dev/null | awk ''$1 == 194 { print $10; exit }'')" -lt 70 ]'
    exit-status: 0

  # An abort is not bad news, it is the ABSENCE of news. This assertion carried
  # the exact defect `homelab-disk.sh` documents as deliberately fixed: `grep -qiE
  # 'fail|aborted'` turns a test interrupted by a reboot into a failure, and on a
  # host sampled once a week that is a red monitor nobody can act on for up to a
  # month — #207's lesson, inverted. Unknown statuses still alarm, which was the
  # half that was right: a status a future smartctl invents must be loud.
  #
  # An EMPTY log now fails instead of passing. It used to `exit 0`, so a drive
  # whose self-test had never run — the state this pair exists to catch — passed
  # both assertions silently.
  offsite-smart-selftest-result:
    exec: |
      line=$(smartctl -l selftest {{ backup_disk_device_base }} 2>/dev/null | awk '/^# 1/ { $1=""; $2=""; print; exit }')
      [ -n "$line" ] || { echo "self-test log is empty: no test has ever been recorded"; exit 1; }
      case "$(printf '%s\n' "$line" | tr '[:upper:]' '[:lower:]')" in
        *"completed without error"*)          exit 0 ;;
        *abort*|*interrupt*|*"in progress"*)  exit 0 ;;
        *)                                    echo "self-test: $line"; exit 1 ;;
      esac
    exit-status: 0

  # A dead-man's check on the monthly self-test timer itself. The log stamps
  # each test in drive power-on hours, so comparing with attribute 9 surfaces a
  # silently dead timer instead of leaving an eternally green "Completed without
  # error" from months ago. 840h is 35 days.
  #
  # Read from the last COMPLETED entry, not from entry `# 1`. Taking the newest
  # entry meant an aborted test — which the assertion above deliberately does not
  # treat as a failure — also RESET the staleness clock, so an abort could hide a
  # dead timer indefinitely. `homelab-disk.sh` keeps the same two readings apart
  # for exactly this reason and calls the difference "the whole of this block";
  # this host had only ever had one of them.
  offsite-smart-selftest-fresh:
    exec: |
      out=$(smartctl -A -l selftest {{ backup_disk_device_base }} 2>/dev/null)
      now=$(printf '%s\n' "$out" | awk '$1 == 9 { print $10; exit }')
      last=$(printf '%s\n' "$out" | awk '/^#[[:space:]]+[0-9]+/ && /Completed/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) { print $(i + 1); exit } }')
      [ -n "$last" ] || { echo "no COMPLETED self-test in the log: the monthly timer has never produced a verdict"; exit 1; }
      [ $((now - last)) -le 840 ]
    exit-status: 0

  # 70, not the homelab's 80, and the difference is deliberate (#201). This board
  # idles at ~49C doing nothing while the homelab averages 40C running 28
  # containers, and its active cooling engages at 60C. So 70 means "the fan has
  # been running for a while and it is still climbing" — a seized or unplugged
  # fan — rather than "the SoC is already throttling", which is what 80 catches.
  # On a host sampled once a week, in someone else's home, with a gpio_fan that
  # has no tachometer, the warning has to come early enough to be worth having.
  offsite-cpu-temperature:
    exec: '[ $(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 )) -lt 70 ]'
    exit-status: 0

  # A sagging power supply silently corrupts disks; the firmware latches
  # undervoltage into the rpi_volt hwmon alarm. `seen` is asserted for the same
  # reason as ext4: a kernel that stops exposing rpi_volt would otherwise turn
  # this into a check that always passes.
  offsite-undervoltage:
    exec: |
      seen=0
      for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = rpi_volt ] || continue
        seen=1
        [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = 1 ] && exit 1
      done
      [ "$seen" -eq 1 ]
    exit-status: 0

  # Reported, not relied on for detection: the push carrying this verdict
  # travels THROUGH the tunnel, so a dead tunnel means nothing arrives and it is
  # the monitor's dead-man window that fires. What this adds is the case that
  # window cannot see — a tunnel alive but whose handshake is ageing. 600s means
  # the re-resolve timer (150s gate, 1-minute period) has had four chances and
  # did not recover it (#180).
  offsite-tunnel-handshake:
    exec: |
      hs=$(wg show wg0 latest-handshakes 2>/dev/null) || exit 1
      seen=$(printf '%s\n' "$hs" | awk 'NR == 1 { print $2 }')
      [ -n "$seen" ] || exit 1
      [ $(( $(date +%s) - seen )) -le 600 ]
    exit-status: 0

  # The one property that makes this host a BACKUP rather than a mirror: with
  # --append-only the rest-server accepts new packs and refuses deletes, so a
  # homelab that is compromised — or simply wrong — cannot erase what is here.
  # It is the whole argument for the offsite copy existing.
  #
  # Nothing asserted it until now. This spec had 26 checks and not one of them
  # about security, while the flag lives in exactly two places a routine change
  # can drop it from: a unit file, and a running process. A rest-server upgrade
  # that rewrites the unit, or an edit made while debugging a failed push, would
  # take it away and every check here would stay green.
  #
  # The LIVE process, not the unit. The unit is what survives a restart, but the
  # process is what enforces, and the two disagree exactly in the window that
  # matters: a unit edited and not yet restarted is still running the old flags,
  # and a process started before an edit keeps them. What is running is the
  # question the operator actually has.
  #
  # An absent process must FAIL rather than pass — the trap this file already
  # names twice, at `offsite-undervoltage` and at the ext4 counters. A
  # rest-server that is not running is not append-only either. Verified under
  # dash on the host before being written here, with both controls: a flag that
  # is genuinely absent fails, and a pgrep that matches nothing fails instead of
  # returning success over an empty loop.
  offsite-restserver-append-only:
    exec: |
      pid=$(pgrep -x rest-server | head -1)
      [ -n "$pid" ] || exit 1
      tr '\0' ' ' < "/proc/$pid/cmdline" | grep -qE -- '(^| )--append-only( |$)'
    exit-status: 0

  # --- A report that reached nobody: this host's half ------------------------
  # `offsite-health.sh` used to end its push in `2>&1 || true`, so a beat that
  # never arrived was indistinguishable from one that did — the run exited 0 and
  # the monitor kept its previous reading. It now writes the same
  # `kuma-push-failed:` marker as its seven homelab siblings, and this is what
  # reads it here. See `no-kuma-report-was-lost-in-silence` in the posture spec.
  #
  # The floor is derived, but from a different fact: there is no Kuma container
  # on this host to ask. Its beat travels to the homelab's Kuma over the tunnel,
  # so the tunnel becoming active is the moment a push can start succeeding.
  # Residual, stated rather than hidden: a push issued in the seconds between
  # the tunnel coming up and traffic actually flowing would be counted as lost.
  # This host's health job runs WEEKLY, so landing in that window would take a
  # coincidence; the homelab's floor is tighter because it can be.
  offsite-no-report-was-lost-in-silence:
    exec: |
      ts=$(systemctl show wg-quick@wg0 -p ActiveEnterTimestamp --value 2>/dev/null)
      [ -n "$ts" ] || { echo "wg-quick@wg0 has no ActiveEnterTimestamp — no floor, refusing to judge"; exit 1; }
      floor=$(date -d "$ts" +%s 2>/dev/null)
      case "$floor" in ''|*[!0-9]*) echo "unparseable tunnel timestamp: [$ts]"; exit 1 ;; esac
      # CAP THE LOOKBACK, for the reason its homelab twin now carries at length:
      # the derived floor is correct but unbounded — it is the tunnel's uptime,
      # and this tunnel is meant to stay up for months. 8 days, because
      # `offsite-health.timer` fires WEEKLY, so 8 covers the widest gap between
      # two runs with a day of margin.
      #
      # `max(floor, now-8d)`, so a tunnel that came up an hour ago still wins
      # and the check keeps refusing to judge a period in which no push to the
      # homelab's Kuma could have landed.
      cap=$(( $(date +%s) - 8 * 86400 ))
      [ "$floor" -lt "$cap" ] && floor="$cap"
      # Anchored --grep, for the reason spelled out in the homelab's twin: --grep
      # tests MESSAGE alone, and the anchor rejects a line that merely mentions
      # the marker. Without it, an operator grepping for the string trips the
      # check — measured on the homelab, 7 phantom losses on a host that had
      # lost nothing.
      hits=$(journalctl --since "@$floor" --no-pager -o cat \
             --grep '^kuma-push-failed:' 2>/dev/null)
      lost=$(printf '%s' "$hits" | grep -c . )
      [ "$lost" -eq 0 ] || {
        echo "$lost report(s) never reached the dashboard since the tunnel came up at $ts:"
        printf '%s\n' "$hits" | tail -5 | sed 's/^/  /'
        exit 1
      }
    # This check declared NO timeout and therefore ran on goss's 10 s default —
    # proven empirically on this host, `sleep 11` returns `timed out (10s)`.
    # It passed only because the tunnel happened to be young: at 63 h of uptime
    # the scan cost 5.88 s, and the window was the tunnel's uptime, so on a
    # tunnel up for a month it would have failed with `not ok` and been read as
    # a lost report.
    #
    # With the 8 day cap above, measured on this host on 2026-08-31: 14.5 s —
    # which is already OVER the default it was silently running on. 60 s is ~4x
    # that, and unlike the homelab twin this spec is 43 checks rather than 382,
    # so it adds little self-load.
    #
    # As on the homelab: never filter this scan with `-p err`. Script stderr is
    # journalled at priority 6, so the filter cannot see the marker and the
    # check would go permanently, silently green.
    timeout: 60000
    exit-status: 0
