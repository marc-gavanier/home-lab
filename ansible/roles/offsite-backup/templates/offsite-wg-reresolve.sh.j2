#!/usr/bin/env bash
# {{ ansible_managed }}

set -euo pipefail

IFACE=wg0
CONF=/etc/wireguard/wg0.conf
STALE_AFTER=150

log() { echo "$*"; }

conf_field() {
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" |
        sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//' | head -1
}

PEER="$(conf_field PublicKey)"
ENDPOINT="$(conf_field Endpoint)"
if [ -z "$PEER" ] || [ -z "$ENDPOINT" ]; then
    log "ERROR: no peer or endpoint in $CONF — nothing to re-resolve"
    exit 1
fi

if ! handshakes="$(wg show "$IFACE" latest-handshakes 2>/dev/null)"; then
    log "$IFACE is not up — nothing to re-resolve"
    exit 0
fi

last="$(awk -v k="$PEER" '$1 == k { print $2; found = 1 } END { exit !found }' <<<"$handshakes")" || {
    log "ERROR: peer from $CONF is not on $IFACE — config and interface disagree"
    exit 1
}

age=$(( $(date +%s) - last ))
[ "$age" -gt "$STALE_AFTER" ] || exit 0

log "handshake ${age}s old (> ${STALE_AFTER}s) — re-resolving $ENDPOINT"
wg set "$IFACE" peer "$PEER" endpoint "$ENDPOINT"
log "endpoint now $(wg show "$IFACE" endpoints | awk -v k="$PEER" '$1 == k { print $2 }')"
