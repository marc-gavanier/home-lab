/var/log/pihole/pihole.log {
    daily
    copytruncate
    rotate 5
    compress
    delaycompress
    notifempty
    nomail
}

/var/log/pihole/FTL.log {
    daily
    create 640 pihole pihole
    rotate 21
    compress
    delaycompress
    notifempty
    nomail
}

/var/log/pihole/webserver.log {
    daily
    create 640 pihole pihole
    rotate 21
    compress
    delaycompress
    notifempty
    nomail
}
