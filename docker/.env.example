# =============================================================================
# Home Lab — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains secrets!
#
# Service passwords are NOT here: since ADR-016 they are mounted as Docker
# secrets from individual files, so `docker inspect` reveals a path instead of
# a value. Ansible renders those files from the vault; a manual deploy has to
# create them by hand, without a trailing newline:
#
#   /mnt/data/secrets/docker/nextcloud_db_password
#   /mnt/data/secrets/docker/nextcloud_db_root_password
#   /mnt/data/secrets/docker/immich_db_password
#   /mnt/data/secrets/docker/transmission_password
#   /mnt/data/secrets/docker/vaultwarden_admin_token_hash  (Argon2 hash)
#
# Nextcloud takes no admin credentials at all — an installed instance keeps
# them in config.php, so a from-scratch deploy uses the web installer.
# =============================================================================

# --- General ---
TZ=Europe/Paris
DOMAIN=example.com
PI_LAN_IP=192.168.1.100

# --- Storage paths ---
SERVICES_DATA_DIR=/mnt/data/services
MEDIA_DIR=/mnt/data/media

# --- Traefik ---
# Scoped Cloudflare API token (Zone:DNS:Edit + Zone:Read) for the ACME DNS-01
# challenge (ADR-014). The ACME contact address is not an env var — it is
# templated into traefik.yml by the deploy role.
CF_DNS_API_TOKEN=  # TODO: create a scoped token in the Cloudflare dashboard

# --- WireGuard ---
WG_HOST=vpn.example.com  # Your public IP or DynDNS hostname
WG_PASSWORD_HASH=  # TODO: generate with: wg-easy password hash

# --- Nextcloud ---
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud

# --- Vaultwarden ---
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- Immich ---
IMMICH_DB_USER=immich
IMMICH_DB_NAME=immich

# --- Transmission ---
# PUID/PGID auto-derived by Ansible from ansible_user; defaults below
# only apply for manual `docker compose up` without Ansible.
PUID=1000
PGID=1000
TRANSMISSION_USER=admin
