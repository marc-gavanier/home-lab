# =============================================================================
# Home Lab — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it contains secrets!
#
# Service passwords are NOT here: since ADR-016 they are mounted as Docker
# secrets from individual files, so `docker inspect` reveals a path instead of
# a value. Ansible renders those files from the vault; a manual deploy has to
# create them by hand, without a trailing newline:
#
#   /mnt/data/secrets/docker/cf_dns_api_token           (Cloudflare DNS-01)
#   /mnt/data/secrets/docker/nextcloud_db_password
#   /mnt/data/secrets/docker/nextcloud_db_root_password
#   /mnt/data/secrets/docker/immich_db_password
#   /mnt/data/secrets/docker/transmission_password
#   /mnt/data/secrets/docker/vaultwarden_admin_token_hash  (Argon2 hash)
#   /mnt/data/secrets/docker/miniflux_db_password
#   /mnt/data/secrets/docker/miniflux_database_url      (a whole DSN, not a
#                                                        password to slot in)
#   /mnt/data/secrets/docker/miniflux_admin_password
#   /mnt/data/secrets/docker/forgejo_admin_password     (first-deploy CLI only)
#   /mnt/data/secrets/docker/forgejo_secret_key         (read on EVERY start;
#     an empty file sends Forgejo back to the constant compiled into the binary,
#     with no error and no warning)
#   /mnt/data/secrets/docker/dozzle_users.yml           (a YAML document)
#   /mnt/data/secrets/docker/searxng_settings           (a YAML document)
#
# This list was five short of what the deploy actually writes, which for a file
# whose only purpose is a from-scratch rebuild is the difference between a
# working deploy and one that starts and misbehaves.
#
# Nextcloud takes no admin credentials at all — an installed instance keeps
# them in config.php, so a from-scratch deploy uses the web installer.
# =============================================================================

# --- General ---
TZ=Europe/Paris
DOMAIN=example.com
PI_LAN_IP=192.168.1.100

# --- Storage paths ---
SERVICES_DATA_DIR=/mnt/data/services
MEDIA_DIR=/mnt/data/media

# Traefik takes nothing from here: the ACME contact address is templated into
# traefik.yml by the deploy role, and the scoped Cloudflare API token
# (Zone:DNS:Edit + Zone:Read) for the DNS-01 challenge is one of the secret
# files listed above.

# --- WireGuard ---
# Nothing. wg-easy 15 keeps its configuration in SQLite rather than in the
# environment (ADR-020), so WG_HOST and WG_PASSWORD_HASH used to sit here doing
# nothing at all: setting them changed no behaviour and produced no warning.
# The values the migration and config scripts need come from their own env file,
# not from this one.

# --- Nextcloud ---
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud

# --- Vaultwarden ---
VAULTWARDEN_SIGNUPS_ALLOWED=false

# --- Immich ---
IMMICH_DB_USER=immich
IMMICH_DB_NAME=immich

# --- Miniflux ---
MINIFLUX_DB_USER=miniflux
MINIFLUX_DB_NAME=miniflux
MINIFLUX_ADMIN_USER=admin

# --- Transmission ---
# PUID/PGID auto-derived by Ansible from ansible_user (env.j2 reads
# getent_passwd, so the deployed file always matches the real account).
# The values below apply ONLY to a manual `docker compose up` without
# Ansible — and they are the ones that bite, because a numeric id is not
# a name: on this host gid 1000 is `gpio`, not the operator's group,
# which is 1003. Rebuilding from this file with PGID=1000 hands the
# containers the GPIO group and the ownership looks right until
# something needs to write.
PUID=1000
PGID=1003
TRANSMISSION_USER=admin
